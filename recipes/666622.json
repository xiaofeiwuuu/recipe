{"id":"666622","name":"黑芝麻花生汤圆","author":"芊芊美食记WQ","authorId":"10676629","desc":"","cover":"images/666622/cover.jpg","ingredients":{"main":[{"name":"糯米粉","amount":"300克"},{"name":"温水","amount":"200克"}],"sub":[{"name":"熟黑芝麻","amount":"100克"},{"name":"熟花生","amount":"30克"},{"name":"猪油","amount":"50克"},{"name":"糖","amount":"40克"}]},"steps":[{"step":1,"desc":"花生打成粉。","img":"images/666622/step_1.jpg"},{"step":2,"desc":"黑芝麻打成粉。","img":"images/666622/step_2.jpg"},{"step":3,"desc":"全部倒入大碗中。","img":"images/666622/step_3.jpg"},{"step":4,"desc":"加入糖和猪油。","img":"images/666622/step_4.jpg"},{"step":5,"desc":"搅拌均匀。","img":"images/666622/step_5.jpg"},{"step":6,"desc":"搓成10克左右的小剂子。","img":"images/666622/step_6.jpg"},{"step":7,"desc":"放入冰箱冷藏半小时再用。","img":"images/666622/step_7.jpg"},{"step":8,"desc":"克糯米粉加入200克水。","img":"images/666622/step_8.png"},{"step":9,"desc":"搅拌均匀。","img":"images/666622/step_9.jpg"},{"step":10,"desc":"下手揉成面团。","img":"images/666622/step_10.jpg"},{"step":11,"desc":"揪几块面团。","img":"images/666622/step_11.jpg"},{"step":12,"desc":"放入热水中。","img":"images/666622/step_12.jpg"},{"step":13,"desc":"煮至浮起。","img":"images/666622/step_13.jpg"},{"step":14,"desc":"再放入原来的面团中。","img":"images/666622/step_14.jpg"},{"step":15,"desc":"再次揉匀。","img":"images/666622/step_15.jpg"},{"step":16,"desc":"多揉一会儿。","img":"images/666622/step_16.jpg"},{"step":17,"desc":"加入20克熟油。","img":"images/666622/step_17.jpg"},{"step":18,"desc":"不断拉扯，面团有拉丝状态就好了。","img":"images/666622/step_18.jpg"},{"step":19,"desc":"取一个15克的面团，放上馅料。","img":"images/666622/step_19.jpg"},{"step":20,"desc":"团圆。","img":"images/666622/step_20.jpg"},{"step":21,"desc":"一个生胚就好了。","img":"images/666622/step_21.jpg"},{"step":22,"desc":"依次全部做完。","img":"images/666622/step_22.jpg"},{"step":23,"desc":"水开后，下入汤圆，煮至浮起。","img":"images/666622/step_23.jpg"},{"step":24,"desc":"好了。","img":"images/666622/step_24.jpg"},{"step":25,"desc":"尝尝这个。","img":"images/666622/step_25.jpg"},{"step":26,"desc":"成品图。","img":"images/666622/step_26.jpg"}],"tips":"来自 美食天下  的作品