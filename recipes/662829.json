{"id":"662829","name":"白果腐竹猪肚汤","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/662829/cover.jpg","ingredients":{"main":[{"name":"猪肚","amount":"适量"}],"sub":[{"name":"白果","amount":"适量"},{"name":"腐竹","amount":"适量"}]},"steps":[{"step":1,"desc":"猪肚洗净，冷水下锅焯烫后洗净。","img":"images/662829/step_1.jpg"},{"step":2,"desc":"腐竹提前浸泡备用。","img":"images/662829/step_2.jpg"},{"step":3,"desc":"白果备用。","img":"images/662829/step_3.jpg"},{"step":4,"desc":"将猪肚放入电高压锅中。","img":"images/662829/step_4.jpg"},{"step":5,"desc":"放入胡椒粒。","img":"images/662829/step_5.jpg"},{"step":6,"desc":"加入适量清水，电高压锅20分钟左右。","img":"images/662829/step_6.jpg"},{"step":7,"desc":"压好的猪肚取出晾凉切块。","img":"images/662829/step_7.jpg"},{"step":8,"desc":"猪肚汤倒入煮锅中。","img":"images/662829/step_8.jpg"},{"step":9,"desc":"放入白果。","img":"images/662829/step_9.jpg"},{"step":10,"desc":"大火煮开。","img":"images/662829/step_10.jpg"},{"step":11,"desc":"放入腐竹一起煮，煮至断生即可。","img":"images/662829/step_11.jpg"},{"step":12,"desc":"放入切好的猪肚煮开，出锅再少许盐调味即可。","img":"images/662829/step_12.jpg"},{"step":13,"desc":"成品。","img":"images/662829/step_13.jpg"},{"step":14,"desc":"成品。","img":"images/662829/step_14.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：电压力锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}