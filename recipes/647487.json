{"id":"647487","name":"土豆柯饭","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/647487/cover.jpg","ingredients":{"main":[{"name":"土豆","amount":"适量"},{"name":"干鱿鱼","amount":"适量"},{"name":"五花肉","amount":"适量"},{"name":"米饭","amount":"适量"}],"sub":[{"name":"蒜苗","amount":"适量"}]},"steps":[{"step":1,"desc":"干鱿鱼剪细后用清水浸泡洗净备用。","img":"images/647487/step_1.jpg"},{"step":2,"desc":"土豆去皮洗净切小块备用。","img":"images/647487/step_2.jpg"},{"step":3,"desc":"蒜苗洗净切细。","img":"images/647487/step_3.jpg"},{"step":4,"desc":"五花肉去皮切薄片。","img":"images/647487/step_4.jpg"},{"step":5,"desc":"米饭提前煮好备用。","img":"images/647487/step_5.jpg"},{"step":6,"desc":"锅中热油放入土豆炸至金黄后捞出。","img":"images/647487/step_6.jpg"},{"step":7,"desc":"锅中少许底油，放入五花肉煸炒出油脂。","img":"images/647487/step_7.jpg"},{"step":8,"desc":"放入鱿鱼丝。","img":"images/647487/step_8.jpg"},{"step":9,"desc":"翻炒均匀炒出香味。","img":"images/647487/step_9.jpg"},{"step":10,"desc":"放入蒜苗。","img":"images/647487/step_10.jpg"},{"step":11,"desc":"翻炒均匀，加入少许盐调味。","img":"images/647487/step_11.jpg"},{"step":12,"desc":"加入米饭。","img":"images/647487/step_12.jpg"},{"step":13,"desc":"将米饭和配料翻炒均匀。","img":"images/647487/step_13.jpg"},{"step":14,"desc":"放入土豆。","img":"images/647487/step_14.jpg"},{"step":15,"desc":"继续炒匀即可。","img":"images/647487/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/647487/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/647487/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/647487/step_18.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}