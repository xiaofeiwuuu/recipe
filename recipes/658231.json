{"id":"658231","name":"土豆烧鸡","author":"蓝雨阳光780913","authorId":"11379263","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/658231/cover.jpg","ingredients":{"main":[{"name":"鸡肉","amount":"500g"},{"name":"土豆","amount":"500g"}],"sub":[{"name":"裙子","amount":"100g"},{"name":"白蘑菇","amount":"200g"}]},"steps":[{"step":1,"desc":"土鸡砍成块洗净。","img":"images/658231/step_1.jpg"},{"step":2,"desc":"油热以后，放入姜片爆香。","img":"images/658231/step_2.jpg"},{"step":3,"desc":"加入鸡肉煸炒。","img":"images/658231/step_3.jpg"},{"step":4,"desc":"煸炒到两面金黄。","img":"images/658231/step_4.jpg"},{"step":5,"desc":"放入豆瓣酱翻炒。","img":"images/658231/step_5.jpg"},{"step":6,"desc":"让豆瓣酱和鸡肉充分融合。","img":"images/658231/step_6.jpg"},{"step":7,"desc":"炒到每一块鸡肉上都上了酱色。","img":"images/658231/step_7.jpg"},{"step":8,"desc":"加入清水淹没鸡肉，放入八角，三奈和蒜瓣大火烧开。","img":"images/658231/step_8.jpg"},{"step":9,"desc":"等待烧开的过程中，土豆去皮切成块。","img":"images/658231/step_9.jpg"},{"step":10,"desc":"锅中放入白蘑菇一起烧开。","img":"images/658231/step_10.jpg"},{"step":11,"desc":"再放入笋子一起小火烧30分钟。","img":"images/658231/step_11.jpg"},{"step":12,"desc":"加入土豆一起烧。","img":"images/658231/step_12.jpg"},{"step":13,"desc":"小米辣切成段。","img":"images/658231/step_13.jpg"},{"step":14,"desc":"放入锅中一起烧10分钟。","img":"images/658231/step_14.jpg"},{"step":15,"desc":"加入盐调味，大火收汁。","img":"images/658231/step_15.jpg"},{"step":16,"desc":"出锅。","img":"images/658231/step_16.jpg"},{"step":17,"desc":"鸡肉鲜香，土豆软糯，美味呀！","img":"images/658231/step_17.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：不粘锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}