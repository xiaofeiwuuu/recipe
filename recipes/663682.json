{"id":"663682","name":"冬瓜焖鸭","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/663682/cover.jpg","ingredients":{"main":[{"name":"鸭肉","amount":"适量"},{"name":"冬瓜","amount":"适量"}],"sub":[{"name":"生姜","amount":"适量"},{"name":"香葱","amount":"适量"}]},"steps":[{"step":1,"desc":"鸭子洗净斩块。","img":"images/663682/step_1.jpg"},{"step":2,"desc":"生姜切片。","img":"images/663682/step_2.jpg"},{"step":3,"desc":"冬瓜去皮洗净切小块。","img":"images/663682/step_3.jpg"},{"step":4,"desc":"锅中热油放入姜片炒香。","img":"images/663682/step_4.jpg"},{"step":5,"desc":"放入鸭肉。","img":"images/663682/step_5.jpg"},{"step":6,"desc":"大火煸炒炒干水份。","img":"images/663682/step_6.jpg"},{"step":7,"desc":"加入适量蚝油，生抽，老抽。","img":"images/663682/step_7.jpg"},{"step":8,"desc":"翻炒均匀上色入味。","img":"images/663682/step_8.jpg"},{"step":9,"desc":"加入适量清水。","img":"images/663682/step_9.jpg"},{"step":10,"desc":"大火煮开转小火焖30分钟左右。","img":"images/663682/step_10.jpg"},{"step":11,"desc":"分钟后放入冬瓜。","img":"images/663682/step_11.jpg"},{"step":12,"desc":"盖上继续焖20分钟左右。","img":"images/663682/step_12.jpg"},{"step":13,"desc":"焖至冬瓜和鸭肉都软烂入味，觉得味道淡了需要加盐调味再酌情加。","img":"images/663682/step_13.jpg"},{"step":14,"desc":"成品。","img":"images/663682/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/663682/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/663682/step_16.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}