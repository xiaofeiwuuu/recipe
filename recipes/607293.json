{"id":"607293","name":"番茄煎蛋焖面","author":"不做妖精好多年","authorId":"1806550","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/607293/cover.jpg","ingredients":{"main":[{"name":"面条","amount":"100g"},{"name":"番茄","amount":"1个"},{"name":"鸡蛋","amount":"1个"}],"sub":[{"name":"食用油","amount":"小许"},{"name":"清水","amount":"适量"}]},"steps":[{"step":1,"desc":"取面条。","img":"images/607293/step_1.jpg"},{"step":2,"desc":"番茄洗净去皮。","img":"images/607293/step_2.jpg"},{"step":3,"desc":"切末。","img":"images/607293/step_3.jpg"},{"step":4,"desc":"热锅冷油。","img":"images/607293/step_4.jpg"},{"step":5,"desc":"油热打入鸡蛋。","img":"images/607293/step_5.jpg"},{"step":6,"desc":"把鸡蛋煎熟。","img":"images/607293/step_6.jpg"},{"step":7,"desc":"分成两块。","img":"images/607293/step_7.jpg"},{"step":8,"desc":"鸡蛋放旁边，放番茄翻炒，放生抽。","img":"images/607293/step_8.jpg"},{"step":9,"desc":"放食盐。","img":"images/607293/step_9.jpg"},{"step":10,"desc":"炒均匀放清水和面条。","img":"images/607293/step_10.jpg"},{"step":11,"desc":"扒拉均匀，焖煮。","img":"images/607293/step_11.jpg"},{"step":12,"desc":"切葱蒜末。","img":"images/607293/step_12.jpg"},{"step":13,"desc":"煮至汤汁浓稠。","img":"images/607293/step_13.jpg"},{"step":14,"desc":"放葱蒜末和鸡精。","img":"images/607293/step_14.jpg"},{"step":15,"desc":"翻拌均匀即可。","img":"images/607293/step_15.jpg"},{"step":16,"desc":"装盘。","img":"images/607293/step_16.jpg"},{"step":17,"desc":"整理一下即可。","img":"images/607293/step_17.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：不粘锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}