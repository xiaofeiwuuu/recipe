{"id":"610291","name":"西红柿虾仁荞麦面","author":"筠旸JY","authorId":"7345450","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/610291/cover.jpg","ingredients":{"main":[{"name":"荞麦面","amount":"适量"},{"name":"西红柿","amount":"一个"},{"name":"虾仁","amount":"适量"},{"name":"木耳","amount":"适量"},{"name":"鸡蛋","amount":"适量"}],"sub":[{"name":"葱花","amount":"适量"},{"name":"水淀粉","amount":"适量"},{"name":"盐","amount":"适量"},{"name":"玉米油","amount":"适量"},{"name":"生抽","amount":"适量"}]},"steps":[{"step":1,"desc":"荞麦面条适量备好。","img":"images/610291/step_1.jpg"},{"step":2,"desc":"西红柿表面划十字刀，放入开水锅里面烫一下，去皮。","img":"images/610291/step_2.jpg"},{"step":3,"desc":"切成小丁备用。","img":"images/610291/step_3.jpg"},{"step":4,"desc":"虾仁挑去虾线。","img":"images/610291/step_4.jpg"},{"step":5,"desc":"黑木耳清水泡发，然后去蒂洗净。","img":"images/610291/step_5.jpg"},{"step":6,"desc":"锅内放油烧热然后放入虾仁煸制。","img":"images/610291/step_6.jpg"},{"step":7,"desc":"两面金黄色。","img":"images/610291/step_7.jpg"},{"step":8,"desc":"放入葱花爆香。","img":"images/610291/step_8.jpg"},{"step":9,"desc":"把西红柿块儿放入，翻炒均匀。","img":"images/610291/step_9.jpg"},{"step":10,"desc":"放入木耳。","img":"images/610291/step_10.jpg"},{"step":11,"desc":"倒入适量清水烧开。","img":"images/610291/step_11.jpg"},{"step":12,"desc":"加少许盐调味。","img":"images/610291/step_12.jpg"},{"step":13,"desc":"淋入水淀粉。","img":"images/610291/step_13.jpg"},{"step":14,"desc":"汤汁浓稠了。","img":"images/610291/step_14.jpg"},{"step":15,"desc":"打入一个蛋液。","img":"images/610291/step_15.jpg"},{"step":16,"desc":"凝固成块儿。","img":"images/610291/step_16.jpg"},{"step":17,"desc":"倒入大碗里备用。","img":"images/610291/step_17.jpg"},{"step":18,"desc":"锅内注水烧开后关火，然后放入荞麦面条，先用筷子滑散，防止粘连。","img":"images/610291/step_18.jpg"},{"step":19,"desc":"焖七八分钟至完全透明状。","img":"images/610291/step_19.jpg"},{"step":20,"desc":"无硬心❤才行。","img":"images/610291/step_20.jpg"},{"step":21,"desc":"盛入碗里。","img":"images/610291/step_21.jpg"},{"step":22,"desc":"舀入西红柿虾仁鸡蛋卤。","img":"images/610291/step_22.jpg"},{"step":23,"desc":"我还准备了一点点菠菜，焯水后切碎，加少许盐和味精调味拌匀。","img":"images/610291/step_23.jpg"},{"step":24,"desc":"放入菠菜。","img":"images/610291/step_24.jpg"},{"step":25,"desc":"好诱人啊。","img":"images/610291/step_25.jpg"},{"step":26,"desc":"成品图！","img":"images/610291/step_26.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：煮锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}