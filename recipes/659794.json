{"id":"659794","name":"黄焖排骨","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/659794/cover.jpg","ingredients":{"main":[{"name":"排骨","amount":"适量"},{"name":"土豆","amount":"适量"}],"sub":[{"name":"香菇","amount":"适量"},{"name":"彩椒","amount":"适量"}]},"steps":[{"step":1,"desc":"香菇冷水泡发后洗净。","img":"images/659794/step_1.jpg"},{"step":2,"desc":"排骨冷水下锅焯烫出血水后洗净。","img":"images/659794/step_2.jpg"},{"step":3,"desc":"锅中热油放入排骨翻炒。","img":"images/659794/step_3.jpg"},{"step":4,"desc":"加入适量蚝油，生抽，老抽。","img":"images/659794/step_4.jpg"},{"step":5,"desc":"翻炒均匀上色入味。","img":"images/659794/step_5.jpg"},{"step":6,"desc":"放入香菇炒香。","img":"images/659794/step_6.jpg"},{"step":7,"desc":"加入适量清水，盖上焖40-60分钟左右。","img":"images/659794/step_7.jpg"},{"step":8,"desc":"土豆去皮洗净切滚刀块。","img":"images/659794/step_8.jpg"},{"step":9,"desc":"彩椒洗净切块。","img":"images/659794/step_9.jpg"},{"step":10,"desc":"排骨焖软烂入味。","img":"images/659794/step_10.jpg"},{"step":11,"desc":"放入土豆。","img":"images/659794/step_11.jpg"},{"step":12,"desc":"继续小火把土豆焖断生，中途加了少许清水。","img":"images/659794/step_12.jpg"},{"step":13,"desc":"土豆焖断生后少许盐调味。","img":"images/659794/step_13.jpg"},{"step":14,"desc":"出锅前放入彩椒。","img":"images/659794/step_14.jpg"},{"step":15,"desc":"煮开后即可出锅。","img":"images/659794/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/659794/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/659794/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/659794/step_18.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}