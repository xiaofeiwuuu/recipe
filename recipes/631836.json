{"id":"631836","name":"海鲜枕头粽","author":"芊芊美食记WQ","authorId":"10676629","desc":"","cover":"images/631836/cover.jpg","ingredients":{"main":[{"name":"糯米","amount":"1000克"},{"name":"五花肉","amount":"400克"},{"name":"咸蛋黄","amount":"12个"},{"name":"虾","amount":"适量"},{"name":"鲍鱼","amount":"12个"}],"sub":[{"name":"粽叶","amount":"适量"},{"name":"红绳","amount":"适量"},{"name":"八角","amount":"适量"},{"name":"香叶","amount":"适量"},{"name":"桂皮","amount":"适量"},{"name":"小茴香","amount":"适量"},{"name":"料酒","amount":"适量"},{"name":"姜","amount":"适量"}]},"steps":[{"step":1,"desc":"准备好鲍鱼、虾(提前剥好虾仁)、咸蛋黄、五花肉。","img":"images/631836/step_1.jpg"},{"step":2,"desc":"鲍鱼处理干净。","img":"images/631836/step_2.jpg"},{"step":3,"desc":"打花刀。","img":"images/631836/step_3.jpg"},{"step":4,"desc":"鲍鱼和虾仁用料酒和姜片腌一下。","img":"images/631836/step_4.jpg"},{"step":5,"desc":"五花肉切成大片。","img":"images/631836/step_5.jpg"},{"step":6,"desc":"加盐、蚝油、糖、生抽、老抽，搅拌均匀。","img":"images/631836/step_6.jpg"},{"step":7,"desc":"桂皮、八角、香叶、小茴香打成粉，加入拌好的肉中。","img":"images/631836/step_7.jpg"},{"step":8,"desc":"加适量的油和米酒，拌匀。","img":"images/631836/step_8.jpg"},{"step":9,"desc":"腌2个小时待用。","img":"images/631836/step_9.jpg"},{"step":10,"desc":"起锅烧水。","img":"images/631836/step_10.jpg"},{"step":11,"desc":"下入鲍鱼和虾仁焯水，快速捞出过凉水，清洗干净浮沫。","img":"images/631836/step_11.jpg"},{"step":12,"desc":"加少许生抽腌一下底味。","img":"images/631836/step_12.jpg"},{"step":13,"desc":"糯米清洗干净，沥干水分。","img":"images/631836/step_13.jpg"},{"step":14,"desc":"加小半勺生抽、一勺老抽、一勺油拌均匀。","img":"images/631836/step_14.jpg"},{"step":15,"desc":"糯米就好了。","img":"images/631836/step_15.jpg"},{"step":16,"desc":"准备好粽叶和红绳。","img":"images/631836/step_16.jpeg"},{"step":17,"desc":"取两片，首尾重叠。","img":"images/631836/step_17.jpg"},{"step":18,"desc":"折出一个漏斗。","img":"images/631836/step_18.jpg"},{"step":19,"desc":"平放入糯米。","img":"images/631836/step_19.jpg"},{"step":20,"desc":"加咸蛋黄、五花肉。","img":"images/631836/step_20.jpg"},{"step":21,"desc":"加鲍鱼、虾。","img":"images/631836/step_21.jpg"},{"step":22,"desc":"再盖上糯米。","img":"images/631836/step_22.jpg"},{"step":23,"desc":"折叠。","img":"images/631836/step_23.jpg"},{"step":24,"desc":"红绳一头放在粽叶上。","img":"images/631836/step_24.jpg"},{"step":25,"desc":"另一头好绳绕扎几圈，绑紧，依次全部做完。","img":"images/631836/step_25.jpg"},{"step":26,"desc":"放入高压锅，加没过粽子的水，大火煮开，转中小火，压3个小时。","img":"images/631836/step_26.jpg"},{"step":27,"desc":"好了。","img":"images/631836/step_27.jpg"},{"step":28,"desc":"成品图，味道超级丰富，好吃看得见😁","img":"images/631836/step_28.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：高压锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}