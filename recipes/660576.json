{"id":"660576","name":"鸡公煲","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/660576/cover.jpg","ingredients":{"main":[{"name":"鸡肉","amount":"适量"}],"sub":[{"name":"芹菜","amount":"适量"},{"name":"彩椒","amount":"适量"},{"name":"蒜头","amount":"适量"},{"name":"生姜","amount":"适量"}]},"steps":[{"step":1,"desc":"鸡肉洗净斩块备用。","img":"images/660576/step_1.jpg"},{"step":2,"desc":"蒜头和姜片备用。","img":"images/660576/step_2.jpg"},{"step":3,"desc":"速冻丸子备用。","img":"images/660576/step_3.jpg"},{"step":4,"desc":"洋葱洗净切块备用。","img":"images/660576/step_4.jpg"},{"step":5,"desc":"芹菜切段备用。","img":"images/660576/step_5.jpg"},{"step":6,"desc":"锅中热油放入鸡肉，中小火将水份炒干。","img":"images/660576/step_6.jpg"},{"step":7,"desc":"放入蒜头和生姜炒出香味。","img":"images/660576/step_7.jpg"},{"step":8,"desc":"加入适量蚝油，生抽，郫县豆瓣酱。","img":"images/660576/step_8.jpg"},{"step":9,"desc":"翻炒均匀入味。","img":"images/660576/step_9.jpg"},{"step":10,"desc":"加入适量清水，大火煮开焖15分钟左右。","img":"images/660576/step_10.jpg"},{"step":11,"desc":"放入丸子类，继续焖10分钟左右。","img":"images/660576/step_11.jpg"},{"step":12,"desc":"彩椒洗净切块备用。","img":"images/660576/step_12.jpg"},{"step":13,"desc":"鸡肉和儿子焖入味放入面饼。","img":"images/660576/step_13.jpg"},{"step":14,"desc":"放入洋葱和彩椒，芹菜段。","img":"images/660576/step_14.jpg"},{"step":15,"desc":"焖至断生即可。","img":"images/660576/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/660576/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/660576/step_17.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}