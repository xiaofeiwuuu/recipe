{"id":"231742","name":"麻辣香菇酱","author":"小堂堂妈妈","authorId":"527331","desc":"","cover":"images/231742/cover.jpg","ingredients":{"main":[{"name":"五花肉末","amount":"100g"},{"name":"香菇","amount":"300g"},{"name":"胡萝卜","amount":"半根"},{"name":"尖椒","amount":"1个"}],"sub":[{"name":"葱","amount":"适量"},{"name":"黑芝麻","amount":"适量"},{"name":"豆瓣酱","amount":"适量"},{"name":"花生","amount":"适量"},{"name":"糖","amount":"适量"},{"name":"生抽","amount":"适量"},{"name":"干红辣椒","amount":"适量"},{"name":"姜","amount":"适量"},{"name":"蒜","amount":"适量"}]},"steps":[{"step":1,"desc":"蘑菇洗净，控干水分","img":"images/231742/step_1.jpg"},{"step":2,"desc":"五花肉切末，葱姜蒜切末","img":"images/231742/step_2.jpg"},{"step":3,"desc":"胡萝卜和青椒也切末","img":"images/231742/step_3.jpg"},{"step":4,"desc":"炒锅放油，放五花肉煸炒","img":"images/231742/step_4.jpg"},{"step":5,"desc":"放葱姜蒜和红辣椒丝","img":"images/231742/step_5.jpg"},{"step":6,"desc":"依次放入胡萝卜和青椒丁，放入切碎的香菇","img":"images/231742/step_6.jpg"},{"step":7,"desc":"继续翻炒，推至一边，另一边多放些油，放入豆瓣酱三勺，炸香","img":"images/231742/step_7.jpg"},{"step":8,"desc":"放生抽","img":"images/231742/step_8.jpg"},{"step":9,"desc":"放白糖，继续翻炒","img":"images/231742/step_9.jpg"},{"step":10,"desc":"加适量水，大火烧开，小火慢炖","img":"images/231742/step_10.jpg"},{"step":11,"desc":"花生用烤箱烤熟","img":"images/231742/step_11.jpg"},{"step":12,"desc":"碾碎，加入黑芝麻","img":"images/231742/step_12.jpg"},{"step":13,"desc":"放入花生和黑芝麻，翻炒均匀即可","img":"images/231742/step_13.jpg"},{"step":14,"desc":"吃不完的放进密封罐保存","img":"images/231742/step_14.jpg"},{"step":15,"desc":"拌面条也很好吃哦","img":"images/231742/step_15.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：不粘锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}