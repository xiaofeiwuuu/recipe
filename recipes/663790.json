{"id":"663790","name":"山粉圆子烧肉","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/663790/cover.jpg","ingredients":{"main":[{"name":"五花肉","amount":"适量"},{"name":"红薯粉","amount":"适量"}],"sub":[{"name":"生姜","amount":"适量"},{"name":"八角","amount":"适量"},{"name":"桂皮","amount":"适量"},{"name":"香叶","amount":"适量"},{"name":"葱花","amount":"适量"}]},"steps":[{"step":1,"desc":"生姜洗净切片。","img":"images/663790/step_1.jpg"},{"step":2,"desc":"五花肉焯过水后改刀切块。","img":"images/663790/step_2.jpg"},{"step":3,"desc":"锅中热油放入姜片。","img":"images/663790/step_3.jpg"},{"step":4,"desc":"放入五花肉翻炒均匀。","img":"images/663790/step_4.jpg"},{"step":5,"desc":"加入适量蚝油，生抽，老抽。","img":"images/663790/step_5.jpg"},{"step":6,"desc":"翻炒均匀上色入味。","img":"images/663790/step_6.jpg"},{"step":7,"desc":"将炒过的五花肉转入珐琅锅中。","img":"images/663790/step_7.jpg"},{"step":8,"desc":"加入适量清水。","img":"images/663790/step_8.jpg"},{"step":9,"desc":"放入八角，桂皮香叶。","img":"images/663790/step_9.jpg"},{"step":10,"desc":"盖上大火煮开转小火焖30分钟左右。","img":"images/663790/step_10.jpg"},{"step":11,"desc":"适量红薯粉倒入碗中。","img":"images/663790/step_11.jpg"},{"step":12,"desc":"加入适量开水。","img":"images/663790/step_12.jpg"},{"step":13,"desc":"把红薯粉揉成面团。","img":"images/663790/step_13.jpg"},{"step":14,"desc":"将面团全部搓成小圆球，放入五花肉里。","img":"images/663790/step_14.jpg"},{"step":15,"desc":"盖上焖15分钟左右，圆子断生即可。","img":"images/663790/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/663790/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/663790/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/663790/step_18.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：煮锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}