{"id":"664822","name":"番茄腐竹牛腩","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/664822/cover.jpg","ingredients":{"main":[{"name":"牛腩","amount":"适量"},{"name":"番茄","amount":"适量"},{"name":"腐竹","amount":"适量"}],"sub":[{"name":"姜片","amount":"适量"},{"name":"葱花","amount":"适量"}]},"steps":[{"step":1,"desc":"腐竹提前泡发后切小段备用。","img":"images/664822/step_1.jpg"},{"step":2,"desc":"牛腩改刀切小块。","img":"images/664822/step_2.jpg"},{"step":3,"desc":"生姜洗净切片。","img":"images/664822/step_3.jpg"},{"step":4,"desc":"将牛腩冷水下锅焯烫出血水后洗净。","img":"images/664822/step_4.jpg"},{"step":5,"desc":"锅中热油放入姜片。","img":"images/664822/step_5.jpg"},{"step":6,"desc":"放入牛腩翻炒炒香。","img":"images/664822/step_6.jpg"},{"step":7,"desc":"适量蚝油，生抽，老抽。","img":"images/664822/step_7.jpg"},{"step":8,"desc":"翻炒均匀上色入味。","img":"images/664822/step_8.jpg"},{"step":9,"desc":"炒过的牛腩转入珐琅锅中，加入适量清水。","img":"images/664822/step_9.jpg"},{"step":10,"desc":"大火煮开转小火煲30分钟。","img":"images/664822/step_10.jpg"},{"step":11,"desc":"番茄去皮切片。","img":"images/664822/step_11.jpg"},{"step":12,"desc":"锅中热油放入番茄，加入适量盐。","img":"images/664822/step_12.jpg"},{"step":13,"desc":"炒出茄汁。","img":"images/664822/step_13.jpg"},{"step":14,"desc":"三十分钟后加入炒好的番茄汁。","img":"images/664822/step_14.jpg"},{"step":15,"desc":"大火煮开十分钟左右。","img":"images/664822/step_15.jpg"},{"step":16,"desc":"放入腐竹。","img":"images/664822/step_16.jpg"},{"step":17,"desc":"继续焖十分钟左右即可出锅。","img":"images/664822/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/664822/step_18.jpg"},{"step":19,"desc":"成品。","img":"images/664822/step_19.jpg"},{"step":20,"desc":"成品。","img":"images/664822/step_20.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：煮锅、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}