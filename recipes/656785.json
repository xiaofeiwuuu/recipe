{"id":"656785","name":"冒烤鸭","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/656785/cover.jpg","ingredients":{"main":[{"name":"烤鸭","amount":"适量"},{"name":"火锅丸子","amount":"适量"},{"name":"金针菇","amount":"适量"},{"name":"面饼","amount":"适量"},{"name":"豆腐串","amount":"适量"}],"sub":[{"name":"蒜末","amount":"适量"},{"name":"干辣椒","amount":"适量"},{"name":"香菜","amount":"适量"}]},"steps":[{"step":1,"desc":"金针菇，火锅丸子，烤鸭，豆腐串有先备好。","img":"images/656785/step_1.jpg"},{"step":2,"desc":"再准备一块面饼。","img":"images/656785/step_2.jpg"},{"step":3,"desc":"锅中热油放入火锅底料炒融化。","img":"images/656785/step_3.jpg"},{"step":4,"desc":"加入适量清水和盐。","img":"images/656785/step_4.jpg"},{"step":5,"desc":"煮开后放入火锅丸子。","img":"images/656785/step_5.jpg"},{"step":6,"desc":"丸子煮好后放入金针菇。","img":"images/656785/step_6.jpg"},{"step":7,"desc":"金针菇煮开后和丸子一起先捞出。","img":"images/656785/step_7.jpg"},{"step":8,"desc":"放入豆腐串。","img":"images/656785/step_8.jpg"},{"step":9,"desc":"面饼也一起下锅煮。","img":"images/656785/step_9.jpg"},{"step":10,"desc":"吸满汤汁的豆腐串先夹出。","img":"images/656785/step_10.jpg"},{"step":11,"desc":"最后烤鸭下锅。","img":"images/656785/step_11.jpg"},{"step":12,"desc":"大火煮开后即可。","img":"images/656785/step_12.jpg"},{"step":13,"desc":"全部煮好后装碗摆盘。","img":"images/656785/step_13.jpg"},{"step":14,"desc":"放上适量蒜末和干辣椒。","img":"images/656785/step_14.jpg"},{"step":15,"desc":"淋上热油和放上香菜即可。","img":"images/656785/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/656785/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/656785/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/656785/step_18.jpg"},{"step":19,"desc":"成品。","img":"images/656785/step_19.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}