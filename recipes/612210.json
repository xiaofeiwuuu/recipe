{"id":"612210","name":"广式腊肠炒饭","author":"宁静致远0217","authorId":"9691953","desc":"","cover":"images/612210/cover.jpg","ingredients":{"main":[{"name":"剩米饭","amount":"1碗"},{"name":"广式腊肠","amount":"2根"},{"name":"鸡蛋","amount":"2个"},{"name":"油菜","amount":"半棵"}],"sub":[{"name":"洋葱","amount":"适量"},{"name":"香菇","amount":"3朵"},{"name":"葱","amount":"少许"},{"name":"姜","amount":"适量"}]},"steps":[{"step":1,"desc":"剩米饭鸡蛋广式腊肠洋葱准备，香菇泡发。","img":"images/612210/step_1.jpg"},{"step":2,"desc":"葱姜切丝。","img":"images/612210/step_2.jpg"},{"step":3,"desc":"油菜洗净。","img":"images/612210/step_3.jpg"},{"step":4,"desc":"鸡蛋打散广式腊肠，香菇，洋葱，油菜切碎。","img":"images/612210/step_4.jpg"},{"step":5,"desc":"锅中放油摊鸡蛋。","img":"images/612210/step_5.jpg"},{"step":6,"desc":"鸡蛋炒碎盛出。","img":"images/612210/step_6.jpg"},{"step":7,"desc":"锅中放油，炒洋葱碎，再放入广式腊肠炒出油。","img":"images/612210/step_7.jpg"},{"step":8,"desc":"放入姜葱丝稍炒。","img":"images/612210/step_8.jpg"},{"step":9,"desc":"放入剩米饭煸炒出水汽。","img":"images/612210/step_9.jpg"},{"step":10,"desc":"放入切碎的油菜丁儿炒至断生。","img":"images/612210/step_10.jpg"},{"step":11,"desc":"放入炒好的鸡蛋撒盐炒匀，出锅前撒味精炒匀。","img":"images/612210/step_11.jpg"},{"step":12,"desc":"盛出。","img":"images/612210/step_12.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}