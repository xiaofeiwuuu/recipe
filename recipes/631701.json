{"id":"631701","name":"胡萝卜金针菇拌鲍鱼","author":"不做妖精好多年","authorId":"1806550","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/631701/cover.jpg","ingredients":{"main":[{"name":"鲍鱼","amount":"2个"},{"name":"金针菇","amount":"120g"},{"name":"胡萝卜","amount":"100g"}],"sub":[{"name":"红椒和葱叶","amount":"小许（香菜也可）"}]},"steps":[{"step":1,"desc":"鲍鱼化冻，拿出来3个，觉得多了点，最后用了2个。","img":"images/631701/step_1.jpg"},{"step":2,"desc":"金针菇洗净冷水下锅。","img":"images/631701/step_2.jpg"},{"step":3,"desc":"煮开锅3～5分钟。","img":"images/631701/step_3.jpg"},{"step":4,"desc":"捞出沥干水分。","img":"images/631701/step_4.jpg"},{"step":5,"desc":"胡萝卜洗净打丝。","img":"images/631701/step_5.jpg"},{"step":6,"desc":"下锅焯水。","img":"images/631701/step_6.jpg"},{"step":7,"desc":"煮开3～5分钟。","img":"images/631701/step_7.jpg"},{"step":8,"desc":"鲍鱼切片。","img":"images/631701/step_8.jpg"},{"step":9,"desc":"把鲍鱼烫一下即可。","img":"images/631701/step_9.jpg"},{"step":10,"desc":"捞出胡萝卜沥干水分。","img":"images/631701/step_10.jpg"},{"step":11,"desc":"装盘。","img":"images/631701/step_11.jpg"},{"step":12,"desc":"撒食盐。","img":"images/631701/step_12.jpg"},{"step":13,"desc":"大蒜去皮洗净切末，红椒和葱叶切圈，有刚才就不用葱叶。","img":"images/631701/step_13.jpg"},{"step":14,"desc":"放蒜末等。","img":"images/631701/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/631701/step_15.jpg"},{"step":16,"desc":"吃的时候拌匀。","img":"images/631701/step_16.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：煮锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}