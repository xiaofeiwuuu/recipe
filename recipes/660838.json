{"id":"660838","name":"藕丁蒸肉饼","author":"开心肥羊","authorId":"389860","desc":"","cover":"images/660838/cover.jpg","ingredients":{"main":[{"name":"莲藕","amount":"350g"},{"name":"猪前腿肉","amount":"300g"},{"name":"干香菇","amount":"10朵"},{"name":"香葱","amount":"100g"},{"name":"鸡蛋","amount":"1个"}],"sub":[{"name":"盐","amount":"1匙"},{"name":"生抽","amount":"1匙"},{"name":"蚝油","amount":"1勺"},{"name":"胡椒粉","amount":"少许"},{"name":"鸡粉","amount":"少许"},{"name":"香油","amount":"1勺"}]},"steps":[{"step":1,"desc":"前腿肉(8分瘦2分肥）剁碎备用。","img":"images/660838/step_1.jpg"},{"step":2,"desc":"干香菇泡发，用搅拌机打碎。","img":"images/660838/step_2.jpg"},{"step":3,"desc":"莲藕去皮洗净，用搅拌机打碎。","img":"images/660838/step_3.jpg"},{"step":4,"desc":"香葱洗净切成葱花备用。","img":"images/660838/step_4.jpg"},{"step":5,"desc":"把所有材料放入大碗里，打入一个鸡蛋。","img":"images/660838/step_5.jpg"},{"step":6,"desc":"撒入盐以及鸡粉。","img":"images/660838/step_6.jpg"},{"step":7,"desc":"淋入生抽。","img":"images/660838/step_7.jpg"},{"step":8,"desc":"挤上蚝油。","img":"images/660838/step_8.jpg"},{"step":9,"desc":"撒上胡椒粉。","img":"images/660838/step_9.jpg"},{"step":10,"desc":"最后再淋入香油。","img":"images/660838/step_10.jpg"},{"step":11,"desc":"把全部材料充分搅拌均匀。","img":"images/660838/step_11.jpg"},{"step":12,"desc":"放到盘子里，铺平。","img":"images/660838/step_12.jpg"},{"step":13,"desc":"隔水蒸，水开后转中火蒸25分钟即可。","img":"images/660838/step_13.jpg"},{"step":14,"desc":"味道好极了，可以多吃一碗饭呢😃","img":"images/660838/step_14.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：蒸锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}