{"id":"631652","name":"凉拌海带丝","author":"沐祠姐姐","authorId":"12934813","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/631652/cover.jpg","ingredients":{"main":[{"name":"海带","amount":"两根"}],"sub":[{"name":"芝麻","amount":"适量"},{"name":"大蒜子","amount":"适量"},{"name":"生姜","amount":"适量"},{"name":"白糖","amount":"适量"}]},"steps":[{"step":1,"desc":"干海带用水泡一个小时。","img":"images/631652/step_1.jpg"},{"step":2,"desc":"洗干净备用。","img":"images/631652/step_2.jpg"},{"step":3,"desc":"铺平卷起来。","img":"images/631652/step_3.jpg"},{"step":4,"desc":"切成丝。","img":"images/631652/step_4.jpg"},{"step":5,"desc":"放入盆中。","img":"images/631652/step_5.jpg"},{"step":6,"desc":"锅中烧开水把海带丝倒入开水烫两分钟。","img":"images/631652/step_6.jpg"},{"step":7,"desc":"时不时用筷子搅拌一下捞起来沥干水。","img":"images/631652/step_7.jpg"},{"step":8,"desc":"用冷开水冲洗一下沥干水。","img":"images/631652/step_8.jpg"},{"step":9,"desc":"放入大碗中加芝麻。","img":"images/631652/step_9.jpg"},{"step":10,"desc":"锅中放多点油，花椒炸出香味捞出。","img":"images/631652/step_10.jpg"},{"step":11,"desc":"生姜大蒜子小米椒打成末。","img":"images/631652/step_11.jpg"},{"step":12,"desc":"下大蒜子白糖和食盐。","img":"images/631652/step_12.jpg"},{"step":13,"desc":"生抽酱油耗油鸡精调味。","img":"images/631652/step_13.jpg"},{"step":14,"desc":"倒入海带丝碗中。","img":"images/631652/step_14.jpg"},{"step":15,"desc":"加点陈醋，再用筷子搅拌均匀。","img":"images/631652/step_15.jpg"},{"step":16,"desc":"小菜一碟出炉。","img":"images/631652/step_16.jpg"},{"step":17,"desc":"放入冷藏口感更佳。","img":"images/631652/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/631652/step_18.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：煮锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}