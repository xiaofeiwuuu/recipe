{"id":"657743","name":"香菇焖鸡","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/657743/cover.jpg","ingredients":{"main":[{"name":"鸡翅","amount":"4个"},{"name":"香菇","amount":"适量"}],"sub":[{"name":"蒜苗","amount":"适量"},{"name":"生姜","amount":"适量"}]},"steps":[{"step":1,"desc":"香菇提前适量清水泡发一下。","img":"images/657743/step_1.jpg"},{"step":2,"desc":"全鸡翅洗净备用。","img":"images/657743/step_2.jpg"},{"step":3,"desc":"将全翅改刀斩块。","img":"images/657743/step_3.jpg"},{"step":4,"desc":"斩好的全翅放入盘中，加入姜片。","img":"images/657743/step_4.jpg"},{"step":5,"desc":"加入适量蚝油，老抽，玉米淀粉，生抽。","img":"images/657743/step_5.jpg"},{"step":6,"desc":"抓拌均匀腌制20分钟左右。","img":"images/657743/step_6.jpg"},{"step":7,"desc":"锅中热油放入鸡肉。","img":"images/657743/step_7.jpg"},{"step":8,"desc":"将鸡肉中小火煎炒。","img":"images/657743/step_8.jpg"},{"step":9,"desc":"放入香菇翻炒。","img":"images/657743/step_9.jpg"},{"step":10,"desc":"加入泡香菇的水。","img":"images/657743/step_10.jpg"},{"step":11,"desc":"加入少量盐，大火煮开后中小火焖。","img":"images/657743/step_11.jpg"},{"step":12,"desc":"将鸡肉焖入味收汁。","img":"images/657743/step_12.jpg"},{"step":13,"desc":"放入蒜苗。","img":"images/657743/step_13.jpg"},{"step":14,"desc":"翻炒至蒜苗断生即可。","img":"images/657743/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/657743/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/657743/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/657743/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/657743/step_18.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}