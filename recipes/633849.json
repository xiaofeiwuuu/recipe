{"id":"633849","name":"包菜木耳煎饺","author":"笑笑昵","authorId":"10878013","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/633849/cover.jpg","ingredients":{"main":[{"name":"包菜","amount":"适量"},{"name":"黑木耳","amount":"适量"},{"name":"饺子皮","amount":"适量"},{"name":"大葱","amount":"适量"}],"sub":[{"name":"花椒","amount":"适量"},{"name":"姜片","amount":"适量"},{"name":"八角","amount":"适量"},{"name":"鸡蛋","amount":"适量"}]},"steps":[{"step":1,"desc":"食材:包菜切碎、泡发好的黑木耳、肉馅、大葱碎、花椒八角葱姜水。","img":"images/633849/step_1.jpg"},{"step":2,"desc":"黑木耳切碎。","img":"images/633849/step_2.jpg"},{"step":3,"desc":"肉馅中放入盐、胡椒粉、生抽、老抽、蚝油、鸡蛋搅拌均匀后分次加入大料水搅拌上劲。","img":"images/633849/step_3.jpg"},{"step":4,"desc":"放入包菜碎、黑木耳、大葱搅拌均匀。","img":"images/633849/step_4.jpg"},{"step":5,"desc":"放入食用油拌匀。","img":"images/633849/step_5.jpg"},{"step":6,"desc":"取一张饺子皮，放入馅料包成饺子。","img":"images/633849/step_6.jpg"},{"step":7,"desc":"平底锅中放油，放入饺子中小火煎至底部金黄。","img":"images/633849/step_7.jpg"},{"step":8,"desc":"加入没过饺子一半的水盖盖煮。","img":"images/633849/step_8.jpg"},{"step":9,"desc":"最后收干水即可。","img":"images/633849/step_9.jpg"},{"step":10,"desc":"成品图。","img":"images/633849/step_10.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：平底锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}