{"id":"596407","name":"排骨腊肠饭","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/596407/cover.jpg","ingredients":{"main":[{"name":"肋排","amount":"2条"},{"name":"腊肠","amount":"4个"},{"name":"大米","amount":"适量"}],"sub":[{"name":"葱花","amount":"适量"}]},"steps":[{"step":1,"desc":"排骨斩块洗净备用。","img":"images/596407/step_1.jpg"},{"step":2,"desc":"排骨放入碗中，加入生抽，盐，蚝油，玉米淀粉，花生油，姜片抓匀腌制入味。","img":"images/596407/step_2.jpg"},{"step":3,"desc":"腊肠切片备用。","img":"images/596407/step_3.jpg"},{"step":4,"desc":"大米洗净。","img":"images/596407/step_4.jpg"},{"step":5,"desc":"加入适量的水，水建议比平时煮饭少一些。","img":"images/596407/step_5.jpg"},{"step":6,"desc":"电饭煲开始煮饭。","img":"images/596407/step_6.jpg"},{"step":7,"desc":"米饭煲至水份干了，铺上腌制入味的肋排，淋上腌制排骨的汁。","img":"images/596407/step_7.jpg"},{"step":8,"desc":"摆入腊肠。","img":"images/596407/step_8.jpg"},{"step":9,"desc":"继续煲饭程序。","img":"images/596407/step_9.jpg"},{"step":10,"desc":"一直至煲饭程序结束。","img":"images/596407/step_10.jpg"},{"step":11,"desc":"淋上味极鲜生抽。","img":"images/596407/step_11.jpg"},{"step":12,"desc":"将米饭翻拌均匀入味。","img":"images/596407/step_12.jpg"},{"step":13,"desc":"继续再按一个热饭饭程序。","img":"images/596407/step_13.jpg"},{"step":14,"desc":"结束后翻拌均匀，同样有锅巴。","img":"images/596407/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/596407/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/596407/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/596407/step_17.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：电饭煲\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}