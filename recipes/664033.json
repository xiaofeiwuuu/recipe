{"id":"664033","name":"黄豆焖牛腩","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/664033/cover.jpg","ingredients":{"main":[{"name":"牛腩","amount":"适量"},{"name":"黄豆","amount":"适量"}],"sub":[{"name":"八角","amount":"适量"},{"name":"桂皮","amount":"适量"},{"name":"香叶","amount":"适量"},{"name":"生姜","amount":"适量"},{"name":"葱花","amount":"适量"}]},"steps":[{"step":1,"desc":"黄豆提前泡发备用。","img":"images/664033/step_1.jpg"},{"step":2,"desc":"姜片，八角，桂皮，香叶备用。","img":"images/664033/step_2.jpg"},{"step":3,"desc":"牛腩改刀切小块。","img":"images/664033/step_3.jpg"},{"step":4,"desc":"将牛腩冷水下锅焯烫后洗净。","img":"images/664033/step_4.jpg"},{"step":5,"desc":"锅中热油放入香料炒香。","img":"images/664033/step_5.jpg"},{"step":6,"desc":"放入牛腩翻炒均匀。","img":"images/664033/step_6.jpg"},{"step":7,"desc":"适量蚝油，生抽，老抽。","img":"images/664033/step_7.jpg"},{"step":8,"desc":"翻炒均匀上色入味。","img":"images/664033/step_8.jpg"},{"step":9,"desc":"将炒过的牛腩转入高压锅中。","img":"images/664033/step_9.jpg"},{"step":10,"desc":"加入适量清水。","img":"images/664033/step_10.jpg"},{"step":11,"desc":"高压锅大火压10分钟左右。","img":"images/664033/step_11.jpg"},{"step":12,"desc":"开盖后放入黄豆。","img":"images/664033/step_12.jpg"},{"step":13,"desc":"继续高压锅大火压10分钟左右收汁即可。","img":"images/664033/step_13.jpg"},{"step":14,"desc":"成品。","img":"images/664033/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/664033/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/664033/step_16.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：高压锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}