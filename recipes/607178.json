{"id":"607178","name":"家常臊子面","author":"优子家的味道","authorId":"9910251","desc":"","cover":"images/607178/cover.jpg","ingredients":{"main":[{"name":"五花肉","amount":"适量"},{"name":"鸡蛋","amount":"3个"},{"name":"木耳","amount":"适量"},{"name":"黄花菜","amount":"适量"},{"name":"豆腐","amount":"适量"},{"name":"韭菜","amount":"适量"},{"name":"土豆","amount":"1个"},{"name":"胡萝卜","amount":"半个"},{"name":"豆角","amount":"适量"},{"name":"面条","amount":"适量"}],"sub":[{"name":"葱","amount":"适量"},{"name":"姜","amount":"适量"},{"name":"蒜","amount":"适量"}]},"steps":[{"step":1,"desc":"备齐菜码，五花肉肥瘦分开。","img":"images/607178/step_1.jpg"},{"step":2,"desc":"油热后先下入肥瘦。","img":"images/607178/step_2.jpg"},{"step":3,"desc":"炒出油脂后放入瘦肉。","img":"images/607178/step_3.jpg"},{"step":4,"desc":"放入老抽、料酒。","img":"images/607178/step_4.jpg"},{"step":5,"desc":"炒香后放入辣椒面。","img":"images/607178/step_5.jpg"},{"step":6,"desc":"老陈醋。","img":"images/607178/step_6.jpg"},{"step":7,"desc":"大火炖十分钟。","img":"images/607178/step_7.jpg"},{"step":8,"desc":"捞出备用。","img":"images/607178/step_8.jpg"},{"step":9,"desc":"重新起油，油热后下入葱姜蒜炒香。","img":"images/607178/step_9.jpg"},{"step":10,"desc":"放入辣椒面。","img":"images/607178/step_10.jpg"},{"step":11,"desc":"炒匀后倒入老陈醋。","img":"images/607178/step_11.jpg"},{"step":12,"desc":"熬出醋香后倒入清水。","img":"images/607178/step_12.jpg"},{"step":13,"desc":"水开后先倒入肉臊子炖五分钟。","img":"images/607178/step_13.jpg"},{"step":14,"desc":"随后依次放入菜码。","img":"images/607178/step_14.jpg"},{"step":15,"desc":"放入盐、十三香。","img":"images/607178/step_15.jpg"},{"step":16,"desc":"酱油。","img":"images/607178/step_16.jpg"},{"step":17,"desc":"大火炖把菜码炖熟。","img":"images/607178/step_17.jpg"},{"step":18,"desc":"最后撒上味精，搅匀关火。","img":"images/607178/step_18.jpg"},{"step":19,"desc":"撒上韭菜、鸡蛋皮。","img":"images/607178/step_19.jpg"},{"step":20,"desc":"搅匀即可。","img":"images/607178/step_20.jpg"},{"step":21,"desc":"面条煮好后先过凉水。","img":"images/607178/step_21.jpg"},{"step":22,"desc":"浇上臊子。","img":"images/607178/step_22.jpg"},{"step":23,"desc":"荤素搭配，营养丰富，香辣可口，美味漂亮！。","img":"images/607178/step_23.jpg"}]