{"id":"660303","name":"鸡腿肉滑蛋","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/660303/cover.jpg","ingredients":{"main":[{"name":"鸡腿","amount":"适量"},{"name":"鸡蛋","amount":"适量"}],"sub":[{"name":"洋葱","amount":"适量"},{"name":"葱花","amount":"适量"}]},"steps":[{"step":1,"desc":"鸡腿去骨洗净。","img":"images/660303/step_1.jpg"},{"step":2,"desc":"将鸡腿肉切小块。","img":"images/660303/step_2.jpg"},{"step":3,"desc":"加入适量蚝油，生抽，老抽，玉米淀粉，搅拌均匀腌制半小时左右。","img":"images/660303/step_3.jpg"},{"step":4,"desc":"洋葱洗净切细。","img":"images/660303/step_4.jpg"},{"step":5,"desc":"鸡骨打入碗中，加入小火淀粉水搅拌均匀。","img":"images/660303/step_5.jpg"},{"step":6,"desc":"锅中热油放入鸡腿肉。","img":"images/660303/step_6.jpg"},{"step":7,"desc":"中小火煎至微焦。","img":"images/660303/step_7.jpg"},{"step":8,"desc":"放入洋葱翻炒出香味。","img":"images/660303/step_8.jpg"},{"step":9,"desc":"加入适量蚝油，盐调味。","img":"images/660303/step_9.jpg"},{"step":10,"desc":"往锅里倒入鸡蛋液，小火煎至定型即可。","img":"images/660303/step_10.jpg"},{"step":11,"desc":"成品。","img":"images/660303/step_11.jpg"},{"step":12,"desc":"成品。","img":"images/660303/step_12.jpg"},{"step":13,"desc":"成品。","img":"images/660303/step_13.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}