{"id":"600418","name":"黄豆芽豆角焖面","author":"雨中漫步li","authorId":"10274398","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/600418/cover.jpg","ingredients":{"main":[{"name":"面条","amount":"60克"},{"name":"黄豆芽","amount":"适量"},{"name":"豆角","amount":"适量"}],"sub":[{"name":"肉丝","amount":"适量"},{"name":"西红柿","amount":"一个"}]},"steps":[{"step":1,"desc":"西红柿、黄豆芽、豆角洗净切好备用。","img":"images/600418/step_1.jpg"},{"step":2,"desc":"肉丝、洋葱、姜切好。","img":"images/600418/step_2.jpg"},{"step":3,"desc":"面条。","img":"images/600418/step_3.jpg"},{"step":4,"desc":"蒜末切好。","img":"images/600418/step_4.jpg"},{"step":5,"desc":"锅内放花生油，放入洋葱、肉丝、姜炒出香味。","img":"images/600418/step_5.jpg"},{"step":6,"desc":"放入蚝油、生抽翻炒入味。","img":"images/600418/step_6.jpg"},{"step":7,"desc":"倒入青菜。","img":"images/600418/step_7.jpg"},{"step":8,"desc":"翻炒一会。","img":"images/600418/step_8.jpg"},{"step":9,"desc":"放盐，两勺清水，炖一会。","img":"images/600418/step_9.jpg"},{"step":10,"desc":"锅内加水烧开，放入面条煮2分钟。","img":"images/600418/step_10.jpg"},{"step":11,"desc":"把面条放入青菜锅内，盖上锅盖小火烧5分钟，面条熟透，撒上蒜末。","img":"images/600418/step_11.jpg"},{"step":12,"desc":"翻办均匀即可。","img":"images/600418/step_12.jpg"},{"step":13,"desc":"装盘。","img":"images/600418/step_13.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：汤锅、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}