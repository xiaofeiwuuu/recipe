{"id":"633499","name":"凉拌腐竹","author":"甜甜mimi","authorId":"7708277","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/633499/cover.jpg","ingredients":{"main":[{"name":"腐竹","amount":"适量"}],"sub":[{"name":"黑木耳","amount":"适量"},{"name":"黄瓜","amount":"适量"}]},"steps":[{"step":1,"desc":"腐竹木耳泡发。","img":"images/633499/step_1.jpg"},{"step":2,"desc":"黄瓜清洗备用。","img":"images/633499/step_2.jpg"},{"step":3,"desc":"黄瓜切块加入白糖腌制几分钟。","img":"images/633499/step_3.jpg"},{"step":4,"desc":"腐竹清洗切段。","img":"images/633499/step_4.jpg"},{"step":5,"desc":"锅中烧开水倒入腐竹木耳煮沸。","img":"images/633499/step_5.jpg"},{"step":6,"desc":"煮沸捞出。","img":"images/633499/step_6.jpg"},{"step":7,"desc":"蒜末生姜小米辣盐淋入热油。","img":"images/633499/step_7.jpg"},{"step":8,"desc":"加入蚝油生抽香醋。","img":"images/633499/step_8.jpg"},{"step":9,"desc":"腐竹黄瓜木耳装入大碗中加入调好的料汁。","img":"images/633499/step_9.jpg"},{"step":10,"desc":"再加入自制辣椒油少许芝麻油拌均即可。","img":"images/633499/step_10.jpg"},{"step":11,"desc":"装盘。","img":"images/633499/step_11.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：其他、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}