{"id":"629571","name":"白菜肉末香菇生煎包","author":"どら","authorId":"10454906","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/629571/cover.jpg","ingredients":{"main":[{"name":"香菇","amount":"适量"},{"name":"肉末","amount":"适量"},{"name":"白菜","amount":"适量"},{"name":"低粉","amount":"500克"},{"name":"温水","amount":"250克"},{"name":"酵母粉","amount":"3克"}],"sub":[{"name":"盐","amount":"少许"},{"name":"生抽","amount":"3克"},{"name":"胡椒粉","amount":"3克"},{"name":"玉米油","amount":"5克"}]},"steps":[{"step":1,"desc":"温水加入酵母粉搅拌均匀，加入低粉揉成光滑面团，发酵两倍大。","img":"images/629571/step_1.jpg"},{"step":2,"desc":"肉末加入香菇碎，香菇提前浸泡洗干净切碎。","img":"images/629571/step_2.jpg"},{"step":3,"desc":"添加少许盐，生抽，胡椒粉搅拌均匀。","img":"images/629571/step_3.jpg"},{"step":4,"desc":"白菜榨干水分备用。","img":"images/629571/step_4.jpg"},{"step":5,"desc":"放入与肉末香菇一起搅拌。","img":"images/629571/step_5.jpg"},{"step":6,"desc":"搅拌好的馅料。","img":"images/629571/step_6.jpg"},{"step":7,"desc":"发酵好的面团。","img":"images/629571/step_7.jpg"},{"step":8,"desc":"分别分成小剂子。","img":"images/629571/step_8.jpg"},{"step":9,"desc":"擀成包子皮。","img":"images/629571/step_9.jpg"},{"step":10,"desc":"依次包入馅料。","img":"images/629571/step_10.jpg"},{"step":11,"desc":"盖上湿布静置25分钟。","img":"images/629571/step_11.jpg"},{"step":12,"desc":"锅底刷油放入包子。","img":"images/629571/step_12.jpg"},{"step":13,"desc":"煎至底部偏黄。","img":"images/629571/step_13.jpg"},{"step":14,"desc":"添加水份。","img":"images/629571/step_14.jpg"},{"step":15,"desc":"小火慢慢煎。","img":"images/629571/step_15.jpg"},{"step":16,"desc":"大约25分钟。","img":"images/629571/step_16.jpg"},{"step":17,"desc":"撒一些葱花。","img":"images/629571/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/629571/step_18.jpg"},{"step":19,"desc":"成品。","img":"images/629571/step_19.jpg"},{"step":20,"desc":"成品。","img":"images/629571/step_20.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：不粘锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}