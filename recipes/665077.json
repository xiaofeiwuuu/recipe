{"id":"665077","name":"虾滑蟹柳响铃卷","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/665077/cover.jpg","ingredients":{"main":[{"name":"虾滑","amount":"适量"},{"name":"蟹柳","amount":"适量"},{"name":"响铃卷","amount":"适量"}],"sub":[{"name":"蒜头","amount":"适量"},{"name":"香菇","amount":"适量"},{"name":"萝卜干","amount":"适量"}]},"steps":[{"step":1,"desc":"香菇提前泡发切细备用。","img":"images/665077/step_1.jpg"},{"step":2,"desc":"萝卜干洗净切细。","img":"images/665077/step_2.jpg"},{"step":3,"desc":"蒜头拍扁剁碎备用。","img":"images/665077/step_3.jpg"},{"step":4,"desc":"锅中热油放入萝卜干炒香。","img":"images/665077/step_4.jpg"},{"step":5,"desc":"放入蒜末，炒至微微金黄。","img":"images/665077/step_5.jpg"},{"step":6,"desc":"放入香菇炒香。","img":"images/665077/step_6.jpg"},{"step":7,"desc":"加入适量蚝油，生抽。","img":"images/665077/step_7.jpg"},{"step":8,"desc":"翻炒均匀。","img":"images/665077/step_8.jpg"},{"step":9,"desc":"加入适量清水煮开两三分钟。","img":"images/665077/step_9.jpg"},{"step":10,"desc":"少许淀粉水勾芡煮开即可。","img":"images/665077/step_10.jpg"},{"step":11,"desc":"响铃卷适量清水泡软。","img":"images/665077/step_11.jpg"},{"step":12,"desc":"虾滑备用。","img":"images/665077/step_12.jpg"},{"step":13,"desc":"响铃卷摊开，放上虾滑。","img":"images/665077/step_13.jpg"},{"step":14,"desc":"放入蟹柳。","img":"images/665077/step_14.jpg"},{"step":15,"desc":"将响铃卷卷起。","img":"images/665077/step_15.jpg"},{"step":16,"desc":"卷好的响铃卷放入砂锅中。","img":"images/665077/step_16.jpg"},{"step":17,"desc":"舀上酱汁。","img":"images/665077/step_17.jpg"},{"step":18,"desc":"盖上大火煮开。","img":"images/665077/step_18.jpg"},{"step":19,"desc":"中小火焖5分钟左右即可。","img":"images/665077/step_19.jpg"},{"step":20,"desc":"成品。","img":"images/665077/step_20.jpg"},{"step":21,"desc":"成品。","img":"images/665077/step_21.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：砂锅、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}