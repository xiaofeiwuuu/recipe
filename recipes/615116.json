{"id":"615116","name":"驴肉蒸饺","author":"雨中漫步li","authorId":"10274398","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/615116/cover.jpg","ingredients":{"main":[{"name":"面粉","amount":"适量"},{"name":"驴肉","amount":"适量"}],"sub":[{"name":"洋葱","amount":"适量"},{"name":"白萝卜","amount":"适量"}]},"steps":[{"step":1,"desc":"新鲜驴肉，切小块洗净。","img":"images/615116/step_1.jpg"},{"step":2,"desc":"放入绞肉机。","img":"images/615116/step_2.jpg"},{"step":3,"desc":"绞成肉馅。","img":"images/615116/step_3.jpg"},{"step":4,"desc":"提前泡好的花椒水。","img":"images/615116/step_4.jpg"},{"step":5,"desc":"姜末切好。","img":"images/615116/step_5.jpg"},{"step":6,"desc":"白萝卜切好。","img":"images/615116/step_6.jpg"},{"step":7,"desc":"洋葱切好。","img":"images/615116/step_7.jpg"},{"step":8,"desc":"全部放在一起。","img":"images/615116/step_8.jpg"},{"step":9,"desc":"里面倒入花椒水、蚝油、生抽、花椒油、芝麻油。","img":"images/615116/step_9.jpg"},{"step":10,"desc":"拌匀即可。","img":"images/615116/step_10.jpg"},{"step":11,"desc":"面粉用一半开水，一半冷水合成一个面团，醒20分钟。","img":"images/615116/step_11.jpg"},{"step":12,"desc":"分成均匀的剂子，擀成饺子皮。","img":"images/615116/step_12.jpg"},{"step":13,"desc":"放入馅料。","img":"images/615116/step_13.jpg"},{"step":14,"desc":"全部包好。","img":"images/615116/step_14.jpg"},{"step":15,"desc":"冷水上锅，大火烧开转中火蒸15分钟。","img":"images/615116/step_15.jpg"},{"step":16,"desc":"关火焖5分钟，出锅。","img":"images/615116/step_16.jpg"},{"step":17,"desc":"太香了这蒸饺。","img":"images/615116/step_17.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：蒸锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}