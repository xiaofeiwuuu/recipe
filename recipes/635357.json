{"id":"635357","name":"艾叶黑芝麻馒头","author":"雨中漫步li","authorId":"10274398","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/635357/cover.jpg","ingredients":{"main":[{"name":"艾叶","amount":"适量"},{"name":"面粉","amount":"400克"},{"name":"黑芝麻","amount":"适量"}],"sub":[{"name":"酵母","amount":"4克"},{"name":"白糖","amount":"20克"},{"name":"猪油","amount":"10克"}]},"steps":[{"step":1,"desc":"艾叶洗净焯水。","img":"images/635357/step_1.jpg"},{"step":2,"desc":"加水放料理机打碎。","img":"images/635357/step_2.jpg"},{"step":3,"desc":"倒入200克艾叶汁，放酵母。","img":"images/635357/step_3.jpg"},{"step":4,"desc":"用厨师机揉成光滑的面团，醒发至两倍大。","img":"images/635357/step_4.jpg"},{"step":5,"desc":"黑芝麻炒熟，放破壁机打碎，猪油化开倒入黑芝麻里面，倒入白糖拌匀。","img":"images/635357/step_5.jpg"},{"step":6,"desc":"醒好的面团分成均匀的剂子，擀成包子皮。","img":"images/635357/step_6.jpg"},{"step":7,"desc":"放入黑芝麻馅。","img":"images/635357/step_7.jpg"},{"step":8,"desc":"收口，全部包好。","img":"images/635357/step_8.jpg"},{"step":9,"desc":"二次醒发30分钟，冷水上锅。","img":"images/635357/step_9.jpg"},{"step":10,"desc":"大火烧开转中火蒸15分钟。","img":"images/635357/step_10.jpg"},{"step":11,"desc":"关火焖5分钟，出锅。","img":"images/635357/step_11.jpg"},{"step":12,"desc":"煊软香甜。","img":"images/635357/step_12.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：蒸锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}