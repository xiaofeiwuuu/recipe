{"id":"648269","name":"麻辣拌","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/648269/cover.jpg","ingredients":{"main":[{"name":"火锅丸子","amount":"适量"},{"name":"熟卤牛肚","amount":"适量"},{"name":"面饼","amount":"适量"},{"name":"千张","amount":"适量"},{"name":"金针菇","amount":"适量"}],"sub":[{"name":"蒜头","amount":"适量"},{"name":"葱花","amount":"适量"},{"name":"白芝麻","amount":"适量"}]},"steps":[{"step":1,"desc":"吃不完的熟卤牛肚备用。","img":"images/648269/step_1.jpg"},{"step":2,"desc":"剩的火锅丸子备用。","img":"images/648269/step_2.jpg"},{"step":3,"desc":"金针菇洗净切去根部。","img":"images/648269/step_3.jpg"},{"step":4,"desc":"千张洗净切细备用。","img":"images/648269/step_4.jpg"},{"step":5,"desc":"蒜头拍扁剁碎备用。","img":"images/648269/step_5.jpg"},{"step":6,"desc":"碗中放入蒜末，白芝麻，辣椒粉和烧烤料。","img":"images/648269/step_6.jpg"},{"step":7,"desc":"淋上热油。","img":"images/648269/step_7.jpg"},{"step":8,"desc":"加入适量蚝油，生抽，盐，陈醋和花生油，搅拌均匀备用。","img":"images/648269/step_8.jpg"},{"step":9,"desc":"锅中水烧开放入火锅丸子煮至断生捞出。","img":"images/648269/step_9.jpg"},{"step":10,"desc":"放入千张焯烫后捞出。","img":"images/648269/step_10.jpg"},{"step":11,"desc":"放入金针菇焯烫变软捞出。","img":"images/648269/step_11.jpg"},{"step":12,"desc":"放入面饼，煮开后捞出。","img":"images/648269/step_12.jpg"},{"step":13,"desc":"加入适量熟卤牛肚。","img":"images/648269/step_13.jpg"},{"step":14,"desc":"放入葱花。","img":"images/648269/step_14.jpg"},{"step":15,"desc":"淋上准备好的干拌汁抓匀即可。","img":"images/648269/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/648269/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/648269/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/648269/step_18.jpg"},{"step":19,"desc":"成品。","img":"images/648269/step_19.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：煮锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}