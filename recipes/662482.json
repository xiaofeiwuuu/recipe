{"id":"662482","name":"口蘑牛肉焖饭","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/662482/cover.jpg","ingredients":{"main":[{"name":"牛肉","amount":"适量"},{"name":"口蘑","amount":"适量"}],"sub":[{"name":"葱花","amount":"适量"}]},"steps":[{"step":1,"desc":"牛肉洗净切薄片。","img":"images/662482/step_1.jpg"},{"step":2,"desc":"加入适量老抽，生抽，蚝油，玉米淀粉抓拌均匀。","img":"images/662482/step_2.jpg"},{"step":3,"desc":"适量花生油抓匀锁住水份。","img":"images/662482/step_3.jpg"},{"step":4,"desc":"大米洗净备用。","img":"images/662482/step_4.jpg"},{"step":5,"desc":"加入平时煮饭的水量。","img":"images/662482/step_5.jpg"},{"step":6,"desc":"先将米饭煲上。","img":"images/662482/step_6.jpg"},{"step":7,"desc":"口蘑洗净切片。","img":"images/662482/step_7.jpg"},{"step":8,"desc":"锅中热油放入口蘑。","img":"images/662482/step_8.jpg"},{"step":9,"desc":"翻炒均匀。","img":"images/662482/step_9.jpg"},{"step":10,"desc":"放入牛肉翻炒。","img":"images/662482/step_10.jpg"},{"step":11,"desc":"适量盐调味。","img":"images/662482/step_11.jpg"},{"step":12,"desc":"适量老抽炒匀上色。","img":"images/662482/step_12.jpg"},{"step":13,"desc":"翻炒均匀备用。","img":"images/662482/step_13.jpg"},{"step":14,"desc":"米饭煲至水份收干。","img":"images/662482/step_14.jpg"},{"step":15,"desc":"放入炒过的口蘑牛肉，继续把饭煲熟后翻拌均匀即可。","img":"images/662482/step_15.jpg"},{"step":16,"desc":"煲好后的米饭又加了一层芝士，烤箱烘烤。","img":"images/662482/step_16.jpg"},{"step":17,"desc":"孩子喜欢的芝士焗饭。","img":"images/662482/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/662482/step_18.jpg"},{"step":19,"desc":"成品。","img":"images/662482/step_19.jpg"},{"step":20,"desc":"成品。","img":"images/662482/step_20.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：电饭煲、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}