{"id":"662412","name":"鸭子烧魔芋","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/662412/cover.jpg","ingredients":{"main":[{"name":"鸭肉","amount":"适量"},{"name":"魔芋","amount":"适量"}],"sub":[{"name":"姜片","amount":"适量"},{"name":"葱花","amount":"适量"}]},"steps":[{"step":1,"desc":"鸭肉冷水下锅焯烫出血水后洗净。","img":"images/662412/step_1.jpg"},{"step":2,"desc":"适量生姜切片。","img":"images/662412/step_2.jpg"},{"step":3,"desc":"魔芋改刀切块备用。","img":"images/662412/step_3.jpg"},{"step":4,"desc":"锅中热油放入姜片炒香。","img":"images/662412/step_4.jpg"},{"step":5,"desc":"放入鸭肉翻炒均匀。","img":"images/662412/step_5.jpg"},{"step":6,"desc":"加入适量蚝油，生抽，老抽，盐。","img":"images/662412/step_6.jpg"},{"step":7,"desc":"翻炒均匀上色入味。","img":"images/662412/step_7.jpg"},{"step":8,"desc":"加入适量清水。","img":"images/662412/step_8.jpg"},{"step":9,"desc":"将鸭肉转入珐琅锅中。","img":"images/662412/step_9.jpg"},{"step":10,"desc":"大火煮开盖上焖30分钟左右。","img":"images/662412/step_10.jpg"},{"step":11,"desc":"分钟后放入魔芋。","img":"images/662412/step_11.jpg"},{"step":12,"desc":"继续焖15分钟左右。","img":"images/662412/step_12.jpg"},{"step":13,"desc":"出锅前大火收汁即可。","img":"images/662412/step_13.jpg"},{"step":14,"desc":"成品。","img":"images/662412/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/662412/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/662412/step_16.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：煮锅、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}