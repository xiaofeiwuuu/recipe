{"id":"444790","name":"木瓜银耳红枣煲鱼尾汤","author":"企茶点茶档","authorId":"11132809","desc":"","cover":"images/444790/cover.jpg","ingredients":{"main":[{"name":"木瓜","amount":"半个"},{"name":"鱼尾","amount":"1个"},{"name":"银耳","amount":"半朵"},{"name":"红枣","amount":"数粒"}],"sub":[{"name":"油","amount":"适量"},{"name":"葱段","amount":"适量"},{"name":"盐","amount":"适量"},{"name":"姜","amount":"适量"},{"name":"料酒","amount":"适量"}]},"steps":[{"step":1,"desc":"预备材料，清洗干净。","img":"images/444790/step_1.jpg"},{"step":2,"desc":"木瓜去皮，切块。","img":"images/444790/step_2.jpg"},{"step":3,"desc":"鱼尾热油煎两面，放适量料酒去腥。","img":"images/444790/step_3.jpg"},{"step":4,"desc":"鱼尾煎好加入热水，再下银耳和红枣。","img":"images/444790/step_4.jpg"},{"step":5,"desc":"当水再开了，就下木瓜。","img":"images/444790/step_5.jpg"},{"step":6,"desc":"煲20分钟左右，下盐调味，再下葱段。","img":"images/444790/step_6.jpg"},{"step":7,"desc":"就可以上桌咯。","img":"images/444790/step_7.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：煮锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}