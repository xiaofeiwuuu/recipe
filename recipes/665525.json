{"id":"665525","name":"海鲜杂拼","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/665525/cover.jpg","ingredients":{"main":[{"name":"梭子蟹","amount":"适量"},{"name":"罗氏虾","amount":"适量"},{"name":"鱿鱼","amount":"适量"},{"name":"花甲","amount":"适量"}],"sub":[{"name":"生姜","amount":"适量"}]},"steps":[{"step":1,"desc":"生姜切片。","img":"images/665525/step_1.jpg"},{"step":2,"desc":"罗氏虾剪去虾枪虾须洗净备用。","img":"images/665525/step_2.jpg"},{"step":3,"desc":"梭子蟹处理好洗净备用。","img":"images/665525/step_3.jpg"},{"step":4,"desc":"花甲洗净备用。","img":"images/665525/step_4.jpg"},{"step":5,"desc":"鱿鱼处理好洗净，改刀切块。","img":"images/665525/step_5.jpg"},{"step":6,"desc":"梭子蟹均匀沾上玉米淀粉。","img":"images/665525/step_6.jpg"},{"step":7,"desc":"锅中热油将梭子蟹下锅煎至金黄后盛出。","img":"images/665525/step_7.jpg"},{"step":8,"desc":"锅中酱油将罗氏虾下锅煎出虾油。","img":"images/665525/step_8.jpg"},{"step":9,"desc":"放入煎过的梭子蟹。","img":"images/665525/step_9.jpg"},{"step":10,"desc":"放入姜片，加入适量清水。","img":"images/665525/step_10.jpg"},{"step":11,"desc":"放入花甲。","img":"images/665525/step_11.jpg"},{"step":12,"desc":"放入鱿鱼。","img":"images/665525/step_12.jpg"},{"step":13,"desc":"放入蟹钳和蟹壳，盖上大火焖断生入味。","img":"images/665525/step_13.jpg"},{"step":14,"desc":"出锅前少许淀粉水收汁即可。","img":"images/665525/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/665525/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/665525/step_16.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}