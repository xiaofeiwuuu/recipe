{"id":"647308","name":"紫菜包饭","author":"诗韵墨香","authorId":"10606182","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/647308/cover.jpg","ingredients":{"main":[{"name":"紫菜","amount":"两张"},{"name":"胡萝卜","amount":"适量"},{"name":"黄瓜","amount":"适量"},{"name":"香肠","amount":"一根"}],"sub":[{"name":"米饭","amount":"一碗"},{"name":"柠檬汁","amount":"几滴"},{"name":"芝麻","amount":"适量"}]},"steps":[{"step":1,"desc":"成品图。","img":"images/647308/step_1.jpg"},{"step":2,"desc":"准备好食材备用。","img":"images/647308/step_2.jpg"},{"step":3,"desc":"胡萝卜黄瓜改刀切条，开水烫去生味，捞出过凉水，香肠切条备用。","img":"images/647308/step_3.jpg"},{"step":4,"desc":"适量米饭，加入适量盐，香油，芝麻，白醋，柠檬汁几滴，拌均备用。","img":"images/647308/step_4.jpg"},{"step":5,"desc":"寿司帘铺一张紫菜，米饭摊好按压一下，放入食材。","img":"images/647308/step_5.jpg"},{"step":6,"desc":"从一边卷起。","img":"images/647308/step_6.jpg"},{"step":7,"desc":"用刀切小块。","img":"images/647308/step_7.jpg"},{"step":8,"desc":"全部切好，可以蘸番茄酱吃，别有一番风味。","img":"images/647308/step_8.jpg"},{"step":9,"desc":"成品图。","img":"images/647308/step_9.jpg"},{"step":10,"desc":"成品图。","img":"images/647308/step_10.jpg"},{"step":11,"desc":"成品图。","img":"images/647308/step_11.jpg"},{"step":12,"desc":"成品图。","img":"images/647308/step_12.jpg"},{"step":13,"desc":"成品图。","img":"images/647308/step_13.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：电饭煲\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}