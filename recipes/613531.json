{"id":"613531","name":"菠萝饭","author":"五加五左左","authorId":"11514294","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/613531/cover.jpg","ingredients":{"main":[{"name":"菠萝","amount":"1个"},{"name":"隔夜米饭","amount":"1碗"},{"name":"鸡蛋","amount":"2个"},{"name":"火腿肠","amount":"1根"},{"name":"青椒","amount":"半个"},{"name":"玉米粒","amount":"少许"}],"sub":[{"name":"盐","amount":"少许"}]},"steps":[{"step":1,"desc":"准备食材。","img":"images/613531/step_1.jpg"},{"step":2,"desc":"青椒火腿肠切粒。","img":"images/613531/step_2.jpg"},{"step":3,"desc":"菠萝对半切开。","img":"images/613531/step_3.jpg"},{"step":4,"desc":"挖出果肉，切小块。","img":"images/613531/step_4.jpg"},{"step":5,"desc":"鸡蛋打入碗中，其中1个蛋黄打入米饭。","img":"images/613531/step_5.jpg"},{"step":6,"desc":"鸡蛋打散，蛋黄和米饭拌匀。","img":"images/613531/step_6.jpg"},{"step":7,"desc":"起锅烧油。","img":"images/613531/step_7.jpg"},{"step":8,"desc":"倒入蛋液，炒鸡蛋。","img":"images/613531/step_8.jpg"},{"step":9,"desc":"炒熟。","img":"images/613531/step_9.jpg"},{"step":10,"desc":"把鸡蛋滑碎。","img":"images/613531/step_10.jpg"},{"step":11,"desc":"盛出装碗。","img":"images/613531/step_11.jpg"},{"step":12,"desc":"再起锅，倒入火腿和青椒，小火煸香。","img":"images/613531/step_12.jpg"},{"step":13,"desc":"倒入玉米粒，翻炒。","img":"images/613531/step_13.jpg"},{"step":14,"desc":"倒入炒好的鸡蛋。","img":"images/613531/step_14.jpg"},{"step":15,"desc":"少许盐调味。","img":"images/613531/step_15.jpg"},{"step":16,"desc":"倒入米饭，翻炒，把米饭炒出颗粒感。","img":"images/613531/step_16.jpg"},{"step":17,"desc":"加入菠萝。","img":"images/613531/step_17.jpg"},{"step":18,"desc":"继续炒，把菠萝炒软。","img":"images/613531/step_18.jpg"},{"step":19,"desc":"盛入切好的菠萝里","img":"images/613531/step_19.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}