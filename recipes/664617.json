{"id":"664617","name":"苦瓜焖牛腩","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/664617/cover.jpg","ingredients":{"main":[{"name":"牛腩","amount":"适量"},{"name":"苦瓜","amount":"适量"}],"sub":[{"name":"蒜头","amount":"适量"},{"name":"生姜","amount":"适量"}]},"steps":[{"step":1,"desc":"牛腩改刀切小块。","img":"images/664617/step_1.jpg"},{"step":2,"desc":"牛腩冷水下锅焯烫后捞出洗净。","img":"images/664617/step_2.jpg"},{"step":3,"desc":"生姜洗净切片。","img":"images/664617/step_3.jpg"},{"step":4,"desc":"蒜头去皮备用。","img":"images/664617/step_4.jpg"},{"step":5,"desc":"苦瓜去籽洗净改刀切块。","img":"images/664617/step_5.jpg"},{"step":6,"desc":"锅中热油放入姜片翻炒。","img":"images/664617/step_6.jpg"},{"step":7,"desc":"放入牛腩炒匀。","img":"images/664617/step_7.jpg"},{"step":8,"desc":"适量蚝油，生抽，盐。","img":"images/664617/step_8.jpg"},{"step":9,"desc":"翻炒均匀入味。","img":"images/664617/step_9.jpg"},{"step":10,"desc":"加入适量清水。","img":"images/664617/step_10.jpg"},{"step":11,"desc":"将牛腩转入高压锅，大火压10分钟左右。","img":"images/664617/step_11.jpg"},{"step":12,"desc":"锅中底油放入蒜头炒至金黄。","img":"images/664617/step_12.jpg"},{"step":13,"desc":"放入苦瓜翻炒。","img":"images/664617/step_13.jpg"},{"step":14,"desc":"炒过的苦瓜盛入压好的牛腩中。","img":"images/664617/step_14.jpg"},{"step":15,"desc":"盖上继续大火压10分钟左右即可。","img":"images/664617/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/664617/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/664617/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/664617/step_18.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：高压锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}