{"id":"621921","name":"凉拌秋葵蛏子","author":"五加五左左","authorId":"11514294","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/621921/cover.jpg","ingredients":{"main":[{"name":"蛏子","amount":"1斤"},{"name":"秋葵","amount":"10只"}],"sub":[{"name":"蒜","amount":"4-5瓣"},{"name":"小米辣","amount":"1根"},{"name":"姜","amount":"1块"},{"name":"香菜","amount":"1根"},{"name":"葱","amount":"1块"}]},"steps":[{"step":1,"desc":"准备食材，秋葵洗净，蛏子泡水。","img":"images/621921/step_1.jpg"},{"step":2,"desc":"烧开水，放一勺盐。","img":"images/621921/step_2.jpg"},{"step":3,"desc":"煮秋葵。","img":"images/621921/step_3.jpg"},{"step":4,"desc":"煮熟。","img":"images/621921/step_4.jpg"},{"step":5,"desc":"捞出泡凉白开水。","img":"images/621921/step_5.jpg"},{"step":6,"desc":"秋葵切段。","img":"images/621921/step_6.jpg"},{"step":7,"desc":"装盘备用。","img":"images/621921/step_7.jpg"},{"step":8,"desc":"蛏子凉水下锅，放葱姜花椒大料。","img":"images/621921/step_8.jpg"},{"step":9,"desc":"煮熟。","img":"images/621921/step_9.jpg"},{"step":10,"desc":"捞出后晾凉。","img":"images/621921/step_10.jpg"},{"step":11,"desc":"将蛏子肉扒出，放在秋葵上面。","img":"images/621921/step_11.jpg"},{"step":12,"desc":"小米辣，葱姜和蒜切末。","img":"images/621921/step_12.jpg"},{"step":13,"desc":"起锅热油。","img":"images/621921/step_13.jpg"},{"step":14,"desc":"倒入葱姜蒜末，炸熟后，倒入调料汁，酱油耗油醋和水各一勺。","img":"images/621921/step_14.jpg"},{"step":15,"desc":"大火收汁。","img":"images/621921/step_15.jpg"},{"step":16,"desc":"倒入秋葵蛏子上面。","img":"images/621921/step_16.jpg"},{"step":17,"desc":"再撒一把香菜。","img":"images/621921/step_17.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}