{"id":"600374","name":"虾仁蛋炒饭","author":"优子家的味道","authorId":"9910251","desc":"","cover":"images/600374/cover.jpg","ingredients":{"main":[{"name":"米饭","amount":"适量"}],"sub":[{"name":"虾仁","amount":"适量"},{"name":"鸡蛋","amount":"3个"},{"name":"黄瓜","amount":"1根"},{"name":"青豆","amount":"适量"},{"name":"火腿肠","amount":"1根"},{"name":"小油菜","amount":"适量"},{"name":"葱","amount":"适量"},{"name":"姜","amount":"适量"},{"name":"蒜","amount":"适量"}]},"steps":[{"step":1,"desc":"葱（洋葱、大葱均可）、姜、蒜。","img":"images/600374/step_1.jpg"},{"step":2,"desc":"火腿肠切丁。","img":"images/600374/step_2.jpg"},{"step":3,"desc":"黄瓜切丁。","img":"images/600374/step_3.jpg"},{"step":4,"desc":"小油菜切块。","img":"images/600374/step_4.jpg"},{"step":5,"desc":"油炸青豆。","img":"images/600374/step_5.jpg"},{"step":6,"desc":"虾仁（冷冻的要提前解冻）。","img":"images/600374/step_6.jpg"},{"step":7,"desc":"鸡蛋。","img":"images/600374/step_7.jpg"},{"step":8,"desc":"菜配齐后先腌虾仁。","img":"images/600374/step_8.jpg"},{"step":9,"desc":"放入料酒、酱油、白胡椒。","img":"images/600374/step_9.jpg"},{"step":10,"desc":"用手抓匀。","img":"images/600374/step_10.jpg"},{"step":11,"desc":"腌制十五分钟。","img":"images/600374/step_11.jpg"},{"step":12,"desc":"鸡蛋炒好备用。","img":"images/600374/step_12.jpg"},{"step":13,"desc":"虾仁煎至双面焦黄捞出备用。","img":"images/600374/step_13.jpg"},{"step":14,"desc":"油热后下入葱姜蒜。","img":"images/600374/step_14.jpg"},{"step":15,"desc":"炒香后依次倒入火腿肠。","img":"images/600374/step_15.jpg"},{"step":16,"desc":"黄瓜。","img":"images/600374/step_16.jpg"},{"step":17,"desc":"小油菜。","img":"images/600374/step_17.jpg"},{"step":18,"desc":"放入料酒、蚝油、盐、十三香。","img":"images/600374/step_18.jpg"},{"step":19,"desc":"炒拌均匀倒入米饭。","img":"images/600374/step_19.jpg"},{"step":20,"desc":"将米饭打散。","img":"images/600374/step_20.jpg"},{"step":21,"desc":"炒匀。","img":"images/600374/step_21.jpg"},{"step":22,"desc":"最后放入鸡蛋、虾仁、青豆、味精。","img":"images/600374/step_22.jpg"},{"step":23,"desc":"炒拌均匀即可出锅。","img":"images/600374/step_23.jpg"},{"step":24,"desc":"美味漂亮又有营养的虾仁蛋炒饭就好了，祝大家用餐愉快！","img":"images/600374/step_24.jpg"}],"tips":"虾仁一定要提前腌制。 \n\t