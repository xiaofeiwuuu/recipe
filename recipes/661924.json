{"id":"661924","name":"腐竹焖羊肉","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/661924/cover.jpg","ingredients":{"main":[{"name":"羊肉","amount":"适量"},{"name":"腐竹","amount":"适量"}],"sub":[{"name":"八角","amount":"适量"},{"name":"桂皮","amount":"适量"},{"name":"香叶","amount":"适量"},{"name":"葱花","amount":"适量"},{"name":"生姜","amount":"适量"}]},"steps":[{"step":1,"desc":"腐竹提前泡发备用。","img":"images/661924/step_1.jpg"},{"step":2,"desc":"生姜，八角，桂皮，香叶备用。","img":"images/661924/step_2.jpg"},{"step":3,"desc":"羊肉冷水下锅焯烫出血水后洗净。","img":"images/661924/step_3.jpg"},{"step":4,"desc":"锅中热油炒香配料。","img":"images/661924/step_4.jpg"},{"step":5,"desc":"放入羊肉翻炒炒香。","img":"images/661924/step_5.jpg"},{"step":6,"desc":"加入适量蚝油，老抽。","img":"images/661924/step_6.jpg"},{"step":7,"desc":"翻炒均匀上色。","img":"images/661924/step_7.jpg"},{"step":8,"desc":"加入适量清水。","img":"images/661924/step_8.jpg"},{"step":9,"desc":"将羊肉转入高压锅中。","img":"images/661924/step_9.jpg"},{"step":10,"desc":"大火煮开转小火20分钟。","img":"images/661924/step_10.jpg"},{"step":11,"desc":"压软烂的羊肉倒入砂锅中。","img":"images/661924/step_11.jpg"},{"step":12,"desc":"放入泡发好的腐竹。","img":"images/661924/step_12.jpg"},{"step":13,"desc":"大火煮开，少许盐调味，稍微收汁即可。","img":"images/661924/step_13.jpg"},{"step":14,"desc":"成品。","img":"images/661924/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/661924/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/661924/step_16.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：高压锅、砂锅、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}