{"id":"493124","name":"西红柿鸡蛋汤","author":"天下美食diy","authorId":"8356173","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/493124/cover.jpg","ingredients":{"main":[{"name":"西红柿","amount":"1个"}],"sub":[{"name":"鸡蛋","amount":"2个"},{"name":"香菜","amount":"适量"},{"name":"葱","amount":"适量"},{"name":"白胡椒粉","amount":"适量"},{"name":"盐","amount":"适量"},{"name":"鸡精","amount":"适量"},{"name":"淀粉","amount":"适量"}]},"steps":[{"step":1,"desc":"西红柿洗净，切十字花刀。","img":"images/493124/step_1.jpg"},{"step":2,"desc":"锅内加水。水开放入西红柿煮2分钟捞出。","img":"images/493124/step_2.jpg"},{"step":3,"desc":"西红柿去皮。","img":"images/493124/step_3.jpg"},{"step":4,"desc":"切片。","img":"images/493124/step_4.jpg"},{"step":5,"desc":"鸡蛋打入碗内。加一汤匙水淀粉。","img":"images/493124/step_5.jpg"},{"step":6,"desc":"打散。","img":"images/493124/step_6.jpg"},{"step":7,"desc":"锅内加水，放入西红柿。","img":"images/493124/step_7.jpg"},{"step":8,"desc":"打去浮沫。","img":"images/493124/step_8.jpg"},{"step":9,"desc":"加入盐，鸡精，胡椒粉。","img":"images/493124/step_9.jpg"},{"step":10,"desc":"放入鸡蛋搅匀。水淀粉勾薄芡。出锅。","img":"images/493124/step_10.jpg"},{"step":11,"desc":"盛入碗中，撒葱花。香菜末。","img":"images/493124/step_11.jpg"},{"step":12,"desc":"大功告成，求赞，求关注，求收藏。","img":"images/493124/step_12.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}