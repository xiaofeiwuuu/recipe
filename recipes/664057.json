{"id":"664057","name":"酱香饼","author":"芊芊美食记WQ","authorId":"10676629","desc":"","cover":"images/664057/cover.jpg","ingredients":{"main":[{"name":"中筋面粉","amount":"300克"},{"name":"水","amount":"150克"},{"name":"盐","amount":"2克"},{"name":"蒜末","amount":"适量"},{"name":"洋葱末","amount":"适量"}],"sub":[{"name":"白芝麻","amount":"适量"},{"name":"葱花","amount":"适量"},{"name":"低筋面粉","amount":"适量"},{"name":"食用油","amount":"适量"}]},"steps":[{"step":1,"desc":"一勺豆瓣酱。","img":"images/664057/step_1.jpg"},{"step":2,"desc":"一勺黄豆酱+一勺番茄酱。","img":"images/664057/step_2.jpg"},{"step":3,"desc":"半勺糖。","img":"images/664057/step_3.jpg"},{"step":4,"desc":"一勺淀粉。","img":"images/664057/step_4.jpg"},{"step":5,"desc":"适量水。","img":"images/664057/step_5.jpg"},{"step":6,"desc":"搅拌均匀。","img":"images/664057/step_6.jpg"},{"step":7,"desc":"起锅烧油，下入蒜末。","img":"images/664057/step_7.jpg"},{"step":8,"desc":"洋葱末，炒香。","img":"images/664057/step_8.jpg"},{"step":9,"desc":"下入调好的酱料。","img":"images/664057/step_9.jpg"},{"step":10,"desc":"煮至浓稠，盛出备用。","img":"images/664057/step_10.jpg"},{"step":11,"desc":"准备好300克面粉。","img":"images/664057/step_11.jpg"},{"step":12,"desc":"加2克盐，加入150克凉水。","img":"images/664057/step_12.jpg"},{"step":13,"desc":"搅拌至有大面絮。","img":"images/664057/step_13.jpg"},{"step":14,"desc":"下手揉成光滑的面团，盖上保鲜膜，室温松弛30分钟。","img":"images/664057/step_14.jpg"},{"step":15,"desc":"一勺面粉加入两勺油。","img":"images/664057/step_15.jpg"},{"step":16,"desc":"调成油酥。","img":"images/664057/step_16.jpg"},{"step":17,"desc":"取出松弛好的面团，搓成长条，切成均匀的小剂子（分成9等分）。","img":"images/664057/step_17.jpg"},{"step":18,"desc":"取出一个面挤，擀成圆面片。","img":"images/664057/step_18.jpg"},{"step":19,"desc":"抹上油酥，一边切开。","img":"images/664057/step_19.jpg"},{"step":20,"desc":"卷起来。","img":"images/664057/step_20.jpg"},{"step":21,"desc":"捏紧。","img":"images/664057/step_21.jpg"},{"step":22,"desc":"大头朝下，按扁。","img":"images/664057/step_22.jpg"},{"step":23,"desc":"再次擀大擀薄。","img":"images/664057/step_23.jpg"},{"step":24,"desc":"电饼铛预热，加油。","img":"images/664057/step_24.jpg"},{"step":25,"desc":"放入饼胚。","img":"images/664057/step_25.jpg"},{"step":26,"desc":"煎至两面金黄。","img":"images/664057/step_26.jpg"},{"step":27,"desc":"刷上之前熬好的酱料。","img":"images/664057/step_27.jpg"},{"step":28,"desc":"撒上白芝麻。","img":"images/664057/step_28.jpg"},{"step":29,"desc":"撒上葱花。","img":"images/664057/step_29.jpg"},{"step":30,"desc":"好了。","img":"images/664057/step_30.jpg"},{"step":31,"desc":"切成小块就可以吃了，咸香酥脆，酱香浓郁。","img":"images/664057/step_31.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：电饼铛\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}