{"id":"603779","name":"火腿青菜炒面","author":"还在吃吃吃","authorId":"10106890","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/603779/cover.jpg","ingredients":{"main":[{"name":"面条","amount":"200克"},{"name":"火腿肠","amount":"3根"},{"name":"小青菜","amount":"8棵"},{"name":"绿豆芽","amount":"100克"},{"name":"葱花","amount":"适量"},{"name":"油炸花生米","amount":"100克"},{"name":"蒜蓉","amount":"适量"}],"sub":[{"name":"食用油","amount":"2勺"},{"name":"生抽","amount":"2勺"},{"name":"蚝油","amount":"1勺"},{"name":"郫县豆瓣酱","amount":"1勺"}]},"steps":[{"step":1,"desc":"准备食材：鲜面条，火腿肠，小青菜，绿豆芽。","img":"images/603779/step_1.jpg"},{"step":2,"desc":"火腿肠切片。","img":"images/603779/step_2.jpg"},{"step":3,"desc":"小葱切葱花。","img":"images/603779/step_3.jpg"},{"step":4,"desc":"开水锅中下面条。","img":"images/603779/step_4.jpg"},{"step":5,"desc":"捞出过凉水。","img":"images/603779/step_5.jpg"},{"step":6,"desc":"热油锅中爆香葱花蒜蓉下入火腿肠翻炒。","img":"images/603779/step_6.jpg"},{"step":7,"desc":"下入小青菜、绿豆芽翻炒。","img":"images/603779/step_7.jpg"},{"step":8,"desc":"下入沥干水分的面条翻炒。","img":"images/603779/step_8.jpg"},{"step":9,"desc":"加入2勺生抽。","img":"images/603779/step_9.jpg"},{"step":10,"desc":"勺耗油。","img":"images/603779/step_10.jpg"},{"step":11,"desc":"勺郫县豆瓣酱。","img":"images/603779/step_11.jpg"},{"step":12,"desc":"翻炒均匀后关火。","img":"images/603779/step_12.jpg"},{"step":13,"desc":"撒入油炸花生米。","img":"images/603779/step_13.jpg"},{"step":14,"desc":"搅拌均匀后开吃。","img":"images/603779/step_14.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：平底锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}