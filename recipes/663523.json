{"id":"663523","name":"薏米西洋菜猪杂汤","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/663523/cover.jpg","ingredients":{"main":[{"name":"薏米","amount":"适量"},{"name":"西洋菜","amount":"适量"}],"sub":[{"name":"猪肝","amount":"适量"},{"name":"猪腰","amount":"适量"},{"name":"猪心","amount":"适量"},{"name":"瘦肉","amount":"适量"},{"name":"生姜","amount":"适量"}]},"steps":[{"step":1,"desc":"西洋菜摘洗干净备用。","img":"images/663523/step_1.jpg"},{"step":2,"desc":"生姜切细备用。","img":"images/663523/step_2.jpg"},{"step":3,"desc":"猪腰，猪肝，猪心，瘦肉洗净。","img":"images/663523/step_3.jpg"},{"step":4,"desc":"将猪杂改刀切片。","img":"images/663523/step_4.jpg"},{"step":5,"desc":"切好的猪杂放入生姜。","img":"images/663523/step_5.jpg"},{"step":6,"desc":"加入玉米淀粉和适量花生油抓匀静置备用。","img":"images/663523/step_6.jpg"},{"step":7,"desc":"薏米清洗干净。","img":"images/663523/step_7.jpg"},{"step":8,"desc":"薏米放入高压锅中，加入适量清水。","img":"images/663523/step_8.jpg"},{"step":9,"desc":"高压锅大火压10-15分钟左右。","img":"images/663523/step_9.jpg"},{"step":10,"desc":"压好的薏米倒入煮锅中。","img":"images/663523/step_10.jpg"},{"step":11,"desc":"放入猪杂。","img":"images/663523/step_11.jpg"},{"step":12,"desc":"煮开变色。","img":"images/663523/step_12.jpg"},{"step":13,"desc":"放入西洋菜。","img":"images/663523/step_13.jpg"},{"step":14,"desc":"少许盐调味，大火煮开即可。","img":"images/663523/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/663523/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/663523/step_16.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}