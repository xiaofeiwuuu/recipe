{"id":"663318","name":"羊肚菌山药肉沫汤","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/663318/cover.jpg","ingredients":{"main":[{"name":"前腿肉","amount":"适量"}],"sub":[{"name":"山药","amount":"适量"},{"name":"羊肚菌","amount":"适量"}]},"steps":[{"step":1,"desc":"羊肚菌清洗干净备用。","img":"images/663318/step_1.jpg"},{"step":2,"desc":"前腿肉剁碎。","img":"images/663318/step_2.jpg"},{"step":3,"desc":"加入玉米淀粉，鱼露搅拌均匀。","img":"images/663318/step_3.jpg"},{"step":4,"desc":"将肉沫搓成球。","img":"images/663318/step_4.jpg"},{"step":5,"desc":"搓好后放入锅中。","img":"images/663318/step_5.jpg"},{"step":6,"desc":"放入羊肚菌。","img":"images/663318/step_6.jpg"},{"step":7,"desc":"加入开水。","img":"images/663318/step_7.jpg"},{"step":8,"desc":"盖上煮开，小火煲40分钟左右。","img":"images/663318/step_8.jpg"},{"step":9,"desc":"山药去皮洗净切块。","img":"images/663318/step_9.jpg"},{"step":10,"desc":"分钟左右的羊肚菌汤。","img":"images/663318/step_10.jpg"},{"step":11,"desc":"放入山药。","img":"images/663318/step_11.jpg"},{"step":12,"desc":"继续煲多15至20分钟左右。","img":"images/663318/step_12.jpg"},{"step":13,"desc":"少许盐调味即可。","img":"images/663318/step_13.jpg"},{"step":14,"desc":"成品。","img":"images/663318/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/663318/step_15.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：煮锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}