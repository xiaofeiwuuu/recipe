{"id":"624637","name":"鹿心拌金针菇面条菜","author":"不做妖精好多年","authorId":"1806550","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/624637/cover.jpg","ingredients":{"main":[{"name":"面条菜","amount":"150g"},{"name":"鹿心","amount":"60g"}],"sub":[{"name":"金针菇","amount":"150g"}]},"steps":[{"step":1,"desc":"金针菇洗净。","img":"images/624637/step_1.jpg"},{"step":2,"desc":"入锅焯水。","img":"images/624637/step_2.jpg"},{"step":3,"desc":"煮开2分钟，捞出。","img":"images/624637/step_3.jpg"},{"step":4,"desc":"面条菜洗净。","img":"images/624637/step_4.jpg"},{"step":5,"desc":"入锅焯水。","img":"images/624637/step_5.jpg"},{"step":6,"desc":"开锅即可。","img":"images/624637/step_6.jpg"},{"step":7,"desc":"过冷水。","img":"images/624637/step_7.jpg"},{"step":8,"desc":"撰干水分，和金针菇放一起。","img":"images/624637/step_8.jpg"},{"step":9,"desc":"取鹿心。","img":"images/624637/step_9.jpg"},{"step":10,"desc":"切片。","img":"images/624637/step_10.jpg"},{"step":11,"desc":"放锅里焯水。","img":"images/624637/step_11.jpg"},{"step":12,"desc":"煮开锅1分钟即可。","img":"images/624637/step_12.jpg"},{"step":13,"desc":"洗净浮沫。","img":"images/624637/step_13.jpg"},{"step":14,"desc":"放菜里，放食盐和鸡精。","img":"images/624637/step_14.jpg"},{"step":15,"desc":"放香油搅拌。","img":"images/624637/step_15.jpg"},{"step":16,"desc":"搅拌的过程放腊八醋。","img":"images/624637/step_16.jpg"},{"step":17,"desc":"拌匀即可。","img":"images/624637/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/624637/step_18.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：煮锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}