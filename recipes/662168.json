{"id":"662168","name":"冬瓜焖鹅","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/662168/cover.jpg","ingredients":{"main":[{"name":"鹅肉","amount":"适量"},{"name":"冬瓜","amount":"适量"}],"sub":[{"name":"葱花","amount":"适量"},{"name":"姜片","amount":"适量"},{"name":"八角","amount":"适量"},{"name":"桂皮","amount":"适量"},{"name":"香叶","amount":"适量"}]},"steps":[{"step":1,"desc":"将鹅肉斩块。","img":"images/662168/step_1.jpg"},{"step":2,"desc":"鹅肉冷水下锅焯烫出血水后洗净。","img":"images/662168/step_2.jpg"},{"step":3,"desc":"姜片，八角，桂皮，香叶备用。","img":"images/662168/step_3.jpg"},{"step":4,"desc":"冬瓜去皮洗净切块。","img":"images/662168/step_4.jpg"},{"step":5,"desc":"锅中热油放入香料炒香。","img":"images/662168/step_5.jpg"},{"step":6,"desc":"放入鹅肉翻炒。","img":"images/662168/step_6.jpg"},{"step":7,"desc":"加入蚝油，老抽，生抽。","img":"images/662168/step_7.jpg"},{"step":8,"desc":"翻炒均匀上色入味。","img":"images/662168/step_8.jpg"},{"step":9,"desc":"加入适量清水。","img":"images/662168/step_9.jpg"},{"step":10,"desc":"大火煮开。","img":"images/662168/step_10.jpg"},{"step":11,"desc":"将鹅肉转入高压锅中，中火压15分钟左右即可。","img":"images/662168/step_11.jpg"},{"step":12,"desc":"压好的鹅肉倒一部分出来炒锅中。","img":"images/662168/step_12.jpg"},{"step":13,"desc":"放入冬瓜，继续焖15分钟左右。","img":"images/662168/step_13.jpg"},{"step":14,"desc":"焖至冬瓜断生即可出锅。","img":"images/662168/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/662168/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/662168/step_16.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：高压锅、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}