{"id":"636998","name":"柠檬手撕鸡","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/636998/cover.jpg","ingredients":{"main":[{"name":"鸡腿","amount":"2个"},{"name":"柠檬","amount":"1个"},{"name":"洋葱","amount":"适量"}],"sub":[{"name":"香菜","amount":"适量"},{"name":"生姜","amount":"适量"},{"name":"蒜末","amount":"适量"}]},"steps":[{"step":1,"desc":"鸡腿洗净擦干水份放入碗中。","img":"images/636998/step_1.jpg"},{"step":2,"desc":"生姜洗净切片备用。","img":"images/636998/step_2.jpg"},{"step":3,"desc":"鸡腿放入盐焗粉，花生油，姜片，将鸡腿涂抹均匀，腌制入味。","img":"images/636998/step_3.jpg"},{"step":4,"desc":"将鸡腿放入盘中，倒入汤汁，锅中水烧开大火蒸20分钟左右。","img":"images/636998/step_4.jpg"},{"step":5,"desc":"柠檬用盐搓洗净后切薄片去籽。","img":"images/636998/step_5.jpg"},{"step":6,"desc":"洋葱洗净切细，香菜切段备用。","img":"images/636998/step_6.jpg"},{"step":7,"desc":"蒜头拍扁剁碎备用。","img":"images/636998/step_7.jpg"},{"step":8,"desc":"晾凉我鸡腿将肉撕下放入碗中。","img":"images/636998/step_8.jpg"},{"step":9,"desc":"加入蒜末。","img":"images/636998/step_9.jpg"},{"step":10,"desc":"放入洋葱，香菜，柠檬。","img":"images/636998/step_10.jpg"},{"step":11,"desc":"倒入蒸鸡腿的汤汁。","img":"images/636998/step_11.jpg"},{"step":12,"desc":"抓拌均匀后入味即可食用。","img":"images/636998/step_12.jpg"},{"step":13,"desc":"成品。","img":"images/636998/step_13.jpg"},{"step":14,"desc":"成品。","img":"images/636998/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/636998/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/636998/step_16.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：蒸锅、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}