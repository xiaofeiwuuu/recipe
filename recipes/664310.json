{"id":"664310","name":"海鲜蒸米粉","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/664310/cover.jpg","ingredients":{"main":[{"name":"蚝仔","amount":"适量"},{"name":"鱿鱼","amount":"适量"},{"name":"肉沫","amount":"适量"},{"name":"米粉","amount":"适量"}],"sub":[{"name":"香菇","amount":"适量"},{"name":"萝卜干","amount":"适量"},{"name":"蒜蓉酱","amount":"适量"}]},"steps":[{"step":1,"desc":"米粉冷水泡软后捞出沥干水份。","img":"images/664310/step_1.jpg"},{"step":2,"desc":"香菇提前泡发。","img":"images/664310/step_2.jpg"},{"step":3,"desc":"将香菇切细。","img":"images/664310/step_3.jpg"},{"step":4,"desc":"萝卜干洗净切细。","img":"images/664310/step_4.jpg"},{"step":5,"desc":"生蚝仔加入面粉抓洗干净备用。","img":"images/664310/step_5.jpg"},{"step":6,"desc":"鱿鱼处理好切块。","img":"images/664310/step_6.jpg"},{"step":7,"desc":"前腿肉提前绞碎备用。","img":"images/664310/step_7.jpg"},{"step":8,"desc":"锅中热油放入香菇炒出香味。","img":"images/664310/step_8.jpg"},{"step":9,"desc":"放入萝卜干翻炒。","img":"images/664310/step_9.jpg"},{"step":10,"desc":"适量蚝油老抽，生抽炒匀。","img":"images/664310/step_10.jpg"},{"step":11,"desc":"加入蒜蓉酱。","img":"images/664310/step_11.jpg"},{"step":12,"desc":"大火煮开几分钟。","img":"images/664310/step_12.jpg"},{"step":13,"desc":"加入适量淀粉水勾芡煮开备用。","img":"images/664310/step_13.jpg"},{"step":14,"desc":"适量豆芽洗净备用。","img":"images/664310/step_14.jpg"},{"step":15,"desc":"米粉加入老抽，鸡精，花生油抓匀上色。","img":"images/664310/step_15.jpg"},{"step":16,"desc":"放入豆芽拌匀。","img":"images/664310/step_16.jpg"},{"step":17,"desc":"碗中放入米粉。","img":"images/664310/step_17.jpg"},{"step":18,"desc":"放入准备好的配料，大火蒸十分钟左右，出锅前淋上提前炒好的酱汁即可。","img":"images/664310/step_18.jpg"},{"step":19,"desc":"成品。","img":"images/664310/step_19.jpg"},{"step":20,"desc":"成品。","img":"images/664310/step_20.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：蒸锅、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}