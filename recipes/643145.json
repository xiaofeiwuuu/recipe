{"id":"643145","name":"快腌辣白菜","author":"不做妖精好多年","authorId":"1806550","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/643145/cover.jpg","ingredients":{"main":[{"name":"白菜","amount":"一棵8~10斤"}],"sub":[{"name":"白萝卜","amount":"一个约400g"},{"name":"彩虹梨","amount":"一个"},{"name":"苹果","amount":"一个"},{"name":"糯米稀饭","amount":"适量"}]},"steps":[{"step":1,"desc":"大白菜去掉老叶。","img":"images/643145/step_1.jpg"},{"step":2,"desc":"对切，这种黄心的好吃。","img":"images/643145/step_2.jpg"},{"step":3,"desc":"切块。","img":"images/643145/step_3.jpg"},{"step":4,"desc":"全部放大盆里。","img":"images/643145/step_4.jpg"},{"step":5,"desc":"放食盐。","img":"images/643145/step_5.jpg"},{"step":6,"desc":"拌匀。","img":"images/643145/step_6.jpg"},{"step":7,"desc":"腌制2小时的样子。","img":"images/643145/step_7.jpg"},{"step":8,"desc":"再腌2小时。","img":"images/643145/step_8.jpg"},{"step":9,"desc":"放清水洗几次，再浸泡出盐分。","img":"images/643145/step_9.jpg"},{"step":10,"desc":"取调味酱。","img":"images/643145/step_10.jpg"},{"step":11,"desc":"取辣椒面。","img":"images/643145/step_11.jpg"},{"step":12,"desc":"取白萝卜和梨、苹果。","img":"images/643145/step_12.jpg"},{"step":13,"desc":"大蒜去皮洗净，梨和苹果及白萝卜处理好。","img":"images/643145/step_13.jpg"},{"step":14,"desc":"大蒜放果蔬杯里，苹果打丝放进来。","img":"images/643145/step_14.jpg"},{"step":15,"desc":"梨打丝放进来。","img":"images/643145/step_15.jpg"},{"step":16,"desc":"放一颗小洋葱。","img":"images/643145/step_16.jpg"},{"step":17,"desc":"放糯米稀饭。","img":"images/643145/step_17.jpg"},{"step":18,"desc":"放破壁机上。","img":"images/643145/step_18.jpg"},{"step":19,"desc":"打成汁。","img":"images/643145/step_19.jpg"},{"step":20,"desc":"白萝卜打丝。","img":"images/643145/step_20.jpg"},{"step":21,"desc":"放虾皮、泡菜酱和辣椒面。","img":"images/643145/step_21.jpg"},{"step":22,"desc":"放鸡精。","img":"images/643145/step_22.jpg"},{"step":23,"desc":"放打好的汁。","img":"images/643145/step_23.jpg"},{"step":24,"desc":"拌匀。","img":"images/643145/step_24.jpg"},{"step":25,"desc":"白菜撰干水分备用。","img":"images/643145/step_25.jpg"},{"step":26,"desc":"放白菜拌匀。","img":"images/643145/step_26.jpg"},{"step":27,"desc":"取韭菜，洗净切段