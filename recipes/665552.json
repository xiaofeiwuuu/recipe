{"id":"665552","name":"冬菇豆腐豆泡煲","author":"rosejyy2000","authorId":"20449","desc":"","cover":"images/665552/cover.jpg","ingredients":{"main":[{"name":"排骨头","amount":"约150克"},{"name":"豆腐","amount":"2大块"},{"name":"豆泡","amount":"约50克"},{"name":"水发木耳","amount":"1把"},{"name":"新鲜冬菇","amount":"6-8朵"}],"sub":[{"name":"香菜","amount":"3棵"},{"name":"姜片","amount":"8片"},{"name":"香葱","amount":"1棵"}]},"steps":[{"step":1,"desc":"冷水入煲，放姜片4片后倒入排骨头，中小火烧开；","img":"images/665552/step_1.jpg"},{"step":2,"desc":"腾出手来切豆腐约厚1公分，长宽2~3公分块；","img":"images/665552/step_2.jpg"},{"step":3,"desc":"煲里排骨及水烧开用中火烧8~10分钟；","img":"images/665552/step_3.jpg"},{"step":4,"desc":"用撇浮沫的筛子撇去浮沫；","img":"images/665552/step_4.jpg"},{"step":5,"desc":"放豆腐及木耳入煲，中小火继续烧滚；","img":"images/665552/step_5.jpg"},{"step":6,"desc":"放两棵带着头的香菜入煲；","img":"images/665552/step_6.jpg"},{"step":7,"desc":"把盒装豆泡逐块分开；","img":"images/665552/step_7.jpg"},{"step":8,"desc":"将新鲜冬菇切块；","img":"images/665552/step_8.jpg"},{"step":9,"desc":"放入豆泡烧至发软；","img":"images/665552/step_9.jpg"},{"step":10,"desc":"倒入新鲜冬菇块，翻拌几下；","img":""},{"step":11,"desc":"盖上煲盖，烧约5分钟；","img":""},{"step":12,"desc":"放入香菜1棵、切成粒的葱花入煲，收火，点入精盐约1小勺、胡椒粉1/2小勺及麻油1小勺，翻拌几下可供食用。Enjoy！","img":""}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：砂锅、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}