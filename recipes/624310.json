{"id":"624310","name":"燕麦香椿黑全麦鸡蛋煎饼","author":"一溪月","authorId":"10449735","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/624310/cover.jpg","ingredients":{"main":[{"name":"即食燕麦","amount":"小半把"},{"name":"香椿","amount":"适量"},{"name":"黑全麦面粉","amount":"适量"},{"name":"鸡蛋","amount":"一个"}],"sub":[{"name":"小米椒","amount":"可选"}]},"steps":[{"step":1,"desc":"香椿洗净。","img":"images/624310/step_1.jpg"},{"step":2,"desc":"适量水烧开，香椿焯至变绿捞出。","img":"images/624310/step_2.jpg"},{"step":3,"desc":"切成小段。","img":"images/624310/step_3.jpg"},{"step":4,"desc":"香椿碎放黑全麦面粉上。","img":"images/624310/step_4.jpg"},{"step":5,"desc":"抓入小半把即食燕麦。","img":"images/624310/step_5.jpg"},{"step":6,"desc":"打入一个柴鸡蛋，少许盐。","img":"images/624310/step_6.jpg"},{"step":7,"desc":"配适量清水，搅成稠酸奶糊。","img":"images/624310/step_7.jpg"},{"step":8,"desc":"喜欢辣点的可以切入一个小米椒。","img":"images/624310/step_8.jpg"},{"step":9,"desc":"锅里适量玉米油烧至微热，面糊倒入锅中。","img":"images/624310/step_9.jpg"},{"step":10,"desc":"用锅铲摊圆，转中小火。待煎饼凝固，晃动锅子，让煎饼脱离锅底，受热更均匀。","img":"images/624310/step_10.jpg"},{"step":11,"desc":"待饼底微微焦黄，翻面。","img":"images/624310/step_11.jpg"},{"step":12,"desc":"两面都煎至微微焦黄，期间可以多翻几次面，关火。","img":"images/624310/step_12.jpg"},{"step":13,"desc":"取出切小块。","img":"images/624310/step_13.jpg"},{"step":14,"desc":"成品。","img":"images/624310/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/624310/step_15.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：不粘锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}