{"id":"660969","name":"土豆焖牛排骨","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/660969/cover.jpg","ingredients":{"main":[{"name":"牛排骨","amount":"适量"},{"name":"土豆","amount":"适量"}],"sub":[{"name":"葱花","amount":"适量"},{"name":"姜片","amount":"适量"}]},"steps":[{"step":1,"desc":"牛排骨备用。","img":"images/660969/step_1.jpg"},{"step":2,"desc":"冷水下锅焯烫出血水后洗净。","img":"images/660969/step_2.jpg"},{"step":3,"desc":"姜片和蒜头备用。","img":"images/660969/step_3.jpg"},{"step":4,"desc":"锅中炒香蒜头姜片。","img":"images/660969/step_4.jpg"},{"step":5,"desc":"放入牛排骨翻炒。","img":"images/660969/step_5.jpg"},{"step":6,"desc":"加入适量蚝油，生抽，老抽和盐。","img":"images/660969/step_6.jpg"},{"step":7,"desc":"翻炒均匀上色入味。","img":"images/660969/step_7.jpg"},{"step":8,"desc":"将炒过的牛排骨转入高压锅中，盖上中小火压30分钟左右。","img":"images/660969/step_8.jpg"},{"step":9,"desc":"土豆洗净去皮切滚刀块。","img":"images/660969/step_9.jpg"},{"step":10,"desc":"压好的牛排骨备用。","img":"images/660969/step_10.jpg"},{"step":11,"desc":"锅中热油放入土豆。","img":"images/660969/step_11.jpg"},{"step":12,"desc":"中小火煎炒至微微金黄。","img":"images/660969/step_12.jpg"},{"step":13,"desc":"炒过的土豆放入牛排骨中。","img":"images/660969/step_13.jpg"},{"step":14,"desc":"高压锅五分钟左右即可。","img":"images/660969/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/660969/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/660969/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/660969/step_17.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：高压锅、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}