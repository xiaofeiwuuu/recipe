{"id":"664147","name":"香菇肉菜包","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/664147/cover.jpg","ingredients":{"main":[{"name":"香菇","amount":"适量"},{"name":"包菜","amount":"适量"},{"name":"胡萝卜","amount":"适量"},{"name":"肉沫","amount":"适量"}],"sub":[{"name":"面粉","amount":"500g"},{"name":"清水","amount":"260ml"},{"name":"安琪酵母","amount":"5g"},{"name":"白糖","amount":"5g"},{"name":"盐","amount":"2g"},{"name":"猪油","amount":"适量"}]},"steps":[{"step":1,"desc":"面粉加入酵母，白糖，盐。","img":"images/664147/step_1.jpg"},{"step":2,"desc":"加入猪油和清水。","img":"images/664147/step_2.jpg"},{"step":3,"desc":"搅拌成面絮。","img":"images/664147/step_3.jpg"},{"step":4,"desc":"揉成光滑的面团。","img":"images/664147/step_4.jpg"},{"step":5,"desc":"醒发面团至两倍大。","img":"images/664147/step_5.jpg"},{"step":6,"desc":"香菇提前泡发切细。","img":"images/664147/step_6.jpg"},{"step":7,"desc":"胡萝卜去皮洗净擦丝。","img":"images/664147/step_7.jpg"},{"step":8,"desc":"前腿肉提前绞碎备用。","img":"images/664147/step_8.jpg"},{"step":9,"desc":"包菜洗净切细。","img":"images/664147/step_9.jpg"},{"step":10,"desc":"锅中热油放入香菇炒出香味。","img":"images/664147/step_10.jpg"},{"step":11,"desc":"放入胡萝卜翻炒均匀。","img":"images/664147/step_11.jpg"},{"step":12,"desc":"放入包菜炒软，少许盐和鸡精调味。","img":"images/664147/step_12.jpg"},{"step":13,"desc":"炒过的青菜晾凉盛入盘中。","img":"images/664147/step_13.jpg"},{"step":14,"desc":"放入肉沫。","img":"images/664147/step_14.jpg"},{"step":15,"desc":"抓拌均匀备用。","img":"images/664147/step_15.jpg"},{"step":16,"desc":"面团取出揉均匀排气，分切成小面剂。","img":"images/664147/step_16.jpg"},{"step":17,"desc":"将面剂擀薄。","img":"images/664147/step_17.jpg"},{"step":18,"desc":"舀上馅料。","img":"images/664147/step_18.jpg"},{"step":19,"desc":"收口捏紧。","img":"images/664147/step_19.jpg"},{"step":20,"desc":"二次醒发十分钟左右。","img":"images/664147/step_20.jpg"},{"step":21,"desc":"醒发好后上锅蒸15分钟，焖5分钟后再开盖。","img":"images/664147/step_21.jpg"},{"step":22,"desc":"成品。","img":"images/664147/step_22.jpg"},{"step":23,"desc":"成品。","img":"images/664147/step_23.jpg"},{"step":24,"desc":"成品。","img":"images/664147/st