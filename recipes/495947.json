{"id":"495947","name":"咸菜豆腐滚黄骨鱼汤","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/495947/cover.jpg","ingredients":{"main":[{"name":"黄骨鱼","amount":"2条"},{"name":"咸菜","amount":"适量"},{"name":"嫩豆腐","amount":"2块"}],"sub":[{"name":"盐","amount":"适量"},{"name":"香菜","amount":"适量"},{"name":"姜片","amount":"适量"},{"name":"胡椒粉","amount":"适量"}]},"steps":[{"step":1,"desc":"咸菜冲洗一下打斜刀切薄片","img":"images/495947/step_1.jpg"},{"step":2,"desc":"嫩豆腐改刀切小块","img":"images/495947/step_2.jpg"},{"step":3,"desc":"生姜洗净切片","img":"images/495947/step_3.jpg"},{"step":4,"desc":"黄骨鱼洗去血水","img":"images/495947/step_4.jpg"},{"step":5,"desc":"热锅下油将黄骨鱼下锅煎","img":"images/495947/step_5.jpg"},{"step":6,"desc":"煎至两面金黄","img":"images/495947/step_6.jpg"},{"step":7,"desc":"加入适量的开水","img":"images/495947/step_7.jpg"},{"step":8,"desc":"放入姜片","img":"images/495947/step_8.jpg"},{"step":9,"desc":"煲至鱼汤呈白色状","img":"images/495947/step_9.jpg"},{"step":10,"desc":"加入嫩豆腐","img":"images/495947/step_10.jpg"},{"step":11,"desc":"放入咸菜","img":"images/495947/step_11.jpg"},{"step":12,"desc":"大火煮开几分钟","img":"images/495947/step_12.jpg"},{"step":13,"desc":"少许盐，胡椒粉调味即可","img":"images/495947/step_13.jpg"},{"step":14,"desc":"盛入砂锅后可再煲开一下，香菜点缀一下即可","img":"images/495947/step_14.jpg"},{"step":15,"desc":"成品","img":"images/495947/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/495947/step_16.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：砂锅、煮锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}