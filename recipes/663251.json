{"id":"663251","name":"腊排骨煲","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/663251/cover.jpg","ingredients":{"main":[{"name":"腊排骨","amount":"适量"}],"sub":[{"name":"玉米","amount":"适量"},{"name":"土豆","amount":"适量"},{"name":"莴笋","amount":"适量"},{"name":"姜片","amount":"适量"}]},"steps":[{"step":1,"desc":"腊排骨斩小块。","img":"images/663251/step_1.jpg"},{"step":2,"desc":"将骨头冷水下锅焯烫几分钟后捞出。","img":"images/663251/step_2.jpg"},{"step":3,"desc":"生姜切片。","img":"images/663251/step_3.jpg"},{"step":4,"desc":"锅中热油放入姜片翻炒。","img":"images/663251/step_4.jpg"},{"step":5,"desc":"放入排骨翻炒均匀。","img":"images/663251/step_5.jpg"},{"step":6,"desc":"加入适量清水。","img":"images/663251/step_6.jpg"},{"step":7,"desc":"将腊排骨转入高压锅中。","img":"images/663251/step_7.jpg"},{"step":8,"desc":"大火煮开转中小火压20分钟左右。","img":"images/663251/step_8.jpg"},{"step":9,"desc":"玉米洗净切段。","img":"images/663251/step_9.jpg"},{"step":10,"desc":"土豆去皮洗净切滚刀块。","img":"images/663251/step_10.jpg"},{"step":11,"desc":"莴笋去皮洗净同样切滚刀块。","img":"images/663251/step_11.jpg"},{"step":12,"desc":"锅中热油放入土豆炸过微焦捞出。","img":"images/663251/step_12.jpg"},{"step":13,"desc":"压好的腊排骨倒出。","img":"images/663251/step_13.jpg"},{"step":14,"desc":"放入土豆。","img":"images/663251/step_14.jpg"},{"step":15,"desc":"放入玉米，煮开焖几分钟。","img":"images/663251/step_15.jpg"},{"step":16,"desc":"放入莴笋，煮至莴笋断生即可，咸淡需要自己看情况加。","img":"images/663251/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/663251/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/663251/step_18.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：高压锅、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}