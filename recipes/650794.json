{"id":"650794","name":"紫菜牛肉炒饭","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/650794/cover.jpg","ingredients":{"main":[{"name":"牛肉","amount":"适量"},{"name":"紫菜","amount":"适量"},{"name":"鸡蛋","amount":"适量"}],"sub":[{"name":"米饭","amount":"适量"}]},"steps":[{"step":1,"desc":"牛肉洗净切薄片。","img":"images/650794/step_1.jpg"},{"step":2,"desc":"加入适量玉米淀粉抓匀。","img":"images/650794/step_2.jpg"},{"step":3,"desc":"加入适量蚝油，生抽抓匀。","img":"images/650794/step_3.jpg"},{"step":4,"desc":"加入花生油抓匀静置备用。","img":"images/650794/step_4.jpg"},{"step":5,"desc":"锅中加热放入紫菜。","img":"images/650794/step_5.jpg"},{"step":6,"desc":"将紫菜两面煎至墨绿色。","img":"images/650794/step_6.jpg"},{"step":7,"desc":"煎好的紫菜放入袋子中捏碎。","img":"images/650794/step_7.jpg"},{"step":8,"desc":"剩米饭备用。","img":"images/650794/step_8.jpg"},{"step":9,"desc":"米饭中打入鸡蛋。","img":"images/650794/step_9.jpg"},{"step":10,"desc":"将米饭和鸡蛋抓匀备用。","img":"images/650794/step_10.jpg"},{"step":11,"desc":"锅中热油这个牛肉。","img":"images/650794/step_11.jpg"},{"step":12,"desc":"翻炒至七八成熟后盛出。","img":"images/650794/step_12.jpg"},{"step":13,"desc":"锅中底油倒入米饭。","img":"images/650794/step_13.jpg"},{"step":14,"desc":"大火快速翻炒。","img":"images/650794/step_14.jpg"},{"step":15,"desc":"放入炒过的牛肉。","img":"images/650794/step_15.jpg"},{"step":16,"desc":"少许盐调味。","img":"images/650794/step_16.jpg"},{"step":17,"desc":"加入紫菜。","img":"images/650794/step_17.jpg"},{"step":18,"desc":"大火快速翻炒均匀。","img":"images/650794/step_18.jpg"},{"step":19,"desc":"成品。","img":"images/650794/step_19.jpg"},{"step":20,"desc":"成品。","img":"images/650794/step_20.jpg"},{"step":21,"desc":"成品。","img":"images/650794/step_21.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}