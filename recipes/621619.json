{"id":"621619","name":"香菇鸡腿饭","author":"还在吃吃吃","authorId":"10106890","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/621619/cover.jpg","ingredients":{"main":[{"name":"琵琶腿","amount":"3个"},{"name":"香菇","amount":"6朵"},{"name":"大米","amount":"1碗"}],"sub":[{"name":"食用油","amount":"2勺"},{"name":"食盐","amount":"半勺"},{"name":"料酒","amount":"1勺"},{"name":"生抽","amount":"5勺"},{"name":"老抽","amount":"1勺"},{"name":"鸡精","amount":"半勺"},{"name":"葱","amount":"适量"},{"name":"蒜末","amount":"适量"}]},"steps":[{"step":1,"desc":"鸡腿剔除骨头。","img":"images/621619/step_1.jpg"},{"step":2,"desc":"切成小丁清洗干净。","img":"images/621619/step_2.jpg"},{"step":3,"desc":"朵香菇剪去根蒂并清洗干净。","img":"images/621619/step_3.jpg"},{"step":4,"desc":"切成小丁备用。","img":"images/621619/step_4.jpg"},{"step":5,"desc":"准备葱蒜末。","img":"images/621619/step_5.jpg"},{"step":6,"desc":"将鸡丁装入盆中加入食盐、料酒、鸡精和葱蒜末搅拌均匀后并腌制10分钟。","img":"images/621619/step_6.jpg"},{"step":7,"desc":"调酱汁：碗中加入4生抽勺。","img":"images/621619/step_7.jpg"},{"step":8,"desc":"加入1勺老抽，比咧4：1。","img":"images/621619/step_8.jpg"},{"step":9,"desc":"搅拌均匀。","img":"images/621619/step_9.jpg"},{"step":10,"desc":"起锅烧油。","img":"images/621619/step_10.jpg"},{"step":11,"desc":"下入鸡丁翻炒2分钟。","img":"images/621619/step_11.jpg"},{"step":12,"desc":"倒入适量酱汁。","img":"images/621619/step_12.jpg"},{"step":13,"desc":"加入香菇丁翻炒均匀。","img":"images/621619/step_13.jpg"},{"step":14,"desc":"电饭锅内胆放入1碗大米，清洗干净后倒入适量的清水。","img":"images/621619/step_14.jpg"},{"step":15,"desc":"将炒好的鸡丁香菇丁倒入电饭煲内胆中。","img":"images/621619/step_15.jpg"},{"step":16,"desc":"预约煮饭键40分钟煮制。","img":"images/621619/step_16.jpg"},{"step":17,"desc":"香喷喷的香菇鸡丁饭做好了。","img":"images/621619/step_17.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：电饭煲\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}