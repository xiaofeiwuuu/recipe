{"id":"661010","name":"肉沫焖海参","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/661010/cover.jpg","ingredients":{"main":[{"name":"梅花肉","amount":"适量"},{"name":"海参","amount":"适量"},{"name":"胡萝卜","amount":"适量"},{"name":"香菇","amount":"适量"},{"name":"虾米","amount":"适量"}],"sub":[{"name":"葱花","amount":"适量"}]},"steps":[{"step":1,"desc":"泡发好的海参备用。","img":"images/661010/step_1.jpg"},{"step":2,"desc":"香菇提前泡发洗净。","img":"images/661010/step_2.jpg"},{"step":3,"desc":"干虾米清水泡发一下。","img":"images/661010/step_3.jpg"},{"step":4,"desc":"梅花肉洗净切小块后再剁碎备用。","img":"images/661010/step_4.jpg"},{"step":5,"desc":"香菇切小丁。","img":"images/661010/step_5.jpg"},{"step":6,"desc":"胡萝卜去皮洗净切小块。","img":"images/661010/step_6.jpg"},{"step":7,"desc":"海参清洗后切小块。","img":"images/661010/step_7.jpg"},{"step":8,"desc":"锅中热油放入肉沫。","img":"images/661010/step_8.jpg"},{"step":9,"desc":"将肉沫炒散开炒干水份。","img":"images/661010/step_9.jpg"},{"step":10,"desc":"放入香菇和虾米炒出香味。","img":"images/661010/step_10.jpg"},{"step":11,"desc":"加入适量蚝油，生抽，盐。","img":"images/661010/step_11.jpg"},{"step":12,"desc":"翻炒均匀入味。","img":"images/661010/step_12.jpg"},{"step":13,"desc":"放入海参。","img":"images/661010/step_13.jpg"},{"step":14,"desc":"继续翻炒均匀。","img":"images/661010/step_14.jpg"},{"step":15,"desc":"加入适量清水。","img":"images/661010/step_15.jpg"},{"step":16,"desc":"大火煮开转入砂锅焖20分钟左右即可。","img":"images/661010/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/661010/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/661010/step_18.jpg"},{"step":19,"desc":"成品。","img":"images/661010/step_19.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：砂锅、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}