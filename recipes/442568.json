{"id":"442568","name":"金针菇西红柿汤","author":"寻梦一ZbDu","authorId":"10886247","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/442568/cover.jpg","ingredients":{"main":[{"name":"金针菇","amount":"半捆"},{"name":"西红柿","amount":"2个"},{"name":"鸡蛋","amount":"1个"},{"name":"葱","amount":"1段"}],"sub":[{"name":"油","amount":"少许"},{"name":"盐","amount":"少许"},{"name":"五香粉","amount":"少许"},{"name":"白糖","amount":"1点点"}]},"steps":[{"step":1,"desc":"金针菇半捆，西红柿两个，鸡蛋一个，大葱一段。","img":"images/442568/step_1.jpg"},{"step":2,"desc":"金针菇去根，切两刀。","img":"images/442568/step_2.jpg"},{"step":3,"desc":"清水加点盐泡一下金针菇。","img":"images/442568/step_3.jpg"},{"step":4,"desc":"西红柿去皮切碎放一点点白糖，鸡蛋打散，切点葱花。","img":"images/442568/step_4.jpg"},{"step":5,"desc":"平底锅加热加点油炒香葱花。","img":"images/442568/step_5.jpg"},{"step":6,"desc":"加西红柿炒出水来。","img":"images/442568/step_6.jpg"},{"step":7,"desc":"加金针菇翻炒。","img":"images/442568/step_7.jpg"},{"step":8,"desc":"炝上汤水烧开。","img":"images/442568/step_8.jpg"},{"step":9,"desc":"加点五香粉和盐。","img":"images/442568/step_9.jpg"},{"step":10,"desc":"打入蛋花。","img":"images/442568/step_10.jpg"},{"step":11,"desc":"撒上葱花。","img":"images/442568/step_11.jpg"},{"step":12,"desc":"汤就做好了。","img":"images/442568/step_12.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：平底锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}