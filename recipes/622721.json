{"id":"622721","name":"麻辣鸡丝","author":"还在吃吃吃","authorId":"10106890","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/622721/cover.jpg","ingredients":{"main":[{"name":"鸡胸肉","amount":"1块"},{"name":"料酒","amount":"1勺"},{"name":"葱结","amount":"1个"}],"sub":[{"name":"食盐","amount":"半勺"},{"name":"生抽","amount":"1勺"},{"name":"十三香","amount":"半勺"},{"name":"白砂糖","amount":"半勺"},{"name":"玉米淀粉","amount":"1勺"}]},"steps":[{"step":1,"desc":"鸡胸肉对半切开。","img":"images/622721/step_1.jpg"},{"step":2,"desc":"锅中放入鸡胸肉，加料酒和葱结焯水。","img":"images/622721/step_2.jpg"},{"step":3,"desc":"煮熟的鸡胸肉手撕成筷子一般粗细的鸡丝。","img":"images/622721/step_3.jpg"},{"step":4,"desc":"加入生抽。","img":"images/622721/step_4.jpg"},{"step":5,"desc":"加入食盐。","img":"images/622721/step_5.jpg"},{"step":6,"desc":"加入十三香。","img":"images/622721/step_6.jpg"},{"step":7,"desc":"加入白砂糖。","img":"images/622721/step_7.jpg"},{"step":8,"desc":"加入淀粉。","img":"images/622721/step_8.jpg"},{"step":9,"desc":"起锅烧油。","img":"images/622721/step_9.jpg"},{"step":10,"desc":"下入抓拌均匀的鸡丝煎至两面金黄。","img":"images/622721/step_10.jpg"},{"step":11,"desc":"加入花椒粒。","img":"images/622721/step_11.jpg"},{"step":12,"desc":"下入辣椒丝和蒜片。","img":"images/622721/step_12.jpg"},{"step":13,"desc":"加入食盐。","img":"images/622721/step_13.jpg"},{"step":14,"desc":"加入白砂糖。","img":"images/622721/step_14.jpg"},{"step":15,"desc":"加入白熟芝麻。","img":"images/622721/step_15.jpg"},{"step":16,"desc":"翻炒均匀。","img":"images/622721/step_16.jpg"},{"step":17,"desc":"盛盘后撒上葱花即可上桌。","img":"images/622721/step_17.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：平底锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}