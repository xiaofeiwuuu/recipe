{"id":"662563","name":"番茄肥牛芝士焗饭","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/662563/cover.jpg","ingredients":{"main":[{"name":"番茄","amount":"适量"},{"name":"肥牛","amount":"适量"},{"name":"米饭","amount":"适量"}],"sub":[{"name":"马苏里拉芝士碎","amount":"适量"},{"name":"芝士片","amount":"适量"},{"name":"拌饭海苔","amount":"适量"}]},"steps":[{"step":1,"desc":"芝士碎提前解冻备用。","img":"images/662563/step_1.jpg"},{"step":2,"desc":"芝士片备用。","img":"images/662563/step_2.jpg"},{"step":3,"desc":"米饭备用。","img":"images/662563/step_3.jpg"},{"step":4,"desc":"番茄洗净去皮切块。","img":"images/662563/step_4.jpg"},{"step":5,"desc":"肥牛解冻备用。","img":"images/662563/step_5.jpg"},{"step":6,"desc":"砂锅加热倒入花生油。","img":"images/662563/step_6.jpg"},{"step":7,"desc":"放入番茄翻炒。","img":"images/662563/step_7.jpg"},{"step":8,"desc":"炒出茄汁。","img":"images/662563/step_8.jpg"},{"step":9,"desc":"加入适量清水，煮开煲10分钟左右。","img":"images/662563/step_9.jpg"},{"step":10,"desc":"放入肥牛卷，煮至变色。","img":"images/662563/step_10.jpg"},{"step":11,"desc":"把米饭放入砂锅中。","img":"images/662563/step_11.jpg"},{"step":12,"desc":"放入芝士碎。","img":"images/662563/step_12.jpg"},{"step":13,"desc":"把芝士片也放在米饭上。","img":"images/662563/step_13.jpg"},{"step":14,"desc":"盖上中小火焗1至2分钟左右。","img":"images/662563/step_14.jpg"},{"step":15,"desc":"关火开盖后加入拌饭海苔碎即可。","img":"images/662563/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/662563/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/662563/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/662563/step_18.jpg"},{"step":19,"desc":"喜欢焦香的可以用烤箱烤。","img":"images/662563/step_19.jpg"},{"step":20,"desc":"成品。","img":"images/662563/step_20.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：砂锅、煮锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}