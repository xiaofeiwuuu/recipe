{"id":"650790","name":"鲜虾藜麦花环饭团","author":"不做妖精好多年","authorId":"1806550","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/650790/cover.jpg","ingredients":{"main":[{"name":"白虾","amount":"4只"},{"name":"藜麦","amount":"3把"},{"name":"清水","amount":"适量"}],"sub":[{"name":"皱皮椒","amount":"一块"},{"name":"菜芯","amount":"一根"},{"name":"洋葱","amount":"些许"},{"name":"黄色小番茄","amount":"几个"}]},"steps":[{"step":1,"desc":"藜麦洗净。","img":"images/650790/step_1.jpg"},{"step":2,"desc":"放电饭煲里，加约高处食材8毫米的水。","img":"images/650790/step_2.jpg"},{"step":3,"desc":"白虾去虾头洗净。","img":"images/650790/step_3.jpg"},{"step":4,"desc":"放小煮锅里。","img":"images/650790/step_4.jpg"},{"step":5,"desc":"煮熟，捞出。","img":"images/650790/step_5.jpg"},{"step":6,"desc":"取一块皱皮椒洗净。","img":"images/650790/step_6.jpg"},{"step":7,"desc":"烫一根菜心。","img":"images/650790/step_7.jpg"},{"step":8,"desc":"取紫色洋葱，所有蔬菜切丁。","img":"images/650790/step_8.jpg"},{"step":9,"desc":"煮熟的藜麦。","img":"images/650790/step_9.jpg"},{"step":10,"desc":"取一些。","img":"images/650790/step_10.jpg"},{"step":11,"desc":"虾去壳切丁，所有食材放藜麦饭里。","img":"images/650790/step_11.jpg"},{"step":12,"desc":"小番茄洗净。","img":"images/650790/step_12.jpg"},{"step":13,"desc":"番茄对切放食材里，加食盐。","img":"images/650790/step_13.jpg"},{"step":14,"desc":"拌匀。","img":"images/650790/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/650790/step_15.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：煮锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}