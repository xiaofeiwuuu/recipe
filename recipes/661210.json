{"id":"661210","name":"芋仔牛肉","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/661210/cover.jpg","ingredients":{"main":[{"name":"牛肉","amount":"适量"},{"name":"芋仔","amount":"适量"}],"sub":[{"name":"蒜末","amount":"适量"},{"name":"小米辣","amount":"适量"},{"name":"葱花","amount":"适量"}]},"steps":[{"step":1,"desc":"芋仔清洗干净备用。","img":"images/661210/step_1.jpg"},{"step":2,"desc":"将芋仔上锅蒸熟。","img":"images/661210/step_2.jpg"},{"step":3,"desc":"牛肉洗净切薄片。","img":"images/661210/step_3.jpg"},{"step":4,"desc":"加入适量玉米淀粉，生抽，老抽，蚝油。","img":"images/661210/step_4.jpg"},{"step":5,"desc":"抓拌均匀后加入适量花生油抓匀。","img":"images/661210/step_5.jpg"},{"step":6,"desc":"蒜头剁碎，小米辣切细备用。","img":"images/661210/step_6.jpg"},{"step":7,"desc":"蒸好的芋仔去皮切块。","img":"images/661210/step_7.jpg"},{"step":8,"desc":"锅中热油倒入牛肉。","img":"images/661210/step_8.jpg"},{"step":9,"desc":"炒至七八成熟后盛出。","img":"images/661210/step_9.jpg"},{"step":10,"desc":"锅中热油放入蒜末和小米辣。","img":"images/661210/step_10.jpg"},{"step":11,"desc":"放入芋仔翻炒。","img":"images/661210/step_11.jpg"},{"step":12,"desc":"加入适量蚝油，生抽，盐。","img":"images/661210/step_12.jpg"},{"step":13,"desc":"加入适量清水。","img":"images/661210/step_13.jpg"},{"step":14,"desc":"大火煮开。","img":"images/661210/step_14.jpg"},{"step":15,"desc":"放入炒过的牛肉。","img":"images/661210/step_15.jpg"},{"step":16,"desc":"焖煮几分钟入味即可出锅。","img":"images/661210/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/661210/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/661210/step_18.jpg"},{"step":19,"desc":"成品。","img":"images/661210/step_19.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}