{"id":"666056","name":"潮汕菜头粿","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/666056/cover.jpg","ingredients":{"main":[{"name":"白萝卜","amount":"3斤"},{"name":"干贝","amount":"适量"},{"name":"虾米","amount":"适量"},{"name":"香菇","amount":"适量"},{"name":"葱花","amount":"适量"}],"sub":[{"name":"番薯粉","amount":"360克"}]},"steps":[{"step":1,"desc":"香菇提前泡发后切小块。","img":"images/666056/step_1.jpg"},{"step":2,"desc":"干贝泡发后用刀背碾碎。","img":"images/666056/step_2.jpg"},{"step":3,"desc":"虾米清水泡发洗净备用。","img":"images/666056/step_3.jpg"},{"step":4,"desc":"白萝卜去皮洗净。","img":"images/666056/step_4.jpg"},{"step":5,"desc":"白萝卜擦丝后加入适量盐杀出水份。","img":"images/666056/step_5.jpg"},{"step":6,"desc":"杀过水的白萝卜挤干水份。","img":"images/666056/step_6.jpg"},{"step":7,"desc":"放入干贝。","img":"images/666056/step_7.jpg"},{"step":8,"desc":"放入虾米。","img":"images/666056/step_8.jpg"},{"step":9,"desc":"放入香菇。","img":"images/666056/step_9.jpg"},{"step":10,"desc":"加入番薯粉。","img":"images/666056/step_10.jpg"},{"step":11,"desc":"加入适量五香粉。","img":"images/666056/step_11.jpg"},{"step":12,"desc":"加入适量葱花或者小西芹。","img":"images/666056/step_12.jpg"},{"step":13,"desc":"揉抓均匀。","img":"images/666056/step_13.jpg"},{"step":14,"desc":"将萝卜粿放入模具中按压成型。","img":"images/666056/step_14.jpg"},{"step":15,"desc":"锅中水开入锅蒸20至30分钟左右。","img":"images/666056/step_15.jpg"},{"step":16,"desc":"出锅的菜头粿可以趁热吃，或者晾凉下锅煎香。","img":"images/666056/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/666056/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/666056/step_18.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：蒸锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}