{"id":"660747","name":"蛋饺粉丝丝瓜汤","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/660747/cover.jpg","ingredients":{"main":[{"name":"粉丝","amount":"适量"},{"name":"丝瓜","amount":"适量"}],"sub":[{"name":"鸡蛋","amount":"适量"},{"name":"肉沫","amount":"适量"},{"name":"葱花","amount":"适量"}]},"steps":[{"step":1,"desc":"梅花肉洗净切块。","img":"images/660747/step_1.jpg"},{"step":2,"desc":"肉放进绞肉机绞碎。","img":"images/660747/step_2.jpg"},{"step":3,"desc":"放入葱花。","img":"images/660747/step_3.jpg"},{"step":4,"desc":"加入适量蚝油，老抽，花生油拌匀备用。","img":"images/660747/step_4.jpg"},{"step":5,"desc":"鸡蛋打入碗中搅拌均匀。","img":"images/660747/step_5.jpg"},{"step":6,"desc":"锅中热油舀入蛋液。","img":"images/660747/step_6.jpg"},{"step":7,"desc":"酿入肉馅。","img":"images/660747/step_7.jpg"},{"step":8,"desc":"将鸡蛋对半折叠煎成饺子形状。","img":"images/660747/step_8.jpg"},{"step":9,"desc":"粉丝提前泡软。","img":"images/660747/step_9.jpg"},{"step":10,"desc":"丝瓜去皮洗净切滚刀块。","img":"images/660747/step_10.jpg"},{"step":11,"desc":"锅中热油放入丝瓜翻炒。","img":"images/660747/step_11.jpg"},{"step":12,"desc":"加入清水。","img":"images/660747/step_12.jpg"},{"step":13,"desc":"放入蛋饺，大火煮开。","img":"images/660747/step_13.jpg"},{"step":14,"desc":"煮至汤色变白。","img":"images/660747/step_14.jpg"},{"step":15,"desc":"放入粉丝，少许盐调味煮开即可。","img":"images/660747/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/660747/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/660747/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/660747/step_18.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}