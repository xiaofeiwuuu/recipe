{"id":"659178","name":"鲜肉蛋黄粽子","author":"诗韵墨香","authorId":"10606182","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/659178/cover.jpg","ingredients":{"main":[{"name":"糯米","amount":"适量"},{"name":"猪肉","amount":"适量"},{"name":"咸蛋黄","amount":"适量"}],"sub":[{"name":"花生","amount":"适量"},{"name":"红豆","amount":"适量"},{"name":"鲜粽叶","amount":"适量"}]},"steps":[{"step":1,"desc":"成品图。","img":"images/659178/step_1.jpg"},{"step":2,"desc":"适量糯米，浸泡24小时，备用。","img":"images/659178/step_2.jpg"},{"step":3,"desc":"猪肉适量，切大块，加入适量盐，老抽，搅拌均匀，腌制入味。","img":"images/659178/step_3.jpg"},{"step":4,"desc":"适量红豆和花生米，浸泡24小时，备用。","img":"images/659178/step_4.jpg"},{"step":5,"desc":"咸蛋黄适量，备用。","img":"images/659178/step_5.jpg"},{"step":6,"desc":"糯米控干水分，花生和红豆放入容器中，加入适量老抽调色，搅拌均匀。","img":"images/659178/step_6.jpg"},{"step":7,"desc":"粽叶提前开水烫烫，洗干净备用。两个粽叶重叠，中间对折成一个漏斗，放入适量米。","img":"images/659178/step_7.jpg"},{"step":8,"desc":"放入一块肉，蛋黄，再加入适量米，按压平整，包好。","img":"images/659178/step_8.jpg"},{"step":9,"desc":"全部做好，备用。","img":"images/659178/step_9.jpg"},{"step":10,"desc":"放入高压锅中，煮熟捞出。","img":"images/659178/step_10.jpg"},{"step":11,"desc":"放入冷水浸泡数小时，即可食用。","img":"images/659178/step_11.jpg"},{"step":12,"desc":"成品图。","img":"images/659178/step_12.jpg"},{"step":13,"desc":"成品图。","img":"images/659178/step_13.jpg"},{"step":14,"desc":"成品图。","img":"images/659178/step_14.jpg"},{"step":15,"desc":"成品图。","img":"images/659178/step_15.jpg"},{"step":16,"desc":"成品图。","img":"images/659178/step_16.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：电压力锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}