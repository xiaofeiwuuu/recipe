{"id":"453541","name":"银鱼酸菜粉丝汤","author":"hb俗人","authorId":"10224823","desc":"","cover":"images/453541/cover.jpg","ingredients":{"main":[{"name":"酸菜","amount":"一棵"},{"name":"银鱼","amount":"适量"},{"name":"葱","amount":"一棵"},{"name":"蒜","amount":"两瓣"},{"name":"粉丝","amount":"适量"}],"sub":[{"name":"生抽","amount":"两勺"},{"name":"植物油","amount":"适量"},{"name":"盐","amount":"适量"},{"name":"香油","amount":"适量"}]},"steps":[{"step":1,"desc":"蒜切片。","img":"images/453541/step_1.jpg"},{"step":2,"desc":"葱切圈。","img":"images/453541/step_2.jpg"},{"step":3,"desc":"酸菜切丝。","img":"images/453541/step_3.jpg"},{"step":4,"desc":"银鱼过一遍清水。","img":"images/453541/step_4.jpg"},{"step":5,"desc":"锅中放入适量植物油，爆香蒜片。","img":"images/453541/step_5.jpg"},{"step":6,"desc":"放入酸菜，翻炒。","img":"images/453541/step_6.jpg"},{"step":7,"desc":"加入两勺生抽。","img":"images/453541/step_7.jpg"},{"step":8,"desc":"翻炒四五分钟，使酸菜熟烂。","img":"images/453541/step_8.jpg"},{"step":9,"desc":"加入适量清水。","img":"images/453541/step_9.jpg"},{"step":10,"desc":"粉丝洗净，放入锅中，大火烧开。","img":"images/453541/step_10.jpg"},{"step":11,"desc":"烧开后，放入银鱼。","img":"images/453541/step_11.jpg"},{"step":12,"desc":"加入适量盐，烧开，使银鱼由透明变成白色。","img":"images/453541/step_12.jpg"},{"step":13,"desc":"撒上葱花，加入适量香油关火。","img":"images/453541/step_13.jpg"},{"step":14,"desc":"成品图，酸鲜爽口。","img":"images/453541/step_14.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}