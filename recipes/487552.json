{"id":"487552","name":"茭白木耳鸡汤","author":"木紫冰","authorId":"11508024","desc":"","cover":"images/487552/cover.jpg","ingredients":{"main":[{"name":"茭白","amount":"3根"},{"name":"小母鸡","amount":"半只"},{"name":"干木耳","amount":"5g"}],"sub":[{"name":"盐","amount":"6g"},{"name":"料酒","amount":"20g"},{"name":"姜","amount":"5g"},{"name":"水","amount":"1500g"}]},"steps":[{"step":1,"desc":"干木耳，用温水泡发","img":"images/487552/step_1.jpg"},{"step":2,"desc":"泡发的木耳，摘去老根，洗干净备用","img":"images/487552/step_2.jpg"},{"step":3,"desc":"母鸡洗干净，剁块","img":"images/487552/step_3.jpg"},{"step":4,"desc":"锅中加水，放入姜，料酒","img":"images/487552/step_4.jpg"},{"step":5,"desc":"把鸡块，放入锅中，大火烧煮","img":"images/487552/step_5.jpg"},{"step":6,"desc":"煮开后，撇去浮沫","img":"images/487552/step_6.jpg"},{"step":7,"desc":"关小火，煲40分钟","img":"images/487552/step_7.jpg"},{"step":8,"desc":"煲鸡时间到，把茭白去皮，洗干净切块","img":"images/487552/step_8.jpg"},{"step":9,"desc":"把茭白，放入鸡汤中","img":"images/487552/step_9.jpg"},{"step":10,"desc":"把木耳，也放进去","img":"images/487552/step_10.jpg"},{"step":11,"desc":"加入盐","img":"images/487552/step_11.jpg"},{"step":12,"desc":"用勺子，搅拌均匀，大火烧煮","img":"images/487552/step_12.jpg"},{"step":13,"desc":"煮开后，关小火再煲8分钟","img":"images/487552/step_13.jpg"},{"step":14,"desc":"时间到，盛入碗中，即可上桌。","img":"images/487552/step_14.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：煮锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}