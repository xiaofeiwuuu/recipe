{"id":"663524","name":"春笋焖饭","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/663524/cover.jpg","ingredients":{"main":[{"name":"春笋","amount":"适量"},{"name":"五花肉","amount":"适量"},{"name":"腊肠","amount":"适量"},{"name":"香菇","amount":"适量"}],"sub":[{"name":"葱花","amount":"适量"}]},"steps":[{"step":1,"desc":"香菇提前泡发后切小块。","img":"images/663524/step_1.jpg"},{"step":2,"desc":"五花肉去皮洗净切薄片。","img":"images/663524/step_2.jpg"},{"step":3,"desc":"腊肠改刀切片备用。","img":"images/663524/step_3.jpg"},{"step":4,"desc":"春笋清理好后改刀切小块。","img":"images/663524/step_4.jpg"},{"step":5,"desc":"春笋冷水下锅焯烫后备用。","img":"images/663524/step_5.jpg"},{"step":6,"desc":"热锅放入五花肉煸炒。","img":"images/663524/step_6.jpg"},{"step":7,"desc":"炒出油脂后盛出多的油。","img":"images/663524/step_7.jpg"},{"step":8,"desc":"放入香菇翻炒炒香。","img":"images/663524/step_8.jpg"},{"step":9,"desc":"放入春笋大火翻炒。","img":"images/663524/step_9.jpg"},{"step":10,"desc":"少许盐，蚝油，生抽调味翻炒。","img":"images/663524/step_10.jpg"},{"step":11,"desc":"放入腊肠炒匀即可。","img":"images/663524/step_11.jpg"},{"step":12,"desc":"大米淘洗干净。","img":"images/663524/step_12.jpg"},{"step":13,"desc":"盛入炒过的配菜。","img":"images/663524/step_13.jpg"},{"step":14,"desc":"加入平时煮饭的水量，把大米和配菜拌匀。","img":"images/663524/step_14.jpg"},{"step":15,"desc":"电饭锅煮饭模式结束即可。","img":"images/663524/step_15.jpg"},{"step":16,"desc":"出锅前翻拌均匀即可。","img":"images/663524/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/663524/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/663524/step_18.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：电饭煲、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}