{"id":"423946","name":"鲍鱼炖水蛋","author":"不做妖精好多年","authorId":"1806550","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/423946/cover.jpg","ingredients":{"main":[{"name":"鸡蛋","amount":"1个"},{"name":"鲍鱼","amount":"1个"},{"name":"清水","amount":"鸡蛋等体积的水"}],"sub":[{"name":"葱末","amount":"小许"},{"name":"红椒末","amount":"小许"},{"name":"亚麻籽油","amount":"小许"},{"name":"蒸鱼豉油","amount":"3克"}]},"steps":[{"step":1,"desc":"鲍鱼、鸡蛋洗净，鲍鱼打花刀。","img":"images/423946/step_1.jpg"},{"step":2,"desc":"鸡蛋打碗里，打散。","img":"images/423946/step_2.jpg"},{"step":3,"desc":"加清水，打散。","img":"images/423946/step_3.jpg"},{"step":4,"desc":"放过滤网。","img":"images/423946/step_4.jpg"},{"step":5,"desc":"过滤蛋液。","img":"images/423946/step_5.jpg"},{"step":6,"desc":"盖上保鲜膜。","img":"images/423946/step_6.jpg"},{"step":7,"desc":"用牙签扎孔。","img":"images/423946/step_7.jpg"},{"step":8,"desc":"放微波炉。","img":"images/423946/step_8.jpg"},{"step":9,"desc":"高火1分20秒。","img":"images/423946/step_9.jpg"},{"step":10,"desc":"鲍鱼冷水下锅，放食盐。","img":"images/423946/step_10.jpg"},{"step":11,"desc":"盖盖子，中火煮。","img":"images/423946/step_11.jpg"},{"step":12,"desc":"开锅即可。","img":"images/423946/step_12.jpg"},{"step":13,"desc":"微波炉取出水蛋。","img":"images/423946/step_13.jpg"},{"step":14,"desc":"放入鲍鱼。","img":"images/423946/step_14.jpg"},{"step":15,"desc":"再次放微波炉里。","img":"images/423946/step_15.jpg"},{"step":16,"desc":"高火20秒。","img":"images/423946/step_16.jpg"},{"step":17,"desc":"取出水蛋。","img":"images/423946/step_17.jpg"},{"step":18,"desc":"放上葱末红椒末。","img":"images/423946/step_18.jpg"},{"step":19,"desc":"取亚麻籽油。","img":"images/423946/step_19.jpg"},{"step":20,"desc":"放亚麻籽油。","img":"images/423946/step_20.jpg"},{"step":21,"desc":"取蒸鱼豉油。","img":"images/423946/step_21.jpg"},{"step":22,"desc":"淋上蒸鱼豉油即可。","img":"images/423946/step_22.jpg"},{"step":23,"desc":"成品。","img":"images/423946/step_23.jpg"},{"step":24,"desc":"成品。","img":"images/423946/step_24.jpg"},{"step":25,"desc":"成品。","img":"images/423946/step_25.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：微波炉、煮锅\n\t\t\