{"id":"631830","name":"豆角素馅水饺","author":"还在吃吃吃","authorId":"10106890","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/631830/cover.jpg","ingredients":{"main":[{"name":"江豆","amount":"100克"},{"name":"红萝卜","amount":"半根"},{"name":"鸡蛋","amount":"2枚"},{"name":"泡发木耳","amount":"50克"}],"sub":[{"name":"食用油","amount":"20ml"},{"name":"葱姜末","amount":"适量"},{"name":"花椒面","amount":"半勺"},{"name":"鸡精","amount":"半勺"},{"name":"蚝油","amount":"1勺"}]},"steps":[{"step":1,"desc":"江豆洗净后下锅烧水焯烫。","img":"images/631830/step_1.jpg"},{"step":2,"desc":"切成碎丁装入大碗。","img":"images/631830/step_2.jpg"},{"step":3,"desc":"胡萝卜洗净后切丁。","img":"images/631830/step_3.jpg"},{"step":4,"desc":"起锅烧油倒入蛋液炒成鸡蛋碎。","img":"images/631830/step_4.jpg"},{"step":5,"desc":"胡萝卜也下锅翻炒一下营养倍增。","img":"images/631830/step_5.jpg"},{"step":6,"desc":"碗中分别放入四样食材。","img":"images/631830/step_6.jpg"},{"step":7,"desc":"加入葱姜炒香的虾皮。","img":"images/631830/step_7.jpg"},{"step":8,"desc":"加入食盐。","img":"images/631830/step_8.jpg"},{"step":9,"desc":"加入十三香。","img":"images/631830/step_9.jpg"},{"step":10,"desc":"加入鸡精。","img":"images/631830/step_10.jpg"},{"step":11,"desc":"加入老抽上色。","img":"images/631830/step_11.jpg"},{"step":12,"desc":"加入香油增香并搅拌均匀。","img":"images/631830/step_12.jpg"},{"step":13,"desc":"提前揉好的面团已经醒发好。","img":"images/631830/step_13.jpg"},{"step":14,"desc":"将面团分成两半搓长条下面剂。","img":"images/631830/step_14.jpg"},{"step":15,"desc":"擀皮包上馅料。","img":"images/631830/step_15.jpg"},{"step":16,"desc":"包成自己熟悉的饺子形状。","img":"images/631830/step_16.jpg"},{"step":17,"desc":"锅中水烧开后下入饺子两开后捞出。","img":"images/631830/step_17.jpg"},{"step":18,"desc":"成品图。","img":"images/631830/step_18.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：平底锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}