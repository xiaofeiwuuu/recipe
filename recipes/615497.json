{"id":"615497","name":"韭菜素馅水饺","author":"还在吃吃吃","authorId":"10106890","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/615497/cover.jpg","ingredients":{"main":[{"name":"面粉","amount":"300克"},{"name":"韭菜","amount":"200克"},{"name":"鸡蛋","amount":"3枚"},{"name":"红薯粉条碎","amount":"100克"}],"sub":[{"name":"食用油","amount":"5勺"},{"name":"食盐","amount":"半勺"},{"name":"生抽","amount":"2勺"},{"name":"老抽","amount":"1勺"},{"name":"耗油","amount":"1勺"},{"name":"十三香","amount":"半勺"},{"name":"胡椒粉","amount":"半勺"},{"name":"鸡精","amount":"半勺"},{"name":"大葱","amount":"1颗"},{"name":"姜片","amount":"3片"}]},"steps":[{"step":1,"desc":"面粉加盐加水合成表面光滑的面团，醒发半小时。","img":"images/615497/step_1.jpg"},{"step":2,"desc":"韭菜洗净后切段。","img":"images/615497/step_2.jpg"},{"step":3,"desc":"个鸡蛋打入碗中搅散。","img":"images/615497/step_3.jpg"},{"step":4,"desc":"起锅烧油炒成鸡蛋碎。","img":"images/615497/step_4.jpg"},{"step":5,"desc":"大葱切葱花，姜片切末。","img":"images/615497/step_5.jpg"},{"step":6,"desc":"另起锅烧油。","img":"images/615497/step_6.jpg"},{"step":7,"desc":"下入葱花姜末炒香，再下入粉条碎翻炒均匀。","img":"images/615497/step_7.jpg"},{"step":8,"desc":"加入食盐。","img":"images/615497/step_8.jpg"},{"step":9,"desc":"加入十三香。","img":"images/615497/step_9.jpg"},{"step":10,"desc":"加入胡椒粉。","img":"images/615497/step_10.jpg"},{"step":11,"desc":"加入鸡精。","img":"images/615497/step_11.jpg"},{"step":12,"desc":"加入生抽。","img":"images/615497/step_12.jpg"},{"step":13,"desc":"加入老抽。","img":"images/615497/step_13.jpg"},{"step":14,"desc":"加入耗油。","img":"images/615497/step_14.jpg"},{"step":15,"desc":"用锅铲翻炒均匀。","img":"images/615497/step_15.jpg"},{"step":16,"desc":"将炒好的粉条碎倒入盛有鸡蛋碎的碗中。","img":"images/615497/step_16.jpg"},{"step":17,"desc":"加入韭菜段。","img":"images/615497/step_17.jpg"},{"step":18,"desc":"打入2枚鸡蛋（起到粘合馅料，提香增鲜的作用）。","img":"images/615497/step_18.jpg"},{"step":19,"desc":"搅拌均匀。","img":"images/615497/step_19.jpg"},{"step":20,"desc":"面团搓成条，下成大小相等的机子。","img":"images/615497/step_20.jpg"},{"step":21,"desc":"擀皮包上馅料。","img":"images/615497/step_21.jpg"},{"step":22,"desc":"用自己熟悉的方式包成饺子。","img":"images/615497/step_22.jpg"},{"step":23,"desc":"水烧开后下入娇子，浇入凉水2次。","img":"images/615497/step_23.jpg"},{"step":24,"desc":"成品图。","img":"images/615497/step_24.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：平底锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}