{"id":"660999","name":"爆炒毛肚","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/660999/cover.jpg","ingredients":{"main":[{"name":"毛肚","amount":"适量"},{"name":"芹菜","amount":"适量"}],"sub":[{"name":"小米辣","amount":"适量"},{"name":"蒜头","amount":"适量"},{"name":"生姜","amount":"适量"},{"name":"八角","amount":"适量"},{"name":"桂皮","amount":"适量"},{"name":"香叶","amount":"适量"}]},"steps":[{"step":1,"desc":"毛肚用面粉揉搓洗净。","img":"images/660999/step_1.jpg"},{"step":2,"desc":"将毛肚冷水下锅焯烫后再次洗净。","img":"images/660999/step_2.jpg"},{"step":3,"desc":"毛肚放入高压锅中，放入姜片，八角，桂皮，香叶。","img":"images/660999/step_3.jpg"},{"step":4,"desc":"加入蚝油，生抽，老抽，盐。","img":"images/660999/step_4.jpg"},{"step":5,"desc":"加入适量清水。","img":"images/660999/step_5.jpg"},{"step":6,"desc":"高压锅煮开后中小火压20分钟左右。","img":"images/660999/step_6.jpg"},{"step":7,"desc":"晾凉的毛肚改刀切小块。","img":"images/660999/step_7.jpg"},{"step":8,"desc":"芹菜洗净切段备用。","img":"images/660999/step_8.jpg"},{"step":9,"desc":"蒜头小米辣备用。","img":"images/660999/step_9.jpg"},{"step":10,"desc":"锅中热油放入蒜粒炒至微焦。","img":"images/660999/step_10.jpg"},{"step":11,"desc":"放入小米辣翻炒。","img":"images/660999/step_11.jpg"},{"step":12,"desc":"放入毛肚和一勺干锅酱。","img":"images/660999/step_12.jpg"},{"step":13,"desc":"大火快速翻炒均匀。","img":"images/660999/step_13.jpg"},{"step":14,"desc":"翻炒均匀入味后即可出锅。","img":"images/660999/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/660999/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/660999/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/660999/step_17.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}