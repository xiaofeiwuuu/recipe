{"id":"440762","name":"蛋花三鲜羹","author":"花鱼儿","authorId":"404188","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/440762/cover.jpg","ingredients":{"main":[{"name":"鸡蛋","amount":"1只"},{"name":"黑木耳","amount":"5克"},{"name":"新鲜香菇","amount":"2个"},{"name":"肉末","amount":"50克"}],"sub":[{"name":"水淀粉","amount":"适量"},{"name":"料酒","amount":"适量"},{"name":"盐","amount":"适量"},{"name":"鸡精","amount":"适量"},{"name":"香葱","amount":"适量"}]},"steps":[{"step":1,"desc":"食材：鸡蛋（已打成蛋液）。","img":"images/440762/step_1.jpg"},{"step":2,"desc":"黑木耳（已泡发）。","img":"images/440762/step_2.jpg"},{"step":3,"desc":"新鲜香菇（已清洗）、肉末。","img":"images/440762/step_3.jpg"},{"step":4,"desc":"香葱。","img":"images/440762/step_4.jpg"},{"step":5,"desc":"水淀粉。","img":"images/440762/step_5.jpg"},{"step":6,"desc":"将已泡发的黑木耳清洗一下、捞出。","img":"images/440762/step_6.jpg"},{"step":7,"desc":"放在案板上切碎，待用。","img":"images/440762/step_7.jpg"},{"step":8,"desc":"将已清洗的新鲜香菇放在案板上切碎，待用。","img":"images/440762/step_8.jpg"},{"step":9,"desc":"烧锅倒油烧热，下入肉末，加点料酒翻炒翻炒。","img":"images/440762/step_9.jpg"},{"step":10,"desc":"随后，合入切碎的黑木耳和香菇翻炒一下。","img":"images/440762/step_10.jpg"},{"step":11,"desc":"接着，倒入一些清水煮开，加入水淀粉勾芡。","img":"images/440762/step_11.jpg"},{"step":12,"desc":"然后，倒入蛋液，加点盐、鸡精调味。","img":"images/440762/step_12.jpg"},{"step":13,"desc":"最后，搁入香葱翻匀，即成。","img":"images/440762/step_13.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}