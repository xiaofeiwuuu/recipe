{"id":"663430","name":"猪脚焖鸡爪","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/663430/cover.jpg","ingredients":{"main":[{"name":"猪脚","amount":"适量"},{"name":"鸡爪","amount":"适量"}],"sub":[{"name":"生姜","amount":"适量"},{"name":"蒜头","amount":"适量"},{"name":"八角","amount":"适量"},{"name":"桂皮","amount":"适量"},{"name":"香叶","amount":"适量"},{"name":"剁椒","amount":"适量"}]},"steps":[{"step":1,"desc":"姜片，八角，桂皮，香叶备用。","img":"images/663430/step_1.jpg"},{"step":2,"desc":"丝瓜洗净去甲。","img":"images/663430/step_2.jpg"},{"step":3,"desc":"将鸡爪和猪脚冷水下锅焯烫出血水后洗净。","img":"images/663430/step_3.jpg"},{"step":4,"desc":"锅中热油放入香料炒香。","img":"images/663430/step_4.jpg"},{"step":5,"desc":"放入鸡爪和猪脚。","img":"images/663430/step_5.jpg"},{"step":6,"desc":"翻炒均匀。","img":"images/663430/step_6.jpg"},{"step":7,"desc":"加入适量蚝油，生抽，老抽。","img":"images/663430/step_7.jpg"},{"step":8,"desc":"翻炒均匀上色入味。","img":"images/663430/step_8.jpg"},{"step":9,"desc":"炒过的鸡爪先盛出。","img":"images/663430/step_9.jpg"},{"step":10,"desc":"将猪脚转入高压锅中，加入适量清水。","img":"images/663430/step_10.jpg"},{"step":11,"desc":"盖上大火煮开上汽后二十分钟。","img":"images/663430/step_11.jpg"},{"step":12,"desc":"焖好的猪脚已经很软糯。","img":"images/663430/step_12.jpg"},{"step":13,"desc":"放入炒过的鸡爪。","img":"images/663430/step_13.jpg"},{"step":14,"desc":"拌开一下盖上继续高压锅大火压四五分钟。","img":"images/663430/step_14.jpg"},{"step":15,"desc":"焖好后的猪脚和鸡爪捞出备用。","img":"images/663430/step_15.jpg"},{"step":16,"desc":"蒜头拍扁剁碎备用。","img":"images/663430/step_16.jpg"},{"step":17,"desc":"锅中热油放入蒜末炒香。","img":"images/663430/step_17.jpg"},{"step":18,"desc":"放入剁椒。","img":"images/663430/step_18.jpg"},{"step":19,"desc":"翻炒均匀炒香。","img":"images/663430/step_19.jpg"},{"step":20,"desc":"放入猪脚和鸡爪。","img":"images/663430/step_20.jpg"},{"step":21,"desc":"翻炒均匀。","img":"images/663430/step_21.jpg"},{"step":22,"desc":"加入原汤。","img":"images/663430/step_22.jpg"},{"step":23,"desc":"大火煮开收斗入味即可。","img":"images/663430/step_23.jpg"},{"step":24,"desc":"成品。","img":"images/663430/step_24.jpg"},{"step":25,"desc":"成品。",