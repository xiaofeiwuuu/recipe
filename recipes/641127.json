{"id":"641127","name":"凉拌鸡腿肉","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/641127/cover.jpg","ingredients":{"main":[{"name":"鸡腿","amount":"2个"},{"name":"青瓜","amount":"1条"}],"sub":[{"name":"蒜末","amount":"适量"},{"name":"香菜","amount":"适量"}]},"steps":[{"step":1,"desc":"鸡腿洗净放入盘中。","img":"images/641127/step_1.jpg"},{"step":2,"desc":"加入适量姜片。","img":"images/641127/step_2.jpg"},{"step":3,"desc":"将鸡腿上锅蒸20分钟左右，蒸好后取出晾凉备用。","img":"images/641127/step_3.jpg"},{"step":4,"desc":"青瓜去少量皮轻拍几下，然后切块。","img":"images/641127/step_4.jpg"},{"step":5,"desc":"蒜头拍扁剁碎，香菜洗净切段备用。","img":"images/641127/step_5.jpg"},{"step":6,"desc":"碗中放入蒜末和辣椒面。","img":"images/641127/step_6.jpg"},{"step":7,"desc":"淋上热油激发出香味。","img":"images/641127/step_7.jpg"},{"step":8,"desc":"鸡腿肉撕下放入碗中。","img":"images/641127/step_8.jpg"},{"step":9,"desc":"放入青瓜。","img":"images/641127/step_9.jpg"},{"step":10,"desc":"放入香菜。","img":"images/641127/step_10.jpg"},{"step":11,"desc":"加入1勺生抽，适量陈醋和盐。","img":"images/641127/step_11.jpg"},{"step":12,"desc":"翻拌均匀放置入味即可。","img":"images/641127/step_12.jpg"},{"step":13,"desc":"成品。","img":"images/641127/step_13.jpg"},{"step":14,"desc":"成品。","img":"images/641127/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/641127/step_15.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：蒸锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}