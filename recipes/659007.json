{"id":"659007","name":"沙茶肥羊卷","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/659007/cover.jpg","ingredients":{"main":[{"name":"肥羊卷","amount":"适量"}],"sub":[{"name":"金针菇","amount":"适量"},{"name":"豆腐","amount":"适量"},{"name":"洋葱","amount":"适量"}]},"steps":[{"step":1,"desc":"洋葱洗净切细备用。","img":"images/659007/step_1.jpg"},{"step":2,"desc":"羊肉卷提前解冻备用。","img":"images/659007/step_2.jpg"},{"step":3,"desc":"豆腐改刀切块。","img":"images/659007/step_3.jpg"},{"step":4,"desc":"金针菇切去根部洗净。","img":"images/659007/step_4.jpg"},{"step":5,"desc":"碗中加入沙茶酱，生抽，蚝油，盐，鸡精。","img":"images/659007/step_5.jpg"},{"step":6,"desc":"加入适量清水搅拌均匀备用。","img":"images/659007/step_6.jpg"},{"step":7,"desc":"锅中热油放入豆腐。","img":"images/659007/step_7.jpg"},{"step":8,"desc":"煎至两面金黄盛出。","img":"images/659007/step_8.jpg"},{"step":9,"desc":"锅里热油把洋葱炒香。","img":"images/659007/step_9.jpg"},{"step":10,"desc":"放入煎好的豆腐。","img":"images/659007/step_10.jpg"},{"step":11,"desc":"放入金针菇。","img":"images/659007/step_11.jpg"},{"step":12,"desc":"放入肥羊卷。","img":"images/659007/step_12.jpg"},{"step":13,"desc":"淋上沙茶酱汁。","img":"images/659007/step_13.jpg"},{"step":14,"desc":"盖上煮开转小火。","img":"images/659007/step_14.jpg"},{"step":15,"desc":"羊肉卷焖断生入味，少许葱花即可出锅。","img":"images/659007/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/659007/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/659007/step_17.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：煮锅、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}