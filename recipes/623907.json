{"id":"623907","name":"凉拌白菜丝","author":"还在吃吃吃","authorId":"10106890","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/623907/cover.jpg","ingredients":{"main":[{"name":"白菜","amount":"半颗"},{"name":"红椒丝","amount":"适量"},{"name":"洋葱丝","amount":"适量"},{"name":"香菜","amount":"适量"}],"sub":[{"name":"食盐","amount":"适量"},{"name":"鸡精","amount":"半勺"},{"name":"生抽","amount":"1勺"},{"name":"香醋","amount":"1勺"},{"name":"辣椒油","amount":"适量"}]},"steps":[{"step":1,"desc":"白菜洗净干净后切丝。","img":"images/623907/step_1.jpg"},{"step":2,"desc":"将白菜丝装入盆中加入食盐抓拌均匀腌制20分钟。","img":"images/623907/step_2.jpg"},{"step":3,"desc":"准备红椒丝，洋葱丝。","img":"images/623907/step_3.jpg"},{"step":4,"desc":"盆中加入清水洗去盐分。","img":"images/623907/step_4.jpg"},{"step":5,"desc":"攥干水分后装盘。","img":"images/623907/step_5.jpg"},{"step":6,"desc":"加入蒜蓉。","img":"images/623907/step_6.jpg"},{"step":7,"desc":"加入食盐和鸡精。","img":"images/623907/step_7.jpg"},{"step":8,"desc":"加入红椒丝和洋葱丝。","img":"images/623907/step_8.jpg"},{"step":9,"desc":"加入生抽。","img":"images/623907/step_9.jpg"},{"step":10,"desc":"加入香醋。","img":"images/623907/step_10.jpg"},{"step":11,"desc":"加入辣椒油。","img":"images/623907/step_11.jpg"},{"step":12,"desc":"搅拌均匀后撒入香菜末。","img":"images/623907/step_12.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：其他\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}