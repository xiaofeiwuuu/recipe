{"id":"661460","name":"排骨贴饼","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/661460/cover.jpg","ingredients":{"main":[{"name":"排骨","amount":"适量"}],"sub":[{"name":"面粉","amount":"适量"},{"name":"清水","amount":"适量"},{"name":"盐","amount":"适量"},{"name":"葱花","amount":"适量"},{"name":"姜片","amount":"适量"}]},"steps":[{"step":1,"desc":"排骨冷水下锅焯烫出血水洗净。","img":"images/661460/step_1.jpg"},{"step":2,"desc":"锅中热油放入姜片翻炒。","img":"images/661460/step_2.jpg"},{"step":3,"desc":"放入排骨翻炒。","img":"images/661460/step_3.jpg"},{"step":4,"desc":"加入适量蚝油，生抽，老抽，盐。","img":"images/661460/step_4.jpg"},{"step":5,"desc":"炒过的排骨转入珐琅锅。","img":"images/661460/step_5.jpg"},{"step":6,"desc":"加入适量清水。","img":"images/661460/step_6.jpg"},{"step":7,"desc":"大火煮开后转小火焖40分钟左右。","img":"images/661460/step_7.jpg"},{"step":8,"desc":"适量面粉备用。","img":"images/661460/step_8.jpg"},{"step":9,"desc":"多次少量加入清水，搅拌成面絮。","img":"images/661460/step_9.jpg"},{"step":10,"desc":"揉成面团盖上醒发备用。","img":"images/661460/step_10.jpg"},{"step":11,"desc":"醒发好的面团揪成小面剂放入水中，静置20分钟左右以上。","img":"images/661460/step_11.jpg"},{"step":12,"desc":"开盖检查排骨是否焖软烂。","img":"images/661460/step_12.jpg"},{"step":13,"desc":"将小面剂按压在掌心后前后推开推薄。","img":"images/661460/step_13.jpg"},{"step":14,"desc":"放入锅中，盖上焖至贴饼断生。","img":"images/661460/step_14.jpg"},{"step":15,"desc":"出锅前加入葱花即可。","img":"images/661460/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/661460/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/661460/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/661460/step_18.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：煮锅、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}