{"id":"664313","name":"凉拌茄子","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/664313/cover.jpg","ingredients":{"main":[{"name":"茄子","amount":"适量"}],"sub":[{"name":"小米辣","amount":"适量"},{"name":"香葱","amount":"适量"},{"name":"蒜蓉酱","amount":"适量"}]},"steps":[{"step":1,"desc":"提前炒过的蒜蓉酱备用。","img":"images/664313/step_1.jpg"},{"step":2,"desc":"香葱和小米辣洗净切细。","img":"images/664313/step_2.jpg"},{"step":3,"desc":"碗中放入蒜蓉酱。","img":"images/664313/step_3.jpg"},{"step":4,"desc":"放入小米辣。","img":"images/664313/step_4.jpg"},{"step":5,"desc":"加入适量盐。","img":"images/664313/step_5.jpg"},{"step":6,"desc":"再加入适量生抽。","img":"images/664313/step_6.jpg"},{"step":7,"desc":"舀入适量油泼辣子。","img":"images/664313/step_7.jpg"},{"step":8,"desc":"加入适量陈醋，搅拌均匀入味备用。","img":"images/664313/step_8.jpg"},{"step":9,"desc":"将茄子洗净。","img":"images/664313/step_9.jpg"},{"step":10,"desc":"茄子对半切开。","img":"images/664313/step_10.jpg"},{"step":11,"desc":"将茄子放入盘中。","img":"images/664313/step_11.jpg"},{"step":12,"desc":"锅中水开大火蒸10分钟左右。","img":"images/664313/step_12.jpg"},{"step":13,"desc":"蒸好的茄子取出晾凉。","img":"images/664313/step_13.jpg"},{"step":14,"desc":"把茄子撕小条放入盘子中。","img":"images/664313/step_14.jpg"},{"step":15,"desc":"淋上调好的凉拌汁，放入葱花即可。","img":"images/664313/step_15.jpg"},{"step":16,"desc":"成品。","img":"images/664313/step_16.jpg"},{"step":17,"desc":"成品。","img":"images/664313/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/664313/step_18.jpg"},{"step":19,"desc":"成品。","img":"images/664313/step_19.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：蒸锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}