{"id":"612359","name":"低脂营养藜麦鸡蛋饼","author":"还在吃吃吃","authorId":"10106890","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/612359/cover.jpg","ingredients":{"main":[{"name":"藜麦","amount":"200克"},{"name":"鸡蛋","amount":"2枚"}],"sub":[{"name":"食用油","amount":"适量"},{"name":"食盐","amount":"半勺"},{"name":"葱花","amount":"适量"}]},"steps":[{"step":1,"desc":"藜麦提前浸泡1小时，使其胚芽全部张开，具有一股清香味，上蒸锅蒸10分钟。","img":"images/612359/step_1.jpg"},{"step":2,"desc":"将蒸好的藜麦倒入盆中，打人2枚鸡蛋。","img":"images/612359/step_2.jpg"},{"step":3,"desc":"加入适量的葱花。","img":"images/612359/step_3.jpg"},{"step":4,"desc":"加入半勺的食盐。","img":"images/612359/step_4.jpg"},{"step":5,"desc":"搅拌均匀。","img":"images/612359/step_5.jpg"},{"step":6,"desc":"平底锅刷油。","img":"images/612359/step_6.jpg"},{"step":7,"desc":"倒入藜麦糊用刮板刮平，全程小火慢煎。","img":"images/612359/step_7.jpg"},{"step":8,"desc":"记住翻面哟。","img":"images/612359/step_8.jpg"},{"step":9,"desc":"成品图。","img":"images/612359/step_9.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：平底锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}