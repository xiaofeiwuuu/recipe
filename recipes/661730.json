{"id":"661730","name":"剁椒肉沫鸡蛋","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/661730/cover.jpg","ingredients":{"main":[{"name":"鸡蛋","amount":"适量"},{"name":"肉沫","amount":"适量"}],"sub":[{"name":"香菜","amount":"适量"},{"name":"蒜末","amount":"适量"}]},"steps":[{"step":1,"desc":"肉沫提前绞碎备用。","img":"images/661730/step_1.jpg"},{"step":2,"desc":"蒜头拍扁剁碎。","img":"images/661730/step_2.jpg"},{"step":3,"desc":"香菜洗净切段。","img":"images/661730/step_3.jpg"},{"step":4,"desc":"锅中热油打入鸡蛋。","img":"images/661730/step_4.jpg"},{"step":5,"desc":"煎至两面金黄后盛出。","img":"images/661730/step_5.jpg"},{"step":6,"desc":"锅中底油放入肉沫炒散。","img":"images/661730/step_6.jpg"},{"step":7,"desc":"肉沫炒干水份后放入蚝油炒香。","img":"images/661730/step_7.jpg"},{"step":8,"desc":"放入蒜末。","img":"images/661730/step_8.jpg"},{"step":9,"desc":"放入剁椒翻炒炒香。","img":"images/661730/step_9.jpg"},{"step":10,"desc":"加入适量清水。","img":"images/661730/step_10.jpg"},{"step":11,"desc":"放入煎好的荷包蛋，煮开焖五分钟左右入味。","img":"images/661730/step_11.jpg"},{"step":12,"desc":"出锅前放入香菜即可。","img":"images/661730/step_12.jpg"},{"step":13,"desc":"成品。","img":"images/661730/step_13.jpg"},{"step":14,"desc":"成品。","img":"images/661730/step_14.jpg"},{"step":15,"desc":"成品。","img":"images/661730/step_15.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}