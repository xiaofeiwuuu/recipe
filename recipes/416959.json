{"id":"416959","name":"番茄牛肉羹","author":"阳台上的草莓","authorId":"7597089","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/416959/cover.jpg","ingredients":{"main":[{"name":"酱牛肉","amount":"100g"},{"name":"番茄","amount":"1只"},{"name":"水淀粉","amount":"10g"},{"name":"水","amount":"1500"},{"name":"番茄酱","amount":"1勺"}],"sub":[{"name":"生抽","amount":"1匙"},{"name":"醋","amount":"少许"},{"name":"白胡椒粉","amount":"少许"}]},"steps":[{"step":1,"desc":"酱牛肉切末。","img":"images/416959/step_1.jpg"},{"step":2,"desc":"番茄洗净切丁。","img":"images/416959/step_2.jpg"},{"step":3,"desc":"煮锅加水，先放入番茄一起煮。","img":"images/416959/step_3.jpg"},{"step":4,"desc":"水热后放入番茄酱。","img":"images/416959/step_4.jpg"},{"step":5,"desc":"放入生抽，醋。","img":"images/416959/step_5.jpg"},{"step":6,"desc":"煮开后放入水淀粉搅匀。","img":"images/416959/step_6.jpg"},{"step":7,"desc":"再次煮开后放入酱牛肉末搅匀。","img":"images/416959/step_7.jpg"},{"step":8,"desc":"关火后放入胡椒粉调味即可。","img":"images/416959/step_8.jpg"},{"step":9,"desc":"成品图。","img":"images/416959/step_9.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：煮锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}