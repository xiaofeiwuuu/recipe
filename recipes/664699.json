{"id":"664699","name":"梅菜排骨焖饭","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/664699/cover.jpg","ingredients":{"main":[{"name":"排骨","amount":"适量"},{"name":"梅干菜","amount":"适量"},{"name":"大米","amount":"适量"}],"sub":[{"name":"生姜","amount":"适量"}]},"steps":[{"step":1,"desc":"排骨斩块备用。","img":"images/664699/step_1.jpg"},{"step":2,"desc":"梅干菜提前泡发备用。","img":"images/664699/step_2.jpg"},{"step":3,"desc":"排骨冷水下锅焯烫出血水洗净。","img":"images/664699/step_3.jpg"},{"step":4,"desc":"生姜洗净切片。","img":"images/664699/step_4.jpg"},{"step":5,"desc":"锅中热油放入姜片。","img":"images/664699/step_5.jpg"},{"step":6,"desc":"放入排骨翻炒均匀。","img":"images/664699/step_6.jpg"},{"step":7,"desc":"适量蚝油，生抽，老抽调味。","img":"images/664699/step_7.jpg"},{"step":8,"desc":"翻炒均匀。","img":"images/664699/step_8.jpg"},{"step":9,"desc":"放入梅干菜。","img":"images/664699/step_9.jpg"},{"step":10,"desc":"翻炒均匀。","img":"images/664699/step_10.jpg"},{"step":11,"desc":"加入适量清水。","img":"images/664699/step_11.jpg"},{"step":12,"desc":"转入高压锅中火十分钟左右。","img":"images/664699/step_12.jpg"},{"step":13,"desc":"大米淘洗干净。","img":"images/664699/step_13.jpg"},{"step":14,"desc":"放入焖过的梅干菜排骨。","img":"images/664699/step_14.jpg"},{"step":15,"desc":"加入原汤，水量比平时少一点点。","img":"images/664699/step_15.jpg"},{"step":16,"desc":"电饭锅煮饭即可。","img":"images/664699/step_16.jpg"},{"step":17,"desc":"出锅前翻拌均匀，加入葱花即可。","img":"images/664699/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/664699/step_18.jpg"},{"step":19,"desc":"成品。","img":"images/664699/step_19.jpg"},{"step":20,"desc":"成品。","img":"images/664699/step_20.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：电饭煲、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}