{"id":"625724","name":"麻酱蜜汁面藕","author":"还在吃吃吃","authorId":"10106890","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/625724/cover.jpg","ingredients":{"main":[{"name":"面藕","amount":"40个"},{"name":"黄瓜","amount":"1根"}],"sub":[{"name":"黑芝麻酱","amount":"100克"},{"name":"香油","amount":"10克"},{"name":"热水","amount":"适量"},{"name":"葱蒜末和小米椒圈","amount":"适量"},{"name":"食盐","amount":"半勺"},{"name":"白熟芝麻","amount":"1勺"},{"name":"热油","amount":"10克"},{"name":"生抽","amount":"1勺"},{"name":"香醋","amount":"1勺"},{"name":"鸡精","amount":"半勺"}]},"steps":[{"step":1,"desc":"面藕用温水浸泡半小时。","img":"images/625724/step_1.jpg"},{"step":2,"desc":"黄瓜洗净后切丝。","img":"images/625724/step_2.jpg"},{"step":3,"desc":"准备葱蒜末和小米椒圈。","img":"images/625724/step_3.jpg"},{"step":4,"desc":"将食材装入碗中加入1勺辣椒面。","img":"images/625724/step_4.jpg"},{"step":5,"desc":"加入食盐和鸡精。","img":"images/625724/step_5.jpg"},{"step":6,"desc":"淋上热油。","img":"images/625724/step_6.jpg"},{"step":7,"desc":"加入生抽。","img":"images/625724/step_7.jpg"},{"step":8,"desc":"加入香醋后搅拌均匀。","img":"images/625724/step_8.jpg"},{"step":9,"desc":"黑芝麻酱用香油和开水解开。","img":"images/625724/step_9.jpg"},{"step":10,"desc":"盆中撒上白熟芝麻倒入麻酱。","img":"images/625724/step_10.jpg"},{"step":11,"desc":"再淋入酱汁。","img":"images/625724/step_11.jpg"},{"step":12,"desc":"放入黄瓜丝搅拌均匀后即可食用。","img":"images/625724/step_12.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：平底锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}