{"id":"502075","name":"西红柿蛋花汤","author":"花鱼儿","authorId":"404188","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/502075/cover.jpg","ingredients":{"main":[{"name":"西红柿","amount":"2只"},{"name":"鸡蛋","amount":"1只"}],"sub":[{"name":"香葱","amount":"适量"},{"name":"番茄沙司","amount":"适量"},{"name":"盐","amount":"适量"},{"name":"鸡精","amount":"适量"}]},"steps":[{"step":1,"desc":"食材：西红柿","img":"images/502075/step_1.jpg"},{"step":2,"desc":"鸡蛋（已打成蛋液）","img":"images/502075/step_2.jpg"},{"step":3,"desc":"香葱","img":"images/502075/step_3.jpg"},{"step":4,"desc":"番茄沙司","img":"images/502075/step_4.jpg"},{"step":5,"desc":"将西红柿清洗一下。","img":"images/502075/step_5.jpg"},{"step":6,"desc":"放在案板上切开。","img":"images/502075/step_6.jpg"},{"step":7,"desc":"随后，将西红柿下入开水锅，加适量的番茄沙司。","img":"images/502075/step_7.jpg"},{"step":8,"desc":"搅动一下煮开。","img":"images/502075/step_8.jpg"},{"step":9,"desc":"接着，倒入蛋液，加适量的盐、鸡精。","img":"images/502075/step_9.jpg"},{"step":10,"desc":"搅匀，出锅。","img":"images/502075/step_10.jpg"},{"step":11,"desc":"然后，出锅后撒上香葱，即可。","img":"images/502075/step_11.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}