{"id":"413249","name":"泡菜豆腐汤","author":"黄世仁61","authorId":"566819","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/413249/cover.jpg","ingredients":{"main":[{"name":"辣白菜","amount":"100g"},{"name":"西葫芦","amount":"1个"},{"name":"土豆","amount":"1个"},{"name":"豆腐","amount":"1块"},{"name":"洋葱","amount":"半个"},{"name":"香菜","amount":"适量"}],"sub":[{"name":"盐","amount":"1勺"},{"name":"蚝油","amount":"1勺"},{"name":"海鲜酱油","amount":"1勺"},{"name":"冰糖","amount":"2g"},{"name":"花椒粉","amount":"0.5勺"}]},"steps":[{"step":1,"desc":"西葫芦、土豆切厚片，洋葱切块。","img":"images/413249/step_1.jpg"},{"step":2,"desc":"锅中倒入适量油，放入辣白菜翻炒出香味。","img":"images/413249/step_2.jpg"},{"step":3,"desc":"加入洋葱翻炒至洋葱变透明。","img":"images/413249/step_3.jpg"},{"step":4,"desc":"添入适量水。","img":"images/413249/step_4.jpg"},{"step":5,"desc":"放入土豆片、西葫芦片和所有辅料，盖上盖子炖煮15分钟。","img":"images/413249/step_5.jpg"},{"step":6,"desc":"将豆腐切块放入锅中，在炖煮10分钟左右即可。","img":"images/413249/step_6.jpg"},{"step":7,"desc":"出锅后表面撒少许香菜，配碗米饭就更完美了。","img":"images/413249/step_7.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}