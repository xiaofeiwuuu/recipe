{"id":"647908","name":"生煎梅菜包","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/647908/cover.jpg","ingredients":{"main":[{"name":"中筋面粉","amount":"500g"},{"name":"发酵粉","amount":"5g"},{"name":"清水","amount":"260g~270g"},{"name":"盐","amount":"适量"}],"sub":[{"name":"梅菜肉沫馅","amount":"适量"}]},"steps":[{"step":1,"desc":"焖好的梅干菜肉沫备用（可参考菜谱）。","img":"images/647908/step_1.jpg"},{"step":2,"desc":"梅干菜肉沫加入适量淀粉水勾茨后冷藏备用。","img":"images/647908/step_2.jpg"},{"step":3,"desc":"盆中加入。","img":"images/647908/step_3.jpg"},{"step":4,"desc":"盆中加入面粉和发酵粉，少许盐。","img":"images/647908/step_4.jpg"},{"step":5,"desc":"加入清水。","img":"images/647908/step_5.jpg"},{"step":6,"desc":"搅拌成絮状。","img":"images/647908/step_6.jpg"},{"step":7,"desc":"将面团揉光盖上发酵。","img":"images/647908/step_7.jpg"},{"step":8,"desc":"发酵至两倍大，面团呈蜂窝状。","img":"images/647908/step_8.jpg"},{"step":9,"desc":"冷藏过的梅干菜肉馅备用。","img":"images/647908/step_9.jpg"},{"step":10,"desc":"面团排气揉光后分切成小面剂。","img":"images/647908/step_10.jpg"},{"step":11,"desc":"将面剂擀薄备用。","img":"images/647908/step_11.jpg"},{"step":12,"desc":"加入适量梅干菜馅。","img":"images/647908/step_12.jpg"},{"step":13,"desc":"包子包起收口。","img":"images/647908/step_13.jpg"},{"step":14,"desc":"锅中热油放入包好的包子。","img":"images/647908/step_14.jpg"},{"step":15,"desc":"煎至底部金黄。","img":"images/647908/step_15.jpg"},{"step":16,"desc":"加入淀粉水。","img":"images/647908/step_16.jpg"},{"step":17,"desc":"大火煮开转中小火焖5分钟左右。","img":"images/647908/step_17.jpg"},{"step":18,"desc":"将淀粉水收干，最后摇晃锅底，将包子小火均匀煎1至2分钟。","img":"images/647908/step_18.jpg"},{"step":19,"desc":"成品。","img":"images/647908/step_19.jpg"},{"step":20,"desc":"成品。","img":"images/647908/step_20.jpg"},{"step":21,"desc":"成品。","img":"images/647908/step_21.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：不粘锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}