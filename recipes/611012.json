{"id":"611012","name":"萝卜丝饼","author":"不做妖精好多年","authorId":"1806550","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/611012/cover.jpg","ingredients":{"main":[{"name":"萝卜","amount":"150g"},{"name":"面团","amount":"150克"}],"sub":[{"name":"粉丝","amount":"小许"},{"name":"猪肉","amount":"约50g"},{"name":"食用油","amount":"小许"}]},"steps":[{"step":1,"desc":"萝卜洗净。","img":"images/611012/step_1.jpg"},{"step":2,"desc":"打丝。","img":"images/611012/step_2.jpg"},{"step":3,"desc":"锅烧开水。","img":"images/611012/step_3.jpg"},{"step":4,"desc":"放萝卜丝焯水。","img":"images/611012/step_4.jpg"},{"step":5,"desc":"水开即可。","img":"images/611012/step_5.jpg"},{"step":6,"desc":"冷水浸泡。","img":"images/611012/step_6.jpg"},{"step":7,"desc":"锅里放猪肉。","img":"images/611012/step_7.jpg"},{"step":8,"desc":"放粉丝，开锅煮5分钟。","img":"images/611012/step_8.jpg"},{"step":9,"desc":"捞出粉丝过冷水。","img":"images/611012/step_9.jpg"},{"step":10,"desc":"萝卜撰干水分，粉丝改刀。","img":"images/611012/step_10.jpg"},{"step":11,"desc":"取肉，洗净浮沫，切末。","img":"images/611012/step_11.jpg"},{"step":12,"desc":"所有食材放一起。","img":"images/611012/step_12.jpg"},{"step":13,"desc":"切葱姜末放进来。","img":"images/611012/step_13.jpg"},{"step":14,"desc":"放食用油、食盐、椒盐和生抽。","img":"images/611012/step_14.jpg"},{"step":15,"desc":"放鸡精。","img":"images/611012/step_15.jpg"},{"step":16,"desc":"拌匀。","img":"images/611012/step_16.jpg"},{"step":17,"desc":"周末做韭菜盒子剩的面团，取三块揉光。","img":"images/611012/step_17.jpg"},{"step":18,"desc":"擀皮。","img":"images/611012/step_18.jpg"},{"step":19,"desc":"包起来，压成饼。","img":"images/611012/step_19.jpg"},{"step":20,"desc":"热锅放熟油，放萝卜丝饼。","img":"images/611012/step_20.jpg"},{"step":21,"desc":"煎至底部金黄。","img":"images/611012/step_21.jpg"},{"step":22,"desc":"翻面。","img":"images/611012/step_22.jpg"},{"step":23,"desc":"另一面也金黄翻面。","img":"images/611012/step_23.jpg"},{"step":24,"desc":"再翻一次就好了。","img":"images/611012/step_24.jpg"},{"step":25,"desc":"成品。","img":"images/611012/step_25.jpg"},{"step":26,"desc":"开动。","img":"images/611012/step_26.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\