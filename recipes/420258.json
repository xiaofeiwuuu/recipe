{"id":"420258","name":"小番茄排骨汤","author":"木木夕酉星","authorId":"11048563","desc":"","cover":"images/420258/cover.jpg","ingredients":{"main":[{"name":"排骨","amount":"2根"},{"name":"小番茄","amount":"适量"}],"sub":[{"name":"生姜","amount":"1块"},{"name":"大葱","amount":"1根"},{"name":"小葱","amount":"2根"},{"name":"盐","amount":"少许"},{"name":"鸡精","amount":"少许"}]},"steps":[{"step":1,"desc":"排骨洗干净。","img":"images/420258/step_1.jpeg"},{"step":2,"desc":"小番茄适量。","img":"images/420258/step_2.jpeg"},{"step":3,"desc":"生姜，大葱，小葱。","img":"images/420258/step_3.jpeg"},{"step":4,"desc":"排骨放冷水锅中。","img":"images/420258/step_4.jpeg"},{"step":5,"desc":"放入蒜片和大葱叶，开火焯水。","img":"images/420258/step_5.jpeg"},{"step":6,"desc":"小番茄去蒂洗净，然后放少许盐浸泡10分钟。","img":"images/420258/step_6.jpeg"},{"step":7,"desc":"生姜拍破。","img":"images/420258/step_7.jpeg"},{"step":8,"desc":"大葱切段。","img":"images/420258/step_8.jpeg"},{"step":9,"desc":"小葱切段。","img":"images/420258/step_9.jpeg"},{"step":10,"desc":"水开捞出排骨。","img":"images/420258/step_10.jpeg"},{"step":11,"desc":"用温水冲掉浮末。","img":"images/420258/step_11.jpeg"},{"step":12,"desc":"放入电饭锅内胆，倒入适量的水。","img":"images/420258/step_12.jpeg"},{"step":13,"desc":"放入生姜，葱段，小番茄。","img":"images/420258/step_13.jpeg"},{"step":14,"desc":"盖上盖子按煲汤键。","img":"images/420258/step_14.jpeg"},{"step":15,"desc":"两小时后。","img":"images/420258/step_15.jpeg"},{"step":16,"desc":"放少许盐。","img":"images/420258/step_16.jpeg"},{"step":17,"desc":"放少许鸡精。","img":"images/420258/step_17.jpeg"},{"step":18,"desc":"搅拌均匀，出锅装碗。","img":"images/420258/step_18.jpeg"},{"step":19,"desc":"撒上葱段。","img":"images/420258/step_19.jpeg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：电饭煲\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}