{"id":"662308","name":"牛肉虾滑冒菜","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/662308/cover.jpg","ingredients":{"main":[{"name":"牛肉","amount":"适量"},{"name":"虾滑","amount":"适量"},{"name":"莲藕","amount":"适量"},{"name":"魔芋","amount":"适量"},{"name":"莴笋","amount":"适量"}],"sub":[{"name":"蒜末","amount":"适量"},{"name":"香菜","amount":"适量"}]},"steps":[{"step":1,"desc":"牛肉洗净切薄片。","img":"images/662308/step_1.jpg"},{"step":2,"desc":"牛肉洗净切薄片。","img":"images/662308/step_2.jpg"},{"step":3,"desc":"加入玉米淀粉，蚝油，老抽。","img":"images/662308/step_3.jpg"},{"step":4,"desc":"适量花生油抓匀锁住水份备用。","img":"images/662308/step_4.jpg"},{"step":5,"desc":"莴笋去皮切块，莲藕切片（莲藕忘记拍了）。","img":"images/662308/step_5.jpg"},{"step":6,"desc":"魔芋切块。","img":"images/662308/step_6.jpg"},{"step":7,"desc":"锅中热油放入火锅底料炒香。","img":"images/662308/step_7.jpg"},{"step":8,"desc":"加入适量清水煮开。","img":"images/662308/step_8.jpg"},{"step":9,"desc":"少许盐调味。","img":"images/662308/step_9.jpg"},{"step":10,"desc":"放入莲藕。","img":"images/662308/step_10.jpg"},{"step":11,"desc":"放入莴笋。","img":"images/662308/step_11.jpg"},{"step":12,"desc":"放入魔芋，煮一分钟左右。","img":"images/662308/step_12.jpg"},{"step":13,"desc":"煮好后捞出盛入碗中。","img":"images/662308/step_13.jpg"},{"step":14,"desc":"虾滑舀成球放入锅中。","img":"images/662308/step_14.jpg"},{"step":15,"desc":"煮好的虾滑舀入碗里。","img":"images/662308/step_15.jpg"},{"step":16,"desc":"牛肉下锅烫熟。","img":"images/662308/step_16.jpg"},{"step":17,"desc":"烫好后放入碗中。","img":"images/662308/step_17.jpg"},{"step":18,"desc":"加入蒜末。","img":"images/662308/step_18.jpg"},{"step":19,"desc":"淋上热油激发出香味。","img":"images/662308/step_19.jpg"},{"step":20,"desc":"放入香菜即可。","img":"images/662308/step_20.jpg"},{"step":21,"desc":"成品。","img":"images/662308/step_21.jpg"},{"step":22,"desc":"成品。","img":"images/662308/step_22.jpg"},{"step":23,"desc":"成品。","img":"images/662308/step_23.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}