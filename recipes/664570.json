{"id":"664570","name":"排骨土豆豆角炖粉条","author":"_蒍鉨变乖々","authorId":"8010238","desc":"*本菜谱为作者独家发布于美食天下，禁止其他平台或个人转载。","cover":"images/664570/cover.jpg","ingredients":{"main":[{"name":"排骨","amount":"适量"},{"name":"土豆","amount":"适量"},{"name":"豆角","amount":"适量"},{"name":"粉条","amount":"适量"}],"sub":[{"name":"生姜","amount":"适量"},{"name":"葱花","amount":"适量"}]},"steps":[{"step":1,"desc":"生姜洗净切片。","img":"images/664570/step_1.jpg"},{"step":2,"desc":"排骨冷水下锅焯烫出血水后洗净。","img":"images/664570/step_2.jpg"},{"step":3,"desc":"豆角洗净改刀切段。","img":"images/664570/step_3.jpg"},{"step":4,"desc":"土豆去皮洗净切滚刀块。","img":"images/664570/step_4.jpg"},{"step":5,"desc":"粉条提前泡发。","img":"images/664570/step_5.jpg"},{"step":6,"desc":"锅中热油放入姜片炒香。","img":"images/664570/step_6.jpg"},{"step":7,"desc":"放入排骨翻炒。","img":"images/664570/step_7.jpg"},{"step":8,"desc":"适量蚝油，生抽，老抽和盐调味。","img":"images/664570/step_8.jpg"},{"step":9,"desc":"翻炒均匀上色入味。","img":"images/664570/step_9.jpg"},{"step":10,"desc":"加入适量清水。","img":"images/664570/step_10.jpg"},{"step":11,"desc":"转入高压锅大火压十分钟即可。","img":"images/664570/step_11.jpg"},{"step":12,"desc":"锅中热油把土豆下锅炸至微微金黄盛出。","img":"images/664570/step_12.jpg"},{"step":13,"desc":"土豆也下锅过一下油后盛出。","img":"images/664570/step_13.jpg"},{"step":14,"desc":"高压锅压过的排骨倒入炒锅中煮开。","img":"images/664570/step_14.jpg"},{"step":15,"desc":"放入豆角和土豆，一起焖5分钟左右断生。","img":"images/664570/step_15.jpg"},{"step":16,"desc":"放入粉条。","img":"images/664570/step_16.jpg"},{"step":17,"desc":"大火煮开即可出锅。","img":"images/664570/step_17.jpg"},{"step":18,"desc":"成品。","img":"images/664570/step_18.jpg"},{"step":19,"desc":"成品。","img":"images/664570/step_19.jpg"},{"step":20,"desc":"成品。","img":"images/664570/step_20.jpg"}],"tips":"来自 美食天下  的作品\n\t\t\t\t\n\t\t\t\t\t使用的厨具：高压锅、炒锅\n\t\t\t\t\n\t\t\t\t\t所属分类：","attrs":{}}